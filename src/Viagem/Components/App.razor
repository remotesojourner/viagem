<!DOCTYPE html>
<html lang="en" class="@(HttpContext.Request.Cookies.TryGetValue("theme-resolved", out var c) && (c == "dark" || c == "light") ? c : "light")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Viagem.styles.css"]" />
    <link href="/_content/PSC.Blazor.Components.MarkdownEditor/css/easymde.min.css" rel="stylesheet" />
    <link href="/_content/PSC.Blazor.Components.MarkdownEditor/css/markdowneditor.css" rel="stylesheet" />
    <ImportMap />
    <link rel="icon" type="image/png" href="img/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <HeadOutlet />
    <script>
        (function() {
            var key = "lumexui.theme";
            var cookieName = "theme-resolved";
            
            function setResolvedCookie(val) {
                document.cookie = cookieName + "=" + val + ";path=/;samesite=strict;max-age=31536000";
            }

            var t = localStorage.getItem(key) || "system";
            var resolved = t === "system"
                ? (window.matchMedia("(prefers-color-scheme:dark)").matches ? "dark" : "light")
                : t;
            
            setResolvedCookie(resolved);
            document.documentElement.classList.remove("light", "dark");
            document.documentElement.classList.add(resolved);
            document.documentElement.setAttribute("data-theme", resolved);
            document.documentElement.style.colorScheme = resolved;

            window._applyLumexTheme = function(newTheme) {
                if (newTheme) {
                    localStorage.setItem(key, newTheme);
                }
                var current = localStorage.getItem(key) || "system";
                var res = current === "system"
                    ? (window.matchMedia("(prefers-color-scheme:dark)").matches ? "dark" : "light")
                    : current;
                setResolvedCookie(res);
                document.documentElement.classList.remove("light", "dark");
                document.documentElement.classList.add(res);
                document.documentElement.setAttribute("data-theme", res);
                document.documentElement.style.colorScheme = res;
            };

            window.matchMedia("(prefers-color-scheme:dark)").addEventListener("change", function() {
                if ((localStorage.getItem(key) || "system") === "system") {
                    window._applyLumexTheme();
                }
            });
        })();
    </script>
</head>

<body>
    @if (DbThemeColor == "purple")
    {
        <style>
            :root {
                --lumex-primary-50: #faf5ff;
                --lumex-primary-100: #f3e8ff;
                --lumex-primary-200: #e9d5ff;
                --lumex-primary-300: #d8b4fe;
                --lumex-primary-400: #c084fc;
                --lumex-primary-500: #a855f7;
                --lumex-primary-600: #9333ea;
                --lumex-primary-700: #7e22ce;
                --lumex-primary-800: #6b21a8;
                --lumex-primary-900: #581c87;
                --lumex-primary: var(--lumex-primary-500);
                --lumex-focus: var(--lumex-primary-500);
            }
        </style>
    }
    else if (DbThemeColor == "red")
    {
        <style>
            :root {
                --lumex-primary-50: #fef2f2;
                --lumex-primary-100: #fee2e2;
                --lumex-primary-200: #fecaca;
                --lumex-primary-300: #fca5a5;
                --lumex-primary-400: #f87171;
                --lumex-primary-500: #ef4444;
                --lumex-primary-600: #dc2626;
                --lumex-primary-700: #b91c1c;
                --lumex-primary-800: #991b1b;
                --lumex-primary-900: #7f1d1d;
                --lumex-primary: var(--lumex-primary-500);
                --lumex-focus: var(--lumex-primary-500);
            }
        </style>
    }
    else if (DbThemeColor == "amber")
    {
        <style>
            :root {
                --lumex-primary-50: #fffbeb;
                --lumex-primary-100: #fef3c7;
                --lumex-primary-200: #fde68a;
                --lumex-primary-300: #fcd34d;
                --lumex-primary-400: #fbbf24;
                --lumex-primary-500: #f59e0b;
                --lumex-primary-600: #d97706;
                --lumex-primary-700: #b45309;
                --lumex-primary-800: #92400e;
                --lumex-primary-900: #78350f;
                --lumex-primary: var(--lumex-primary-500);
                --lumex-focus: var(--lumex-primary-500);
            }
        </style>
    }
    else if (DbThemeColor != "blue")
    {
        <style>
            :root {
                --lumex-primary-50: var(--color-@(DbThemeColor)-50);
                --lumex-primary-100: var(--color-@(DbThemeColor)-100);
                --lumex-primary-200: var(--color-@(DbThemeColor)-200);
                --lumex-primary-300: var(--color-@(DbThemeColor)-300);
                --lumex-primary-400: var(--color-@(DbThemeColor)-400);
                --lumex-primary-500: var(--color-@(DbThemeColor)-500);
                --lumex-primary-600: var(--color-@(DbThemeColor)-600);
                --lumex-primary-700: var(--color-@(DbThemeColor)-700);
                --lumex-primary-800: var(--color-@(DbThemeColor)-800);
                --lumex-primary-900: var(--color-@(DbThemeColor)-900);
                --lumex-primary: var(--lumex-primary-500);
                --lumex-focus: var(--lumex-primary-500);
            }
        </style>
    }

    <Routes />
    <script src="_content/LumexUI/js/LumexUI.js" type="module"></script>
    <script src="/_content/PSC.Blazor.Components.MarkdownEditor/js/easymde.min.js"></script>
    <script src="/_content/PSC.Blazor.Components.MarkdownEditor/js/markdownEditor.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="js/travelboard.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string DbThemeColor { get; set; } = "blue";

    protected override async Task OnInitializedAsync()
    {
        var userId = HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var userManager = HttpContext.RequestServices.GetRequiredService<UserManager<ApplicationUser>>();
            var user = await userManager.FindByIdAsync(userId);
            DbThemeColor = user?.ThemeColor ?? "blue";
        }
    }
}
