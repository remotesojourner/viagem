@page "/trips/create"
@rendermode InteractiveServer
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@using Viagem.Services.Interfaces
@inject ITripService TripService
@inject IPlaceService PlaceService
@inject ITravellerProfileService TravellerService
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Create Trip - Viagem</PageTitle>

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <a href="/" class="inline-flex items-center text-sm text-gray-500 hover:text-blue-600 dark:text-gray-400 dark:hover:text-blue-400">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Back to My Trips
        </a>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white mt-2">Create New Trip</h1>
    </div>

    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 space-y-5">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="p-4 text-sm text-red-800 rounded-lg bg-red-50 dark:bg-red-900 dark:text-red-400">@errorMessage</div>
        }

        <!-- Trip Name -->
        <div>
            <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Trip Name *</label>
            <input @bind="name" type="text" class="@InputClass" placeholder="e.g. Summer Europe Trip 2025" />
        </div>

        <!-- Dates -->
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Start Date *</label>
                <input @bind="startDate" type="date" class="@InputClass" />
            </div>
            <div>
                <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">End Date *</label>
                <input @bind="endDate" type="date" class="@InputClass" />
            </div>
        </div>
        @if (dateError != null)
        {
            <p class="text-xs text-red-600 dark:text-red-400 -mt-3">@dateError</p>
        }

        <!-- Description -->
        <div>
            <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Description</label>
            <textarea @bind="description" rows="2" class="@InputClass" placeholder="Brief description of your trip..."></textarea>
        </div>

        <!-- Budget -->
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Budget Amount</label>
                <input @bind="budgetAmount" type="number" step="0.01" min="0" class="@InputClass" placeholder="0.00" />
            </div>
            <div>
                <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Currency</label>
                <Combobox @bind-Value="budgetCurrency" Placeholder="Select currency..." SearchPlaceholder="Search currencies...">
                    <ComboboxItem Value="" Label="Select currency..." />
                    @foreach (var c in Currencies)
                    {
                        <ComboboxItem Value="@c.Code" Label="@(c.Code + " - " + c.Name)" />
                    }
                </Combobox>
            </div>
        </div>

        <!-- Destinations -->
        <div>
            <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Destinations</label>
            @if (destinations.Count > 0)
            {
                <div class="flex flex-wrap gap-2 mb-2">
                    @foreach (var d in destinations)
                    {
                        <span class="inline-flex items-center gap-1 px-2.5 py-1 text-sm bg-blue-100 text-blue-800 rounded-full dark:bg-blue-900 dark:text-blue-300">
                            📍 @d.DisplayName
                            <button type="button" @onclick="() => destinations.Remove(d)" class="ml-1 text-blue-500 hover:text-blue-700">&#x2715;</button>
                        </span>
                    }
                </div>
            }
            <div class="flex gap-2">
                <div class="flex-1 relative">
                    <input value="@destSearch" @oninput="HandleDestInput" type="text" class="@InputClass" placeholder="Search city or type custom name..." />
                    @if (destResults.Count > 0)
                    {
                        <ul class="absolute z-10 mt-1 w-full bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg shadow-lg max-h-44 overflow-y-auto">
                            @foreach (var place in destResults)
                            {
                                <li>
                                    <button type="button" @onclick="() => AddDestFromPlace(place)"
                                            class="w-full text-left px-3 py-2 hover:bg-gray-50 dark:hover:bg-gray-600">
                                        <span class="font-semibold text-sm text-gray-800 dark:text-gray-200">@place.Name</span>
                                        @if (!string.IsNullOrEmpty(place.StateName) || !string.IsNullOrEmpty(place.CountryName))
                                        {
                                            <span class="text-xs text-gray-500 dark:text-gray-400 ml-1">
                                                @(!string.IsNullOrEmpty(place.StateName) ? place.StateName + (!string.IsNullOrEmpty(place.CountryName) ? ", " : "") : "")@(place.CountryName ?? "")
                                            </span>
                                        }
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
                <button type="button" @onclick="AddDestCustom"
                        class="px-3 py-2 text-sm font-medium text-white bg-gray-600 rounded-lg hover:bg-gray-700 whitespace-nowrap">
                    Add custom
                </button>
            </div>
        </div>

        <!-- Travellers & Organisers -->
        <div>
            <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Travellers &amp; Organisers</label>

            <!-- Added travellers list -->
            @if (selectedTravellers.Count > 0)
            {
                <div class="space-y-1 mb-3">
                    @foreach (var kv in selectedTravellers)
                    {
                        var tProfile = myProfiles.FirstOrDefault(p => p.Id == kv.Key);
                        var tName = tProfile?.LegalName ?? "Unknown";
                        var tIsLinked = !string.IsNullOrEmpty(tProfile?.LinkedUserId);
                        var tIsCurrentUser = kv.Key == currentUserProfileId;
                        var tState = kv.Value;
                        <div class="flex items-center justify-between p-2 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                            <div class="flex items-center gap-2 min-w-0">
                                <UserAvatar Email="@tProfile?.Email" Name="@tName" SizeClass="w-7 h-7" ExtraClass="flex-shrink-0" TextClass="text-xs" />
                                <span class="text-sm text-gray-900 dark:text-white truncate">@tName</span>
                                @if (tIsLinked)
                                {
                                    <span class="text-xs px-1.5 py-0.5 bg-green-100 text-green-700 rounded dark:bg-green-900/40 dark:text-green-400 flex-shrink-0">User</span>
                                }
                                @if (tIsCurrentUser)
                                {
                                    <span class="text-xs px-1.5 py-0.5 bg-blue-100 text-blue-700 rounded dark:bg-blue-900/40 dark:text-blue-400 flex-shrink-0">You</span>
                                }
                            </div>
                            @if (tIsLinked || !tIsCurrentUser)
                            {
                                <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                                    @if (tIsLinked)
                                    {
                                        <label class="flex items-center gap-1 cursor-pointer text-xs text-gray-600 dark:text-gray-400 select-none">
                                            <input type="checkbox" class="w-3.5 h-3.5 text-purple-600 rounded"
                                                   checked="@tState.IsOrganiser"
                                                   @onchange="e => SetOrganiserFlag(kv.Key, (bool)(e.Value ?? false))" />
                                            Organiser
                                        </label>
                                        @if (!tIsCurrentUser)
                                        {
                                            <label class="flex items-center gap-1 text-xs select-none @(tState.IsOrganiser ? "cursor-not-allowed opacity-50 text-gray-400 dark:text-gray-500" : "cursor-pointer text-gray-600 dark:text-gray-400")">
                                                <input type="checkbox" class="w-3.5 h-3.5 text-blue-600 rounded"
                                                       disabled="@tState.IsOrganiser"
                                                       checked="@tState.EffectiveCanEdit"
                                                       @onchange="e => SetCanEditFlag(kv.Key, (bool)(e.Value ?? false))" />
                                                Can edit
                                            </label>
                                        }
                                    }
                                    @if (!tIsCurrentUser)
                                    {
                                        <button type="button" @onclick="() => selectedTravellers.Remove(kv.Key)"
                                                class="text-gray-400 hover:text-red-500 dark:hover:text-red-400 transition-colors">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                            </svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Search to add travellers -->
            <div class="relative">
                <input value="@travellerSearch" @oninput="HandleTravellerSearch" type="text" class="@InputClass"
                       placeholder="Search to add traveller..." autocomplete="off" />
                @if (travellerSearchResults.Count > 0)
                {
                    <ul class="absolute z-10 mt-1 w-full bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg shadow-lg max-h-44 overflow-y-auto">
                        @foreach (var tp in travellerSearchResults)
                        {
                            <li>
                                <button type="button" @onclick="() => AddTraveller(tp)"
                                        class="w-full text-left px-3 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-600 text-gray-800 dark:text-gray-200 flex items-center gap-2">
                                    <span>@tp.LegalName</span>
                                    @if (!string.IsNullOrEmpty(tp.LinkedUserId))
                                    {
                                        <span class="text-xs px-1 py-0.5 bg-green-100 text-green-700 rounded dark:bg-green-900/40 dark:text-green-400">User</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3 pt-2">
            <button type="button" @onclick="HandleSubmit" disabled="@saving"
                    class="px-5 py-2.5 text-sm font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 disabled:opacity-50">
                @(saving ? "Creating..." : "Create Trip")
            </button>
            <a href="/" class="px-5 py-2.5 text-sm font-medium text-gray-900 bg-white rounded-lg border border-gray-200 hover:bg-gray-100 dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700">
                Cancel
            </a>
        </div>
    </div>
</div>

@code {
    private string name = "";
    private DateTime? startDate = DateTime.Today;
    private DateTime? endDate = DateTime.Today.AddDays(7);
    private string? description;
    private decimal? budgetAmount;
    private string budgetCurrency = "USD";

    private string destSearch = "";
    private List<Place> destResults = [];
    private List<DestItem> destinations = [];

    private List<TravellerProfile> myProfiles = [];
    private Dictionary<int, TravellerEditState> selectedTravellers = [];
    private string travellerSearch = "";
    private List<TravellerProfile> travellerSearchResults = [];
    private int? currentUserProfileId;

    private bool saving = false;
    private string? errorMessage;
    private string? dateError;
    private string? userId;

    private string InputClass => "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user?.CurrencyCode != null)
                budgetCurrency = user.CurrencyCode;

            myProfiles = await TravellerService.GetMyProfilesAsync(userId);
            currentUserProfileId = myProfiles.FirstOrDefault(p => p.LinkedUserId == userId)?.Id;
            if (currentUserProfileId.HasValue)
                selectedTravellers[currentUserProfileId.Value] = new TravellerEditState { CanEdit = true };
        }
    }

    private async Task HandleDestInput(ChangeEventArgs e)
    {
        destSearch = e.Value?.ToString() ?? "";
        if (destSearch.Length < 2) { destResults = []; return; }
        destResults = await PlaceService.SearchAsync(destSearch);
    }

    private void AddDestFromPlace(Place place)
    {
        if (!destinations.Any(d => d.PlaceId == place.Id))
            destinations.Add(new DestItem { PlaceId = place.Id, DisplayName = place.Name + (!string.IsNullOrEmpty(place.CountryName) ? $", {place.CountryName}" : "") });
        destSearch = "";
        destResults = [];
    }

    private void AddDestCustom()
    {
        var name = destSearch.Trim();
        if (string.IsNullOrEmpty(name)) return;
        if (!destinations.Any(d => d.CustomName == name && d.PlaceId == null))
            destinations.Add(new DestItem { CustomName = name, DisplayName = name });
        destSearch = "";
        destResults = [];
    }

    private void HandleTravellerSearch(ChangeEventArgs e)
    {
        travellerSearch = e.Value?.ToString() ?? "";
        if (travellerSearch.Length < 1) { travellerSearchResults = []; return; }
        var lower = travellerSearch.ToLowerInvariant();
        travellerSearchResults = myProfiles
            .Where(p => p.LegalName.ToLowerInvariant().Contains(lower) && !selectedTravellers.ContainsKey(p.Id))
            .Take(8)
            .ToList();
    }

    private void AddTraveller(TravellerProfile profile)
    {
        if (!selectedTravellers.ContainsKey(profile.Id))
            selectedTravellers[profile.Id] = new TravellerEditState();
        travellerSearch = "";
        travellerSearchResults = [];
    }

    private void SetOrganiserFlag(int profileId, bool isOrganiser)
    {
        if (selectedTravellers.TryGetValue(profileId, out var state))
            state.IsOrganiser = isOrganiser;
    }

    private void SetCanEditFlag(int profileId, bool canEdit)
    {
        if (selectedTravellers.TryGetValue(profileId, out var state) && !state.IsOrganiser)
            state.CanEdit = canEdit;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(name)) { errorMessage = "Trip name is required."; return; }

        var start = startDate ?? DateTime.Today;
        var end = endDate ?? DateTime.Today.AddDays(7);
        dateError = null;
        if (end < start) { dateError = "End date must be on or after start date."; return; }

        if (userId == null) return;
        saving = true;
        errorMessage = null;
        try
        {
            var trip = new Trip
            {
                Name = name.Trim(),
                StartDate = start,
                EndDate = end,
                Description = description?.Trim(),
                BudgetAmount = budgetAmount,
                BudgetCurrency = string.IsNullOrWhiteSpace(budgetCurrency) ? null : budgetCurrency.Trim().ToUpper(),
                OwnerId = userId
            };
            var created = await TripService.CreateTripAsync(trip);

            // Add destinations
            foreach (var d in destinations)
            {
                if (d.PlaceId.HasValue)
                    await TripService.AddDestinationAsync(created.Id, d.PlaceId.Value);
                else if (!string.IsNullOrEmpty(d.CustomName))
                    await TripService.AddDestinationCustomAsync(created.Id, d.CustomName);
            }

            // Add travellers
            foreach (var kv in selectedTravellers)
            {
                var isCurrentUser = kv.Key == currentUserProfileId;
                await TripService.AddTravellerAsync(created.Id, kv.Key,
                    isCurrentUser ? true : kv.Value.EffectiveCanEdit,
                    kv.Value.IsOrganiser);
            }

            Nav.NavigateTo($"/trips/{created.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create trip: {ex.Message}";
        }
        saving = false;
    }

    private class DestItem
    {
        public int? PlaceId { get; set; }
        public string? CustomName { get; set; }
        public string DisplayName { get; set; } = "";
    }

    private class TravellerEditState
    {
        public bool CanEdit { get; set; } = false;
        public bool IsOrganiser { get; set; } = false;
        public bool EffectiveCanEdit => IsOrganiser || CanEdit;
    }

    private record CurrencyItem(string Code, string Name);

    private static readonly IReadOnlyList<CurrencyItem> Currencies =
    [
        new("AED","UAE Dirham"), new("AUD","Australian Dollar"), new("BRL","Brazilian Real"),
        new("CAD","Canadian Dollar"), new("CHF","Swiss Franc"), new("CNY","Chinese Yuan"),
        new("CZK","Czech Koruna"), new("DKK","Danish Krone"), new("EUR","Euro"),
        new("GBP","British Pound"), new("HKD","Hong Kong Dollar"), new("HUF","Hungarian Forint"),
        new("IDR","Indonesian Rupiah"), new("ILS","Israeli Shekel"), new("INR","Indian Rupee"),
        new("JPY","Japanese Yen"), new("KRW","South Korean Won"), new("MXN","Mexican Peso"),
        new("MYR","Malaysian Ringgit"), new("NOK","Norwegian Krone"), new("NZD","New Zealand Dollar"),
        new("PHP","Philippine Peso"), new("PLN","Polish Zloty"), new("RON","Romanian Leu"),
        new("SAR","Saudi Riyal"), new("SEK","Swedish Krona"), new("SGD","Singapore Dollar"),
        new("THB","Thai Baht"), new("TRY","Turkish Lira"), new("TWD","New Taiwan Dollar"),
        new("UAH","Ukrainian Hryvnia"), new("USD","US Dollar"), new("VND","Vietnamese Dong"),
        new("ZAR","South African Rand")
    ];
}
