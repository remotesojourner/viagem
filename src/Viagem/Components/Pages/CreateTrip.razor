@page "/trips/create"
@rendermode InteractiveServer
@attribute [Authorize]
@using Viagem.Services.Interfaces
@using Viagem.Services.ViewModels
@using Viagem.Common
@inject ITripService TripService
@inject IPlaceService PlaceService
@inject ITravellerProfileService TravellerService
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Create Trip - Viagem</PageTitle>

<div class="max-w-2xl mx-auto">
    <div class="mb-6">
        <a href="/" class="inline-flex items-center text-sm text-foreground-400 hover:text-primary">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            Back to My Trips
        </a>
        <h1 class="text-2xl font-bold text-foreground mt-2">Create New Trip</h1>
    </div>

    <div class="bg-surface1 rounded-xl border border-divider p-6 space-y-5">
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <LumexAlert Color="ThemeColor.Danger" Variant="AlertVariant.Flat" Description="@errorMessage" />
        }

        <!-- Trip Name -->
        <LumexTextbox @bind-Value="name" Label="Trip Name" Placeholder="e.g. Summer Europe Trip 2025" Required="@true" />

        <!-- Dates -->
        <div class="grid grid-cols-2 gap-4">
            <LumexDatebox TValue="DateTime?" @bind-Value="startDate" Label="Start Date" Required="@true" />
            <LumexDatebox TValue="DateTime?" @bind-Value="endDate" Label="End Date" Required="@true" />
        </div>
        @if (dateError != null)
        {
            <p class="text-xs text-danger -mt-3">@dateError</p>
        }

        <!-- Description -->
        <LumexTextbox @bind-Value="description" Label="Description" Placeholder="Brief description of your trip..." Multiline="@true" Rows="2" />

        <!-- Budget -->
        <div class="grid grid-cols-2 gap-4">
            <LumexNumbox TValue="decimal?" @bind-Value="budgetAmount" Label="Budget Amount" Placeholder="0.00" />
            <SearchableDropdown TItem="CurrencyItem"
                                Value="@AppConstants.Currencies.FirstOrDefault(c => c.Code == budgetCurrency)"
                                ValueChanged="@(c => budgetCurrency = c?.Code ?? "USD")"
                                Items="AppConstants.Currencies"
                                ItemText='c => $"{c.Flag} {c.Code} - {c.Name}"'
                                Label="Currency"
                                Placeholder="Select currency..." />
        </div>

        <!-- Destinations -->
        <div>
            <label class="block mb-1.5 text-sm font-medium text-foreground">Destinations</label>
            @if (destinations.Count > 0)
            {
                <div class="flex flex-wrap gap-2 mb-2">
                    @foreach (var d in destinations)
                    {
                        <LumexChip Color="ThemeColor.Primary" OnClose="() => destinations.Remove(d)">📍 @d.DisplayName</LumexChip>
                    }
                </div>
            }
            <div class="flex-1 relative">
                <SearchableDropdown TItem="PlaceViewModel"
                                    @bind-SearchText="destSearch"
                                    SearchProvider="@(async s => await PlaceService.SearchAsync(s))"
                                    ValueChanged="OnPlaceSelected"
                                    ClearOnSelect="true"
                                    Placeholder="Search city or type custom name..."
                                    MinSearchLength="2">
                    <ItemTemplate Context="place">
                        <div class="flex flex-col">
                            <span class="font-semibold text-sm text-foreground">@place.Name</span>
                            @if (!string.IsNullOrEmpty(place.StateName) || !string.IsNullOrEmpty(place.CountryName))
                            {
                                <span class="text-xs text-foreground-400">
                                    @(!string.IsNullOrEmpty(place.StateName) ? place.StateName + (!string.IsNullOrEmpty(place.CountryName) ? ", " : "") : "")@(place.CountryName ?? "")
                                </span>
                            }
                        </div>
                    </ItemTemplate>
                    <ActionContent Context="searchTxt">
                        @if (!string.IsNullOrWhiteSpace(searchTxt))
                        {
                            <button type="button" @onmousedown="AddDestCustom" class="w-full text-left px-3 py-2 text-sm text-primary hover:bg-default-100 font-medium border-t border-divider">
                                + Add "@searchTxt" as custom destination
                            </button>
                        }
                    </ActionContent>
                </SearchableDropdown>
            </div>
        </div>

        <!-- Travellers & Organisers -->
        <div>
            <label class="block mb-1.5 text-sm font-medium text-foreground">Travellers &amp; Organisers</label>

            <!-- Added travellers list -->
            @if (selectedTravellers.Count > 0)
            {
                <div class="space-y-1 mb-3">
                    @foreach (var kv in selectedTravellers)
                    {
                        var tProfile = myProfiles.FirstOrDefault(p => p.Id == kv.Key);
                        var tName = tProfile?.LegalName ?? "Unknown";
                        var tIsLinked = !string.IsNullOrEmpty(tProfile?.LinkedUserId);
                        var tIsCurrentUser = kv.Key == currentUserProfileId;
                        var tState = kv.Value;
                        <div class="flex items-center justify-between p-2 bg-default-50 rounded-lg">
                            <div class="flex items-center gap-2 min-w-0">
                                <UserAvatar Email="@tProfile?.Email" Name="@tName" SizeClass="w-7 h-7" ExtraClass="flex-shrink-0" TextClass="text-xs" />
                                <span class="text-sm text-foreground truncate">@tName</span>
                                @if (tIsLinked)
                                {
                                    <LumexChip Color="ThemeColor.Success" Size="Size.Small">User</LumexChip>
                                }
                                @if (tIsCurrentUser)
                                {
                                    <LumexChip Color="ThemeColor.Primary" Size="Size.Small">You</LumexChip>
                                }
                            </div>
                            @if (tIsLinked || !tIsCurrentUser)
                            {
                                <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                                    @if (tIsLinked)
                                    {
                                        <LumexCheckbox Value="@tState.IsOrganiser" ValueChanged="@(v => SetOrganiserFlag(kv.Key, v))">Organiser</LumexCheckbox>
                                        @if (!tIsCurrentUser)
                                        {
                                            <LumexCheckbox Value="@tState.EffectiveCanEdit" ValueChanged="@(v => SetCanEditFlag(kv.Key, v))" Disabled="@tState.IsOrganiser">Can edit</LumexCheckbox>
                                        }
                                    }
                                    @if (!tIsCurrentUser)
                                    {
                                        <button type="button" @onclick="() => selectedTravellers.Remove(kv.Key)"
                                                class="text-foreground-400 hover:text-danger transition-colors">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                            </svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            <!-- Search to add travellers -->
            <div class="flex-1 relative">
                <SearchableDropdown TItem="TravellerProfileViewModel"
                                    @bind-SearchText="travellerSearch"
                                    SearchProvider="SearchTravellersAsync"
                                    ValueChanged="OnTravellerSelected"
                                    ClearOnSelect="true"
                                    Placeholder="Search to add traveller..."
                                    MinSearchLength="1">
                    <ItemTemplate Context="tp">
                        <div class="flex items-center gap-2">
                            <span>@tp.LegalName</span>
                            @if (!string.IsNullOrEmpty(tp.LinkedUserId))
                            {
                                <LumexChip Color="ThemeColor.Success" Size="Size.Small">User</LumexChip>
                            }
                        </div>
                    </ItemTemplate>
                </SearchableDropdown>
            </div>
        </div>

        <!-- Actions -->
        <div class="flex items-center gap-3 pt-2">
            <LumexButton OnClick="HandleSubmit" Disabled="@saving" Color="@ThemeColor.Primary">
                @(saving ? "Creating..." : "Create Trip")
            </LumexButton>
            <LumexButton OnClick='() => Nav.NavigateTo("/")'>Cancel</LumexButton>
        </div>
    </div>
</div>

@code {
    private string name = "";
    private DateTime? startDate = DateTime.Today;
    private DateTime? endDate = DateTime.Today.AddDays(7);
    private string? description;
    private decimal? budgetAmount;
    private string budgetCurrency = "USD";

    private string destSearch = "";
    private List<DestItem> destinations = [];

    private List<TravellerProfileViewModel> myProfiles = [];
    private Dictionary<int, TravellerEditState> selectedTravellers = [];
    private string travellerSearch = "";
    private int? currentUserProfileId;

    private bool saving = false;
    private string? errorMessage;
    private string? dateError;
    private string? userId;



    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user?.CurrencyCode != null)
                budgetCurrency = user.CurrencyCode;

            myProfiles = await TravellerService.GetMyProfilesAsync(userId);
            currentUserProfileId = myProfiles.FirstOrDefault(p => p.LinkedUserId == userId)?.Id;
            if (currentUserProfileId.HasValue)
                selectedTravellers[currentUserProfileId.Value] = new TravellerEditState { CanEdit = true };
        }
    }

    private void OnPlaceSelected(PlaceViewModel? place) { if (place != null) AddDestFromPlace(place); }
    private void OnTravellerSelected(TravellerProfileViewModel? profile) { if (profile != null) AddTraveller(profile); }

    private Task<IEnumerable<TravellerProfileViewModel>> SearchTravellersAsync(string query)
    {
        var lower = query.ToLowerInvariant();
        return Task.FromResult(myProfiles
            .Where(p => p.LegalName.ToLowerInvariant().Contains(lower) && !selectedTravellers.ContainsKey(p.Id))
            .Take(8));
    }

    private void AddDestFromPlace(PlaceViewModel place)
    {
        if (!destinations.Any(d => d.PlaceId == place.Id))
            destinations.Add(new DestItem { PlaceId = place.Id, DisplayName = place.Name + (!string.IsNullOrEmpty(place.CountryName) ? $", {place.CountryName}" : "") });
        destSearch = "";
    }

    private void AddDestCustom()
    {
        var name = destSearch.Trim();
        if (string.IsNullOrEmpty(name)) return;
        if (!destinations.Any(d => d.CustomName == name && d.PlaceId == null))
            destinations.Add(new DestItem { CustomName = name, DisplayName = name });
        destSearch = "";
    }

    private void AddTraveller(TravellerProfileViewModel profile)
    {
        if (!selectedTravellers.ContainsKey(profile.Id))
            selectedTravellers[profile.Id] = new TravellerEditState { CanEdit = false };
        travellerSearch = "";
    }

    private void SetOrganiserFlag(int profileId, bool isOrganiser)
    {
        if (selectedTravellers.TryGetValue(profileId, out var state))
            state.IsOrganiser = isOrganiser;
    }

    private void SetCanEditFlag(int profileId, bool canEdit)
    {
        if (selectedTravellers.TryGetValue(profileId, out var state) && !state.IsOrganiser)
            state.CanEdit = canEdit;
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(name)) { errorMessage = "Trip name is required."; return; }

        var start = startDate ?? DateTime.Today;
        var end = endDate ?? DateTime.Today.AddDays(7);
        dateError = null;
        if (end < start) { dateError = "End date must be on or after start date."; return; }

        if (userId == null) return;
        saving = true;
        errorMessage = null;
        try
        {
            var request = new CreateTripRequest(
                OwnerId: userId,
                Name: name.Trim(),
                Description: description?.Trim(),
                StartDate: start,
                EndDate: end,
                BudgetAmount: budgetAmount,
                BudgetCurrency: string.IsNullOrWhiteSpace(budgetCurrency) ? null : budgetCurrency.Trim().ToUpper(),
                PlaceIds: destinations.Where(d => d.PlaceId.HasValue).Select(d => d.PlaceId!.Value).ToList(),
                CustomDestinationNames: destinations.Where(d => !d.PlaceId.HasValue && !string.IsNullOrEmpty(d.CustomName)).Select(d => d.CustomName!).ToList(),
                TravellerProfileIds: selectedTravellers.Keys.ToList());
            var created = await TripService.CreateTripAsync(request);

            Nav.NavigateTo($"/trips/{created.Id}");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to create trip: {ex.Message}";
        }
        saving = false;
    }

    private class DestItem
    {
        public int? PlaceId { get; set; }
        public string? CustomName { get; set; }
        public string DisplayName { get; set; } = "";
    }

    private class TravellerEditState
    {
        public bool CanEdit { get; set; } = false;
        public bool IsOrganiser { get; set; } = false;
        public bool EffectiveCanEdit => IsOrganiser || CanEdit;
    }


}
