@page "/"
@using Viagem.Services.Interfaces
@rendermode InteractiveServer
@attribute [Authorize]
@inject ITripService TripService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>My Trips - Viagem</PageTitle>

<div class="max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-foreground">My Trips</h1>
            <p class="text-sm text-foreground-400">Manage and organize your travel plans</p>
        </div>
        <LumexButton OnClick='() => Nav.NavigateTo("/trips/create")' Color="ThemeColor.Primary">
            <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            New Trip
        </LumexButton>
    </div>

    @if (loading)
    {
        <div class="flex justify-center items-center py-20">
            <LumexSpinner Size="Size.Large" Color="ThemeColor.Info" />
        </div>
    }
    else
    {
        <!-- Upcoming Trips -->
        <section class="mb-8">
            <div class="bg-surface1 rounded-lg border border-divider p-6">
                <h2 class="text-lg font-semibold text-foreground mb-1">Upcoming Trips</h2>
                <p class="text-sm text-foreground-400 mb-4">All future trips ordered by start date</p>

                @if (upcomingTrips?.Count == 0)
                {
                    <div class="border-2 border-dashed border-primary-300 rounded-lg p-10 text-center">
                        <svg class="w-12 h-12 text-foreground-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                        </svg>
                        <p class="text-foreground-400 mb-4">No upcoming trips.</p>
                        <LumexButton OnClick='() => Nav.NavigateTo("/trips/create")' Color="ThemeColor.Primary">Plan your next adventure</LumexButton>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                        @foreach (var trip in upcomingTrips ?? [])
                        {
                            <TripCard Trip="trip" OnDeleted="LoadTrips" />
                        }
                    </div>
                }
            </div>
        </section>

        <!-- Past Trips -->
        <section>
            <div class="bg-surface1 rounded-lg border border-divider p-6">
                <h2 class="text-lg font-semibold text-foreground mb-1">Past Trips</h2>
                <p class="text-sm text-foreground-400 mb-4">In the last 12 months</p>

                @if (pastTrips?.Count == 0)
                {
                    <div class="border-2 border-dashed border-divider rounded-lg p-8 text-center">
                        <p class="text-foreground-400">No trips in the past year.</p>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                        @foreach (var trip in pastTrips ?? [])
                        {
                            <TripCard Trip="trip" OnDeleted="LoadTrips" />
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    private List<Trip>? upcomingTrips;
    private List<Trip>? pastTrips;
    private bool loading = true;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        await LoadTrips();
    }

    private async Task LoadTrips()
    {
        if (userId == null) return;
        loading = true;
        upcomingTrips = await TripService.GetUpcomingTripsAsync(userId);
        pastTrips = await TripService.GetPastTripsAsync(userId);
        loading = false;
    }
}
