@page "/travel-board"
@using Viagem.Services.Interfaces
@rendermode InteractiveServer
@attribute [Authorize]
@inject ITripService TripService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Travel Board - Viagem</PageTitle>

<div class="max-w-7xl mx-auto">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-foreground">Travel Board</h1>
        <p class="text-sm text-foreground-400">Overview of all your travel activity</p>
    </div>

    @if (loading)
    {
        <div class="flex justify-center items-center py-20">
            <LumexSpinner Size="Size.Large" Color="ThemeColor.Info" />
        </div>
    }
    else
    {
        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <p class="text-sm text-foreground-400 mb-1">Upcoming</p>
                <p class="text-3xl font-bold text-primary">@upcomingCount</p>
                <p class="text-xs text-foreground-400 mt-1">trips planned</p>
            </div>
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <p class="text-sm text-foreground-400 mb-1">Past</p>
                <p class="text-3xl font-bold text-success-600">@pastCount</p>
                <p class="text-xs text-foreground-400 mt-1">trips completed</p>
            </div>
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <p class="text-sm text-foreground-400 mb-1">Destinations</p>
                <p class="text-3xl font-bold text-secondary">@destinationCount</p>
                <p class="text-xs text-foreground-400 mt-1">places visited</p>
            </div>
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <p class="text-sm text-foreground-400 mb-1">Total</p>
                <p class="text-3xl font-bold text-warning">@(upcomingCount + pastCount)</p>
                <p class="text-xs text-foreground-400 mt-1">trips all time</p>
            </div>
        </div>

        <!-- Upcoming trips list -->
        @if (upcomingTrips.Count > 0)
        {
            <div class="bg-surface1 rounded-xl border border-divider p-6">
                <h2 class="text-lg font-semibold text-foreground mb-4">Next Upcoming Trip</h2>
                <div class="flex items-center gap-4 p-4 bg-primary-50 rounded-lg border border-primary-200">
                    <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center text-white text-xl">✈️</div>
                    <div class="flex-1">
                        <a href="/trips/@upcomingTrips[0].Id" class="text-lg font-semibold text-foreground hover:text-primary">
                            @upcomingTrips[0].Name
                        </a>
                        <p class="text-sm text-foreground-400">
                            @upcomingTrips[0].StartDate.ToString("MMMM d, yyyy")
                            @if (upcomingTrips[0].StartDate > DateTime.Today)
                            {
                                var days = (int)(upcomingTrips[0].StartDate - DateTime.Today).TotalDays;
                                <LumexChip Color="ThemeColor.Primary" Size="Size.Small" Class="ml-2">in @days days</LumexChip>
                            }
                        </p>
                    </div>
                    <LumexButton Href="@($"/trips/{upcomingTrips[0].Id}")" Color="ThemeColor.Primary">View →</LumexButton>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<Trip> upcomingTrips = [];
    private int upcomingCount = 0;
    private int pastCount = 0;
    private int destinationCount = 0;
    private bool loading = true;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            upcomingTrips = await TripService.GetUpcomingTripsAsync(userId);
            var pastTrips = await TripService.GetPastTripsAsync(userId);
            upcomingCount = upcomingTrips.Count;
            pastCount = pastTrips.Count;
            destinationCount = upcomingTrips.Concat(pastTrips)
                .SelectMany(t => t.Destinations ?? [])
                .Select(d => d.Place?.Name ?? "?")
                .Distinct()
                .Count();
        }
        loading = false;
    }
}
