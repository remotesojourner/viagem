@page "/travel-board"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ITripService TripService
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Travel Board - Viagem</PageTitle>

<div class="max-w-7xl mx-auto">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Travel Board</h1>
        <p class="text-sm text-gray-500 dark:text-gray-400">Overview of all your travel activity</p>
    </div>

    @if (loading)
    {
        <div class="flex justify-center items-center py-20">
            <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-700"></div>
        </div>
    }
    else
    {
        <!-- Stats -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Upcoming</p>
                <p class="text-3xl font-bold text-blue-600 dark:text-blue-400">@upcomingCount</p>
                <p class="text-xs text-gray-400 mt-1">trips planned</p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Past</p>
                <p class="text-3xl font-bold text-green-600 dark:text-green-400">@pastCount</p>
                <p class="text-xs text-gray-400 mt-1">trips completed</p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Destinations</p>
                <p class="text-3xl font-bold text-purple-600 dark:text-purple-400">@destinationCount</p>
                <p class="text-xs text-gray-400 mt-1">places visited</p>
            </div>
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-5">
                <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">Total</p>
                <p class="text-3xl font-bold text-orange-600 dark:text-orange-400">@(upcomingCount + pastCount)</p>
                <p class="text-xs text-gray-400 mt-1">trips all time</p>
            </div>
        </div>

        <!-- Upcoming trips list -->
        @if (upcomingTrips.Count > 0)
        {
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6">
                <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Next Upcoming Trip</h2>
                <div class="flex items-center gap-4 p-4 bg-blue-50 dark:bg-blue-900/20 rounded-lg border border-blue-200 dark:border-blue-800">
                    <div class="w-12 h-12 rounded-full bg-blue-600 flex items-center justify-center text-white text-xl">✈️</div>
                    <div class="flex-1">
                        <a href="/trips/@upcomingTrips[0].Id" class="text-lg font-semibold text-gray-900 dark:text-white hover:text-blue-600">
                            @upcomingTrips[0].Name
                        </a>
                        <p class="text-sm text-gray-500 dark:text-gray-400">
                            @upcomingTrips[0].StartDate.ToString("MMMM d, yyyy")
                            @if (upcomingTrips[0].StartDate > DateTime.Today)
                            {
                                var days = (int)(upcomingTrips[0].StartDate - DateTime.Today).TotalDays;
                                <span class="ml-2 px-2 py-0.5 text-xs bg-blue-100 text-blue-800 rounded-full dark:bg-blue-900 dark:text-blue-300">in @days days</span>
                            }
                        </p>
                    </div>
                    <a href="/trips/@upcomingTrips[0].Id"
                       class="px-3 py-1.5 text-sm font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800">
                        View →
                    </a>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<Trip> upcomingTrips = [];
    private int upcomingCount = 0;
    private int pastCount = 0;
    private int destinationCount = 0;
    private bool loading = true;
    private string? userId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            upcomingTrips = await TripService.GetUpcomingTripsAsync(userId);
            var pastTrips = await TripService.GetPastTripsAsync(userId);
            upcomingCount = upcomingTrips.Count;
            pastCount = pastTrips.Count;
            destinationCount = upcomingTrips.Concat(pastTrips)
                .SelectMany(t => t.Destinations ?? [])
                .Select(d => d.Place?.Name ?? "?")
                .Distinct()
                .Count();
        }
        loading = false;
    }
}
