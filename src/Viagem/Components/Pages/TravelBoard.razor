@page "/travel-board"
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@attribute [Authorize]
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Travel Board - Viagem</PageTitle>

<div class="max-w-7xl mx-auto">
    <div class="mb-6">
        <h1 class="text-2xl font-bold text-foreground">Travel Board</h1>
        <p class="text-sm text-foreground-400">Your travel story at a glance</p>
    </div>

    @if (loading)
    {
        <div class="flex justify-center items-center py-20">
            <LumexSpinner Size="Size.Large" Color="ThemeColor.Info" />
        </div>
    }
    else if (stats == null)
    {
        <div class="bg-surface1 rounded-xl border border-divider p-12 text-center">
            <p class="text-foreground-400 text-lg">No completed trips yet — stats will appear here once you return from your first adventure.</p>
        </div>
    }
    else
    {
        <!-- Year carousel -->
        <div class="flex flex-wrap items-center gap-2 mb-6">
            @foreach (var y in availableYears)
            {
                var label = y == 0 ? "Lifetime" : y.ToString();
                var active = selectedYear == y;
                <button @onclick="() => SelectYear(y)"
                        class="flex-shrink-0 px-4 py-1.5 rounded-full text-sm font-medium border transition-colors
                               @(active ? "bg-primary text-white border-primary" : "bg-surface1 text-foreground border-divider hover:bg-default-100")">
                    @label
                </button>
            }
        </div>

        <!-- Summary stat cards -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <p class="text-sm text-foreground-400 mb-1">Trips</p>
                <p class="text-3xl font-bold text-primary">@stats.TripCount</p>
                <p class="text-xs text-foreground-400 mt-1">completed</p>
            </div>
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <p class="text-sm text-foreground-400 mb-1">Destinations</p>
                <p class="text-3xl font-bold text-primary">@stats.DestinationCount</p>
                <p class="text-xs text-foreground-400 mt-1">places visited</p>
            </div>
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <p class="text-sm text-foreground-400 mb-1">Days</p>
                <p class="text-3xl font-bold text-primary">@stats.TotalDays</p>
                <p class="text-xs text-foreground-400 mt-1">total travel days</p>
            </div>
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <p class="text-sm text-foreground-400 mb-1">Cost</p>
                @if (expenseStats.Count == 0)
                {
                    <p class="text-xl font-bold text-primary">—</p>
                }
                else if (expenseStats.Count == 1)
                {
                    <p class="text-xl font-bold text-primary">@expenseStats[0].Total.ToString("N0") @expenseStats[0].Currency</p>
                }
                else
                {
                    <div class="space-y-0.5 mt-1">
                        @foreach (var c in expenseStats.Take(3))
                        {
                            <p class="text-sm font-semibold text-primary">@c.Total.ToString("N0") <span class="font-normal text-foreground-400">@c.Currency</span></p>
                        }
                        @if (expenseStats.Count > 3)
                        {
                            <p class="text-xs text-foreground-400">+@(expenseStats.Count - 3) more</p>
                        }
                    </div>
                }
                <p class="text-xs text-foreground-400 mt-1">total spent</p>
            </div>
        </div>

        <!-- Detail cards 2×2 -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">

            <!-- Transportation -->
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <h3 class="font-semibold text-foreground mb-3">Transportation</h3>
                @if (transportStats.Count == 0)
                {
                    <p class="text-sm text-foreground-400">No transportation recorded.</p>
                }
                else
                {
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-xs text-foreground-400 border-b border-divider">
                                <th class="text-left pb-2 font-medium">Type</th>
                                <th class="text-right pb-2 font-medium">Trips</th>
                                <th class="text-right pb-2 font-medium">Total hrs</th>
                                <th class="text-right pb-2 font-medium">Avg hrs</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in transportStats)
                            {
                                <tr class="border-b border-divider last:border-0">
                                    <td class="py-2 text-foreground">@t.Type</td>
                                    <td class="py-2 text-right text-foreground-400">@t.TripCount</td>
                                    <td class="py-2 text-right text-foreground-400">@t.TotalHours</td>
                                    <td class="py-2 text-right text-foreground-400">@t.AvgHours</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="text-xs font-semibold text-foreground border-t border-divider">
                                <td class="pt-2">Total</td>
                                <td class="pt-2 text-right">@stats.TransportationTotalTrips legs</td>
                                <td class="pt-2 text-right">@stats.TransportationTotalHours hrs</td>
                                <td class="pt-2 text-right">@stats.TransportationAvgHours avg/trip</td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>

            <!-- Lodging -->
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <h3 class="font-semibold text-foreground mb-3">Lodging</h3>
                @if (lodgingStats.Count == 0)
                {
                    <p class="text-sm text-foreground-400">No lodging recorded.</p>
                }
                else
                {
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-xs text-foreground-400 border-b border-divider">
                                <th class="text-left pb-2 font-medium">Type</th>
                                <th class="text-right pb-2 font-medium">Nights</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in lodgingStats)
                            {
                                <tr class="border-b border-divider last:border-0">
                                    <td class="py-2 text-foreground">@l.Type</td>
                                    <td class="py-2 text-right text-foreground-400">@l.Nights</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="text-xs font-semibold text-foreground border-t border-divider">
                                <td class="pt-2">Total</td>
                                <td class="pt-2 text-right">@stats.LodgingTotalNights nights</td>
                            </tr>
                        </tfoot>
                    </table>
                }
            </div>

            <!-- Activities -->
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <h3 class="font-semibold text-foreground mb-3">Activities</h3>
                <div class="flex gap-8">
                    <div>
                        <p class="text-3xl font-bold text-primary">@stats.ActivityTotalCount</p>
                        <p class="text-xs text-foreground-400 mt-1">total activities</p>
                    </div>
                    <div>
                        <p class="text-3xl font-bold text-primary">@stats.ActivityAvgPerTrip</p>
                        <p class="text-xs text-foreground-400 mt-1">avg per trip</p>
                    </div>
                </div>
            </div>

            <!-- Expenses -->
            <div class="bg-surface1 rounded-xl border border-divider p-5">
                <h3 class="font-semibold text-foreground mb-3">Expenses</h3>
                @if (expenseStats.Count == 0)
                {
                    <p class="text-sm text-foreground-400">No expenses recorded.</p>
                }
                else
                {
                    <p class="text-xs text-foreground-400 mb-3">@stats.ExpenseCurrencyCount @(stats.ExpenseCurrencyCount == 1 ? "currency" : "currencies") used</p>
                    <table class="w-full text-sm">
                        <thead>
                            <tr class="text-xs text-foreground-400 border-b border-divider">
                                <th class="text-left pb-2 font-medium">Currency</th>
                                <th class="text-right pb-2 font-medium">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var e in expenseStats)
                            {
                                <tr class="border-b border-divider last:border-0">
                                    <td class="py-2 text-foreground">@e.Currency</td>
                                    <td class="py-2 text-right text-foreground-400">@e.Total.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

        </div>

        <!-- World map -->
        <div class="bg-surface1 rounded-xl border border-divider p-5">
            <h3 class="font-semibold text-foreground mb-3">Destinations Visited</h3>
            @if (mapPins.Count == 0)
            {
                <p class="text-sm text-foreground-400">No mappable destinations — destinations need a linked place with coordinates.</p>
            }
            else
            {
                <div id="travel-map" class="w-full rounded-lg overflow-hidden" style="height:420px"></div>
            }
        </div>
    }
</div>

@code {
    private static readonly JsonSerializerOptions Json = new(JsonSerializerDefaults.Web);

    private bool loading = true;
    private string? userId;

    private List<int> availableYears = [];
    private int selectedYear = 0;

    private UserTravelStats? stats;
    private List<TransportationTypeStat> transportStats = [];
    private List<LodgingTypeStat> lodgingStats = [];
    private List<CurrencyTotalStat> expenseStats = [];
    private List<MapPin> mapPins = [];

    private record MapPin(string Name, string Latitude, string Longitude);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId == null) { loading = false; return; }

        await using var db = await DbFactory.CreateDbContextAsync();

        availableYears = await db.UserTravelStats
            .Where(s => s.UserId == userId)
            .OrderByDescending(s => s.Year)
            .Select(s => s.Year)
            .ToListAsync();

        // Move Lifetime (0) to the end of the carousel
        if (availableYears.Remove(0))
            availableYears.Add(0);

        if (availableYears.Count == 0)
            availableYears.Add(0);

        // Default to the current year if available, otherwise the most recent year
        var currentYear = DateTime.UtcNow.Year;
        selectedYear = availableYears.Contains(currentYear) ? currentYear : availableYears[0];

        mapPins = await db.UserTravelDestinations
            .Where(d => d.UserId == userId && d.Latitude != null && d.Longitude != null)
            .Select(d => new MapPin(d.PlaceName, d.Latitude!, d.Longitude!))
            .ToListAsync();

        await LoadYearStats(db, selectedYear);
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!loading && stats != null && mapPins.Count > 0)
        {
            await JS.InvokeVoidAsync("travelBoard.initMap", "travel-map",
                mapPins.Select(p => new { name = p.Name, latitude = p.Latitude, longitude = p.Longitude }));
        }
    }

    private async Task SelectYear(int year)
    {
        selectedYear = year;
        await using var db = await DbFactory.CreateDbContextAsync();
        await LoadYearStats(db, year);
    }

    private async Task LoadYearStats(ApplicationDbContext db, int year)
    {
        stats = await db.UserTravelStats
            .FirstOrDefaultAsync(s => s.UserId == userId && s.Year == year);

        transportStats = stats == null ? [] :
            JsonSerializer.Deserialize<List<TransportationTypeStat>>(stats.TransportationStatsJson, Json) ?? [];
        lodgingStats = stats == null ? [] :
            JsonSerializer.Deserialize<List<LodgingTypeStat>>(stats.LodgingStatsJson, Json) ?? [];
        expenseStats = stats == null ? [] :
            JsonSerializer.Deserialize<List<CurrencyTotalStat>>(stats.ExpenseStatsJson, Json) ?? [];
    }
}
