@page "/trips/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize]
@attribute [StreamRendering]
@inject ITripService TripService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@using Viagem.Services.Interfaces
@using Viagem.Services.ViewModels
@using GeoTimeZone

<PageTitle>@(trip?.Name ?? "Trip") - Viagem</PageTitle>

@if (loading)
{
    <div class="max-w-7xl mx-auto animate-pulse">
        <!-- Hero Skeleton -->
        <div class="w-full h-64 bg-default-200 rounded-3xl mb-6"></div>
        <!-- Tabs Skeleton -->
        <div class="flex gap-2 mb-6">
            @for (int i = 0; i < 5; i++)
            {
                <div class="w-24 h-10 bg-default-100 rounded-lg"></div>
            }
        </div>
        <!-- Content Skeleton -->
        <div class="w-full h-96 bg-default-50 rounded-2xl"></div>
    </div>
}
else if (trip == null)
{
    <div class="text-center py-20">
        <p class="text-foreground-400">Trip not found or you don't have access.</p>
        <a href="/" class="text-primary hover:underline mt-2 inline-block">← Back to My Trips</a>
    </div>
}
else
{
    <div class="max-w-7xl mx-auto">
        <!-- Trip Hero Section -->
        <TripHeroSection Trip="trip" CanEdit="canEdit" OnTripUpdated="ReloadTrip" />

        <!-- Tabs -->
        <div class="mt-6">
            <LumexTabs @bind-SelectedId="activeTab" Color="ThemeColor.Primary" FullWidth Classes="@(new TabsSlots { TabList = "flex-wrap md:flex-nowrap" })">

                <LumexTab Id="organization" Title="Organization">
                    <LumexAccordion Variant="AccordionVariant.Splitted" SelectionMode="SelectionMode.Multiple" FullWidth>
                        @if (trip.BudgetAmount.HasValue && trip.BudgetAmount > 0)
                        {
                            <LumexAccordionItem Id="budget" Title="Budget" Subtitle="Trip budget and spending overview">
                                <StartContent>
                                    <div class="w-9 h-9 rounded-lg bg-success-100 flex items-center justify-center flex-shrink-0">
                                        <svg class="w-5 h-5 text-success-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                        </svg>
                                    </div>
                                </StartContent>
                                <ChildContent>
                                    @{
                                        var pct = tripTotalExpenses > 0 ? Math.Min((double)(tripTotalExpenses / trip.BudgetAmount.Value) * 100, 100) : 0;
                                        var pctStr = pct.ToString("F0");
                                    }
                                    <div>
                                        <div class="flex justify-between text-sm mb-2">
                                            <span class="text-foreground-500">Spent: <strong>@tripTotalExpenses.ToString("N2") @trip.BudgetCurrency</strong></span>
                                            <span class="text-foreground-500">Budget: <strong>@trip.BudgetAmount?.ToString("N2") @trip.BudgetCurrency</strong></span>
                                        </div>
                                        <div class="w-full bg-default-200 rounded-full h-3 overflow-hidden">
                                            <div class="h-3 rounded-full transition-all duration-500 @(pct >= 90 ? "bg-danger" : pct >= 70 ? "bg-warning" : "bg-primary")"
                                                 style="width: @pctStr%"></div>
                                        </div>
                                        <p class="text-xs text-foreground-400 mt-1">@pctStr% of budget used</p>
                                    </div>
                                </ChildContent>
                            </LumexAccordionItem>
                        }

                        <LumexAccordionItem Id="transport" Title="Transportation" Subtitle="Flights, trains, car rentals, parking &amp; more">
                            <StartContent>
                                <div class="w-9 h-9 rounded-lg bg-secondary-100 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-5 h-5 text-secondary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                                    </svg>
                                </div>
                            </StartContent>
                            <ChildContent>
                                <TransportationSection TripId="Id" CanEdit="canEdit" UserId="@(userId ?? "")" DefaultTimezone="@defaultTimezone" TripTravellers="@(trip?.Travellers ?? [])" UserTimezone="@userTimezone" UserCurrency="@userCurrency" InitialItems="@transportations" OnItemCreated="OnTransportCreated" OnItemUpdated="OnTransportUpdated" OnItemDeleted="OnTransportDeleted" />
                            </ChildContent>
                        </LumexAccordionItem>

                        <LumexAccordionItem Id="lodging" Title="Lodging" Subtitle="Hotels, rentals, hostels &amp; accommodation">
                            <StartContent>
                                <div class="w-9 h-9 rounded-lg bg-success-100 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-5 h-5 text-success-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                                    </svg>
                                </div>
                            </StartContent>
                            <ChildContent>
                                <LodgingSection TripId="Id" CanEdit="canEdit" UserId="@(userId ?? "")" DefaultTimezone="@defaultTimezone" TripTravellers="@(trip?.Travellers ?? [])" UserTimezone="@userTimezone" UserCurrency="@userCurrency" InitialItems="@lodgings" OnItemCreated="OnLodgingCreated" OnItemUpdated="OnLodgingUpdated" OnItemDeleted="OnLodgingDeleted" />
                            </ChildContent>
                        </LumexAccordionItem>

                        <LumexAccordionItem Id="activities" Title="Activities" Subtitle="Tours, sights, restaurants &amp; experiences">
                            <StartContent>
                                <div class="w-9 h-9 rounded-lg bg-warning-100 flex items-center justify-center flex-shrink-0">
                                    <svg class="w-5 h-5 text-warning-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                </div>
                            </StartContent>
                            <ChildContent>
                                <ActivitiesSection TripId="Id" CanEdit="canEdit" UserId="@(userId ?? "")" DefaultTimezone="@defaultTimezone" TripTravellers="@(trip?.Travellers ?? [])" UserTimezone="@userTimezone" UserCurrency="@userCurrency" InitialItems="@activities" OnItemCreated="OnActivityCreated" OnItemUpdated="OnActivityUpdated" OnItemDeleted="OnActivityDeleted" />
                            </ChildContent>
                        </LumexAccordionItem>
                    </LumexAccordion>
                </LumexTab>

                <LumexTab Id="itinerary" Title="Itinerary">
                    @if (activeTab == "itinerary")
                    {
                        <ItinerarySection InitialTransportations="@transportations" InitialLodgings="@lodgings" InitialActivities="@activities" />
                    }
                </LumexTab>

                <LumexTab Id="expenses" Title="Expenses">
                    @if (activeTab == "expenses")
                    {
                        <ExpensesSection TripId="Id" CanEdit="canEdit" UserId="@(userId ?? "")" TripBudgetAmount="trip.BudgetAmount" TripBudgetCurrency="@trip.BudgetCurrency" InitialItems="@expenses" />
                    }
                </LumexTab>

                <LumexTab Id="attachments" Title="Attachments">
                    @if (activeTab == "attachments")
                    {
                        <AttachmentsSection TripId="Id" CanEdit="canEdit" />
                    }
                </LumexTab>

                <LumexTab Id="notes" Title="Notes">
                    @if (activeTab == "notes")
                    {
                        <NotesSection TripId="Id" Notes="@trip.Notes" CanEdit="canEdit" OnSaved="ReloadTrip" />
                    }
                </LumexTab>

            </LumexTabs>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private TripDetailViewModel? trip;
    private bool loading = true;
    private bool canEdit = false;
    private string? userId;
    private string? userTimezone;
    private string userCurrency = "USD";
    private string activeTab = "organization";
    private string? defaultTimezone;
    private decimal tripTotalExpenses = 0;
    private List<TransportationViewModel> transportations = [];
    private List<LodgingViewModel> lodgings = [];
    private List<ActivityViewModel> activities = [];
    private List<ExpenseViewModel> expenses = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var user = await UserManager.FindByIdAsync(userId);
            userTimezone = user?.Timezone;
            userCurrency = user?.CurrencyCode ?? "USD";
        }
        await ReloadTrip();
    }

    private async Task ReloadTrip()
    {
        loading = true;
        if (Id > 0 && userId != null)
        {
            trip = await TripService.GetTripAsync(Id, userId);
            canEdit = trip != null && await TripService.CanUserEditTripAsync(Id, userId);
            
            if (trip != null)
            {
                transportations = trip.Transportations.ToList();
                lodgings = trip.Lodgings.ToList();
                activities = trip.Activities.ToList();
                expenses = trip.Expenses.ToList();

                // Compute most common timezone among trip destinations
                defaultTimezone = trip.Destinations
                    .Select(d =>
                    {
                        if (!string.IsNullOrEmpty(d.PlaceTimezone)) return d.PlaceTimezone;
                        if (double.TryParse(d.PlaceLatitude, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lat) &&
                            double.TryParse(d.PlaceLongitude, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var lng))
                            return TimeZoneLookup.GetTimeZone(lat, lng).Result;
                        return null;
                    })
                    .Where(tz => !string.IsNullOrEmpty(tz))
                    .GroupBy(tz => tz)
                    .OrderByDescending(g => g.Count())
                    .Select(g => g.Key)
                    .FirstOrDefault();

                if (trip.BudgetAmount.HasValue && !string.IsNullOrEmpty(trip.BudgetCurrency))
                {
                    // Calculate total directly from expenses list instead of calling service
                    // Note: This is simplified. In a real app we'd convert currencies if they differ.
                    tripTotalExpenses = expenses.Where(e => e.Amount.HasValue && e.Currency == trip.BudgetCurrency).Sum(e => e.Amount!.Value);
                }
                else
                {
                    tripTotalExpenses = 0;
                }
            }
        }
        loading = false;
    }

    // ── In-memory mutation callbacks ─────────────────────────────────────
    private void OnTransportCreated(TransportationViewModel vm) { transportations.Add(vm); }
    private void OnTransportUpdated(TransportationViewModel vm) { var i = transportations.FindIndex(x => x.Id == vm.Id); if (i >= 0) transportations[i] = vm; else transportations.Add(vm); }
    private void OnTransportDeleted(Guid id) { transportations.RemoveAll(x => x.Id == id); }
    private void OnLodgingCreated(LodgingViewModel vm) { lodgings.Add(vm); }
    private void OnLodgingUpdated(LodgingViewModel vm) { var i = lodgings.FindIndex(x => x.Id == vm.Id); if (i >= 0) lodgings[i] = vm; else lodgings.Add(vm); }
    private void OnLodgingDeleted(Guid id) { lodgings.RemoveAll(x => x.Id == id); }
    private void OnActivityCreated(ActivityViewModel vm) { activities.Add(vm); }
    private void OnActivityUpdated(ActivityViewModel vm) { var i = activities.FindIndex(x => x.Id == vm.Id); if (i >= 0) activities[i] = vm; else activities.Add(vm); }
    private void OnActivityDeleted(Guid id) { activities.RemoveAll(x => x.Id == id); }
}