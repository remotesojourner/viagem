@page "/Account/Manage"
@rendermode InteractiveServer

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Profile</PageTitle>

@if (statusMessage is not null)
{
    var isError = statusMessage.StartsWith("Error");
    <div class="@(isError ? "p-4 mb-4 text-sm text-danger rounded-lg bg-danger-100" : "p-4 mb-4 text-sm text-success rounded-lg bg-success-100")" role="alert">
        @statusMessage
    </div>
}

<div class="bg-surface1 rounded-xl border border-divider p-6 mb-6">
    <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="p-3 mb-4 text-sm text-danger rounded-lg bg-danger-100" role="alert" />

        <div class="mb-4">
            <label for="fullName" class="block mb-2 text-sm font-medium text-foreground">Full Name</label>
            <InputText @bind-Value="Input.FullName" id="fullName"
                       class="bg-default-50 border border-divider text-foreground text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5"
                       placeholder="Your full name" />
            <ValidationMessage For="() => Input.FullName" class="mt-1 text-sm text-danger" />
        </div>

        <div class="mb-4">
            <label for="currencyCode" class="block mb-2 text-sm font-medium text-foreground">Default Currency</label>
            <InputSelect @bind-Value="Input.CurrencyCode" id="currencyCode"
                         class="bg-default-50 border border-divider text-foreground text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5">
                @foreach (var c in Currencies)
                {
                    <option value="@c.Code">@c.Code - @c.Name</option>
                }
            </InputSelect>
        </div>

        <div class="mb-4">
            <label for="timezone" class="block mb-2 text-sm font-medium text-foreground">Timezone</label>
            <InputSelect @bind-Value="Input.Timezone" id="timezone"
                         class="bg-default-50 border border-divider text-foreground text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5">
                @foreach (var tz in TimeZoneConverter.TZConvert.KnownIanaTimeZoneNames)
                {
                    <option value="@tz">@tz</option>
                }
            </InputSelect>
        </div>

        <div class="mb-4">
            <label for="appearance" class="block mb-2 text-sm font-medium text-foreground">Theme</label>
            <InputSelect @bind-Value="Input.Appearance" id="appearance"
                         class="bg-default-50 border border-divider text-foreground text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5">
                <option value="light">Light</option>
                <option value="dark">Dark</option>
                <option value="system">System</option>
            </InputSelect>
        </div>

        <div class="mb-6">
            <label for="mapsProvider" class="block mb-2 text-sm font-medium text-foreground">Open maps links with</label>
            <InputSelect @bind-Value="Input.MapsProvider" id="mapsProvider"
                         class="bg-default-50 border border-divider text-foreground text-sm rounded-lg focus:ring-primary focus:border-primary block w-full p-2.5">
                <option value="google">Google Maps</option>
                <option value="apple">Apple Maps</option>
                <option value="osm">OpenStreetMap</option>
            </InputSelect>
        </div>

        <LumexButton Type="ButtonType.Submit" disabled="@isSaving" Color="ThemeColor.Primary">
            @(isSaving ? "Saving..." : "Save Profile")
        </LumexButton>
    </EditForm>
</div>

@code {
    private ApplicationUser user = default!;
    private string? statusMessage;
    private bool isSaving;

    private InputModel Input { get; set; } = new();

    private record CurrencyItem(string Code, string Name);

    private static readonly IReadOnlyList<CurrencyItem> Currencies =
    [
        new("AED","UAE Dirham"), new("AUD","Australian Dollar"), new("BRL","Brazilian Real"),
        new("CAD","Canadian Dollar"), new("CHF","Swiss Franc"), new("CNY","Chinese Yuan"),
        new("CZK","Czech Koruna"), new("DKK","Danish Krone"), new("EUR","Euro"),
        new("GBP","British Pound"), new("HKD","Hong Kong Dollar"), new("HUF","Hungarian Forint"),
        new("IDR","Indonesian Rupiah"), new("ILS","Israeli Shekel"), new("INR","Indian Rupee"),
        new("JPY","Japanese Yen"), new("KRW","South Korean Won"), new("MXN","Mexican Peso"),
        new("MYR","Malaysian Ringgit"), new("NOK","Norwegian Krone"), new("NZD","New Zealand Dollar"),
        new("PHP","Philippine Peso"), new("PLN","Polish Zloty"), new("RON","Romanian Leu"),
        new("SAR","Saudi Riyal"), new("SEK","Swedish Krona"), new("SGD","Singapore Dollar"),
        new("THB","Thai Baht"), new("TRY","Turkish Lira"), new("TWD","New Taiwan Dollar"),
        new("UAH","Ukrainian Hryvnia"), new("USD","US Dollar"), new("VND","Vietnamese Dong"),
        new("ZAR","South African Rand")
    ];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        user = (await UserManager.FindByIdAsync(userId))!;

        Input.FullName = user.FullName;
        Input.CurrencyCode = user.CurrencyCode ?? "USD";
        Input.Timezone = user.Timezone ?? "UTC";
        Input.Appearance = user.WebsiteAppearance ?? "system";
        Input.MapsProvider = user.MapsProvider ?? "google";
    }

    private async Task OnValidSubmitAsync()
    {
        isSaving = true;
        statusMessage = null;

        user.FullName = Input.FullName;
        user.CurrencyCode = Input.CurrencyCode;
        user.Timezone = Input.Timezone;
        user.WebsiteAppearance = Input.Appearance;
        user.MapsProvider = Input.MapsProvider;

        var updateResult = await UserManager.UpdateAsync(user);
        if (!updateResult.Succeeded)
        {
            statusMessage = $"Error: {string.Join(", ", updateResult.Errors.Select(e => e.Description))}";
            isSaving = false;
            return;
        }

        statusMessage = "Your profile has been updated";
        isSaving = false;
    }

    private sealed class InputModel
    {
        public string? FullName { get; set; }
        public string? CurrencyCode { get; set; }
        public string? Timezone { get; set; }
        public string? Appearance { get; set; }
        public string? MapsProvider { get; set; }
    }
}
