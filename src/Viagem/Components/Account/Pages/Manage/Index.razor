@page "/Account/Manage"
@rendermode InteractiveServer

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Profile</PageTitle>

@if (statusMessage is not null)
{
    var isError = statusMessage.StartsWith("Error");
    <LumexAlert Color="@(isError ? ThemeColor.Danger : ThemeColor.Success)" Variant="AlertVariant.Flat" Description="@statusMessage" Class="mb-4" />
}

<div class="bg-surface1 rounded-xl border border-divider p-6 mb-6">
    <EditForm Model="Input" OnValidSubmit="OnValidSubmitAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="p-3 mb-4 text-sm text-danger rounded-lg bg-danger-100" role="alert" />

        <div class="mb-6">
            <LumexTextbox @bind-Value="Input.FullName" Label="Full Name" Placeholder="Your full name" />
            <ValidationMessage For="() => Input.FullName" class="mt-1 text-sm text-danger" />
        </div>

        <div class="mb-6">
            <SearchableDropdown TItem="Viagem.Common.CurrencyItem"
                                Value="@Viagem.Common.AppConstants.Currencies.FirstOrDefault(c => c.Code == Input.CurrencyCode)"
                                ValueChanged="@(c => Input.CurrencyCode = c?.Code ?? "")"
                                Items="Viagem.Common.AppConstants.Currencies"
                                ItemText='c => $"{c.Flag} {c.Code} - {c.Name}"'
                                Label="Default Currency"
                                Placeholder="— select currency —" />
        </div>

        <div class="mb-6">
            <SearchableDropdown TItem="string"
                                @bind-Value="Input.Timezone"
                                Items="Viagem.Common.AppConstants.Timezones"
                                Label="Timezone"
                                Placeholder="— select timezone —" />
        </div>

        <div class="mb-6">
            <LumexSelect @bind-Value="Input.ThemeColor" Label="Theme Color">
                <LumexSelectItem Value="@("system")" TextValue="System">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-gray-400"></div>
                        <span>System</span>
                    </div>
                </LumexSelectItem>
                <LumexSelectItem Value="@("blue")" TextValue="Blue">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-blue-500"></div>
                        <span>Blue</span>
                    </div>
                </LumexSelectItem>
                <LumexSelectItem Value="@("green")" TextValue="Green">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-green-500"></div>
                        <span>Green</span>
                    </div>
                </LumexSelectItem>
                <LumexSelectItem Value="@("purple")" TextValue="Purple">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-purple-500"></div>
                        <span>Purple</span>
                    </div>
                </LumexSelectItem>
                <LumexSelectItem Value="@("orange")" TextValue="Orange">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-orange-500"></div>
                        <span>Orange</span>
                    </div>
                </LumexSelectItem>
                <LumexSelectItem Value="@("red")" TextValue="Red">
                    <div class="flex items-center gap-2">
                        <div class="w-3 h-3 rounded-full bg-red-500"></div>
                        <span>Red</span>
                    </div>
                </LumexSelectItem>
            </LumexSelect>
        </div>

        <div class="mb-6">
            <LumexSelect @bind-Value="Input.MapsProvider" Label="Open maps links with">
                <LumexSelectItem Value="@("google")" TextValue="Google Maps">Google Maps</LumexSelectItem>
                <LumexSelectItem Value="@("apple")" TextValue="Apple Maps">Apple Maps</LumexSelectItem>
                <LumexSelectItem Value="@("osm")" TextValue="OpenStreetMap">OpenStreetMap</LumexSelectItem>
            </LumexSelect>
        </div>

        <LumexButton Type="ButtonType.Submit" disabled="@isSaving" Color="ThemeColor.Primary">
            @(isSaving ? "Saving..." : "Save Profile")
        </LumexButton>
    </EditForm>
</div>

@code {
    private ApplicationUser user = default!;
    private string? statusMessage;
    private bool isSaving;

    private InputModel Input { get; set; } = new();



    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId is null) return;

        user = (await UserManager.FindByIdAsync(userId))!;

        Input.FullName = user.FullName;
        Input.CurrencyCode = user.CurrencyCode ?? "USD";
        Input.Timezone = user.Timezone ?? "UTC";
        Input.ThemeColor = user.ThemeColor ?? "blue";
        Input.MapsProvider = user.MapsProvider ?? "google";
    }

    private async Task OnValidSubmitAsync()
    {
        isSaving = true;
        statusMessage = null;
        StateHasChanged();
        await Task.Delay(50); // Allow UI to repaint

        user.FullName = Input.FullName;
        user.CurrencyCode = Input.CurrencyCode;
        user.Timezone = Input.Timezone;
        user.ThemeColor = Input.ThemeColor;
        user.MapsProvider = Input.MapsProvider;

        var updateResult = await UserManager.UpdateAsync(user);
        if (!updateResult.Succeeded)
        {
            statusMessage = $"Error: {string.Join(", ", updateResult.Errors.Select(e => e.Description))}";
            isSaving = false;
            return;
        }

        statusMessage = "Your profile has been updated";
        isSaving = false;
    }

    private sealed class InputModel
    {
        public string? FullName { get; set; }
        public string? CurrencyCode { get; set; }
        public string? Timezone { get; set; }
        public string? ThemeColor { get; set; }
        public string? MapsProvider { get; set; }
    }
}
