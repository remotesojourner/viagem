@page "/Account/ResetPasswordConfirmation"

<PageTitle>Password reset - Viagem</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-default-50 px-4">
    <div class="w-full max-w-md text-center">
        <div class="bg-surface1 rounded-2xl shadow-sm border border-divider p-8">
            <div class="w-12 h-12 rounded-full bg-success-100 flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-success-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            </div>
            <h1 class="text-2xl font-bold text-foreground mb-2">Password reset</h1>
            <p class="text-sm text-foreground-400 mb-6" role="alert">Your password has been successfully reset.</p>
            <LumexButton Href="Account/Login" Color="ThemeColor.Primary">Sign in</LumexButton>
        </div>
    </div>
</div>
