@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Forgot password confirmation - Viagem</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-default-50 px-4">
    <div class="w-full max-w-md text-center">
        <div class="bg-surface1 rounded-2xl shadow-sm border border-divider p-8">
            <div class="w-12 h-12 rounded-full bg-success-100 flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-success-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <h1 class="text-2xl font-bold text-foreground mb-2">Check your email</h1>
            <p class="text-sm text-foreground-400 mb-6" role="alert">We sent a password reset link to your email address.</p>
            <a href="Account/Login" class="font-medium text-primary hover:underline text-sm">Back to sign in</a>
        </div>
    </div>
</div>
