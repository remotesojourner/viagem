@page "/Account/InvalidPasswordReset"

<PageTitle>Invalid password reset</PageTitle>

<div class="min-h-screen flex items-center justify-center bg-default-50 px-4">
    <div class="w-full max-w-md text-center">
        <div class="bg-surface1 rounded-2xl shadow-sm border border-divider p-8">
            <div class="w-12 h-12 rounded-full bg-danger-100 flex items-center justify-center mx-auto mb-4">
                <svg class="w-6 h-6 text-danger" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
            </div>
            <h1 class="text-2xl font-bold text-foreground mb-2">Invalid password reset</h1>
            <p class="text-sm text-foreground-400 mb-6" role="alert">The password reset link is invalid.</p>
            <a href="Account/Login" class="font-medium text-primary hover:underline text-sm">Back to sign in</a>
        </div>
    </div>
</div>
