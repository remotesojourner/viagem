@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Nav

@{
    var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
}

<div class="flex flex-col md:inline-flex md:flex-row p-1 gap-2 bg-default-100 rounded-medium overflow-x-auto mb-3 w-full md:w-auto">
    <a href="/Account/Manage"
       class="@Tab(path == "/account/manage")">Profile</a>
    <a href="/Account/Manage/Email"
       class="@Tab(path.StartsWith("/account/manage/email"))">Email</a>
    <a href="/Account/Manage/ChangePassword"
       class="@Tab(path.StartsWith("/account/manage/changepassword"))">Password</a>
    @if (hasExternalLogins)
    {
        <a href="/Account/Manage/ExternalLogins"
           class="@Tab(path.StartsWith("/account/manage/externallogins"))">External logins</a>
    }
    <a href="/Account/Manage/TwoFactorAuthentication"
       class="@Tab(path.StartsWith("/account/manage/twofactorauthentication") || path.StartsWith("/account/manage/enableauthenticator") || path.StartsWith("/account/manage/disable2fa") || path.StartsWith("/account/manage/generaterecoverycodes") || path.StartsWith("/account/manage/resetauthenticator"))">Two-factor authentication</a>
    <a href="/Account/Manage/PersonalData"
       class="@Tab(path.StartsWith("/account/manage/personaldata") || path.StartsWith("/account/manage/deletepersonaldata"))">Personal data</a>
</div>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }

    private static string Tab(bool active) => active
        ? "relative flex justify-center items-center px-3 h-8 text-sm rounded-small whitespace-nowrap bg-primary text-white shadow-sm cursor-pointer transition-opacity"
        : "relative flex justify-center items-center px-3 h-8 text-sm rounded-small whitespace-nowrap text-foreground-500 hover:opacity-70 cursor-pointer transition-opacity";
}
