<StatusMessage Message="@StatusMessage" />

<div class="bg-surface1 rounded-xl border border-divider p-6">
    <h2 class="text-lg font-semibold text-foreground mb-4">Recovery codes</h2>

    <div class="p-4 mb-6 text-sm text-warning bg-warning-100 rounded-lg" role="alert">
        <p><strong>Put these codes in a safe place.</strong></p>
        <p class="mt-1">If you lose your device and don't have the recovery codes you will lose access to your account.</p>
    </div>

    <div class="grid grid-cols-2 gap-2">
        @foreach (var recoveryCode in RecoveryCodes)
        {
            <code class="block px-3 py-2 text-sm font-mono bg-default-100 text-foreground rounded-lg border border-divider">@recoveryCode</code>
        }
    </div>
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
