@inject ITripService TripService
@using Viagem.Services.Interfaces
@using Markdig

<style>
    /* ── Notes display (read-only rendered markdown) ── */
    .notes-display h1 { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; }
    .notes-display h2 { font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem; }
    .notes-display p { margin-bottom: 0.5rem; }
    .notes-display ul { list-style-type: disc; padding-left: 1.5rem; margin-bottom: 0.5rem; }
    .notes-display ol { list-style-type: decimal; padding-left: 1.5rem; margin-bottom: 0.5rem; }
    .notes-display blockquote { border-left: 4px solid rgb(209 213 219); padding-left: 1rem; color: rgb(107 114 128); margin-bottom: 0.5rem; }
    .notes-display strong { font-weight: 600; }
    .notes-display em { font-style: italic; }
    .notes-display s { text-decoration: line-through; }
    .notes-display a { color: rgb(59 130 246); text-decoration: underline; }

    /* ── EasyMDE light mode baseline ── */
    .CodeMirror {
        font-family: 'Inter', sans-serif;
        font-size: 0.875rem;
        border-radius: 0 0 0.5rem 0.5rem;
        border-color: rgb(209 213 219);
        background: rgb(255 255 255);
        color: rgb(17 24 39);
    }
    .editor-toolbar {
        border-color: rgb(209 213 219);
        border-radius: 0.5rem 0.5rem 0 0;
        background: rgb(249 250 251);
    }
    .editor-toolbar a { color: rgb(55 65 81) !important; }
    .editor-toolbar a:hover,
    .editor-toolbar a.active { background: rgb(229 231 235) !important; color: rgb(17 24 39) !important; border-color: rgb(209 213 219) !important; }
    .editor-toolbar i.separator { border-color: rgb(209 213 219); }
    .editor-statusbar { color: rgb(107 114 128); border-color: rgb(209 213 219); font-size: 0.75rem; }
    .editor-preview { background: rgb(255 255 255); color: rgb(17 24 39); border-color: rgb(209 213 219); font-size: 0.875rem; }
    .CodeMirror-cursor { border-left-color: rgb(17 24 39); }

    /* ── EasyMDE dark mode overrides (html.dark) ── */
    html.dark .CodeMirror {
        background: rgb(31 41 55);
        color: rgb(243 244 246);
        border-color: rgb(75 85 99);
    }
    html.dark .CodeMirror-selected { background: rgb(55 65 81); }
    html.dark .CodeMirror-cursor { border-left-color: rgb(243 244 246); }
    html.dark .CodeMirror-scroll { background: rgb(31 41 55); }
    html.dark .editor-toolbar {
        background: rgb(55 65 81);
        border-color: rgb(75 85 99);
    }
    html.dark .editor-toolbar a { color: rgb(209 213 219) !important; border: none !important; }
    html.dark .editor-toolbar a:hover {
        background: rgb(75 85 99) !important;
        color: rgb(255 255 255) !important;
        border: none !important;
    }
    html.dark .editor-toolbar a.active {
        background: rgb(55 65 81) !important;
        color: rgb(255 255 255) !important;
        border: none !important;
    }
    html.dark .editor-toolbar i.separator { border-color: rgb(75 85 99); }
    html.dark .editor-toolbar.disabled-for-preview a:not(.no-disable) { color: rgb(107 114 128) !important; }
    html.dark .editor-statusbar { color: rgb(156 163 175); border-color: rgb(75 85 99); }
    html.dark .editor-preview {
        background: rgb(31 41 55);
        color: rgb(209 213 219);
        border-color: rgb(75 85 99);
    }
    html.dark .editor-preview pre { background: rgb(17 24 39); }
    html.dark .CodeMirror-fullscreen,
    html.dark .editor-toolbar.fullscreen { background: rgb(17 24 39); }
    html.dark .editor-preview-side {
        background: rgb(31 41 55);
        border-color: rgb(75 85 99);
    }
</style>

<div class="max-w-2xl">
    @if (CanEdit)
    {
        @if (!editing)
        {
            @if (string.IsNullOrWhiteSpace(Notes))
            {
                <div class="border-2 border-dashed border-divider rounded-lg p-8 text-center mb-4">
                    <span class="text-4xl block mb-3">📝</span>
                    <p class="text-sm text-foreground-400 mb-3">No notes yet.</p>
                    <LumexButton OnClick="StartEditing" Color="ThemeColor.Primary">
                        Add Notes
                    </LumexButton>
                </div>
            }
            else
            {
                <div class="bg-default-50 rounded-xl p-4 mb-4">
                    <div class="flex items-start justify-between gap-2">
                        <div class="notes-display text-sm text-foreground-500 flex-1">
                            @((MarkupString)RenderedNotes)
                        </div>
                        <button @onclick="StartEditing"
                                class="flex-shrink-0 text-xs text-primary hover:text-primary-700 flex items-center gap-1">
                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            Edit
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            <div>
                <label class="block text-sm font-medium text-foreground-500 mb-2">Trip Notes</label>
                <MarkdownEditor @bind-Value="draftNotes"
                                MinHeight="200px"
                                Placeholder="Packing lists, reminders, important contacts, visa info..."
                                SpellChecker="false"
                                HideIcons="@(new[] { "side-by-side", "fullscreen", "image", "guide" })" />
                <div class="flex items-center gap-3 mt-3">
                    <LumexButton OnClick="Save" disabled="@saving" Color="ThemeColor.Primary">
                        @(saving ? "Saving..." : "Save Notes")
                    </LumexButton>
                    <LumexButton OnClick="CancelEditing" disabled="@saving">
                        Cancel
                    </LumexButton>
                    @if (!string.IsNullOrWhiteSpace(savedMessage))
                    {
                        <span class="text-sm text-success-600">@savedMessage</span>
                    }
                </div>
            </div>
        }
    }
    else
    {
        @if (string.IsNullOrWhiteSpace(Notes))
        {
            <p class="text-sm text-foreground-400 italic">No notes for this trip.</p>
        }
        else
        {
            <div class="bg-default-50 rounded-xl p-4">
                <div class="notes-display text-sm text-foreground-500">
                    @((MarkupString)RenderedNotes)
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int TripId { get; set; }
    [Parameter] public string? Notes { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool editing = false;
    private bool saving = false;
    private string? draftNotes;
    private string? savedMessage;

    private string RenderedNotes => string.IsNullOrWhiteSpace(Notes)
        ? string.Empty
        : Markdown.ToHtml(Notes, new MarkdownPipelineBuilder().UseAdvancedExtensions().Build());

    private void StartEditing()
    {
        draftNotes = Notes;
        editing = true;
        savedMessage = null;
    }

    private void CancelEditing()
    {
        editing = false;
        draftNotes = null;
    }

    private async Task Save()
    {
        saving = true;
        await TripService.UpdateNotesAsync(TripId, draftNotes);
        saving = false;
        editing = false;
        savedMessage = "Saved!";
        await OnSaved.InvokeAsync();
        await Task.Delay(3000);
        savedMessage = null;
    }
}

