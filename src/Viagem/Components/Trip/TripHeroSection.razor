    private string GetMapUrl(TripDestinationViewModel dest)
    {
        var provider = userMapsProvider?.ToLowerInvariant() ?? "google";
        var hasCoords = !string.IsNullOrEmpty(dest.PlaceLatitude) && !string.IsNullOrEmpty(dest.PlaceLongitude);

        var query = Uri.EscapeDataString(dest.DisplayName);

        return provider switch
        {
            "apple" when hasCoords =>
                $"https://maps.apple.com/?ll={dest.PlaceLatitude},{dest.PlaceLongitude}&q={query}",
            "apple" =>
                $"https://maps.apple.com/?q={query}",
            "osm" or "openstreetmap" when hasCoords =>
                $"https://www.openstreetmap.org/#map=12/{dest.PlaceLatitude}/{dest.PlaceLongitude}",
            "osm" or "openstreetmap" =>
                $"https://www.openstreetmap.org/search?query={query}",
            _ when hasCoords =>
                $"https://www.google.com/maps/@{dest.PlaceLatitude},{dest.PlaceLongitude},12z",
            _ =>
                $"https://www.google.com/maps/search/?api=1&query={query}"
        };
    }

    private string GetTimezoneTooltip(TripDestinationViewModel dest) =>
        GetTimezoneTooltipForZone(dest.PlaceTimezone);

    private string GetTimezoneTooltipForZone(string? timezone)
    {
        if (string.IsNullOrEmpty(timezone)) return "";
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(timezone);
            var now = DateTimeOffset.UtcNow;
            var offset = zone.GetUtcOffset(now);

            if (!string.IsNullOrEmpty(userTimezone))
            {
                try
                {
                    var userZone = TimeZoneInfo.FindSystemTimeZoneById(userTimezone);
                    var diff = offset - userZone.GetUtcOffset(now);
                    if (diff == TimeSpan.Zero)
                        return $"{timezone} (same as your timezone)";
                    var diffStr = diff.Duration().Minutes == 0
                        ? $"{(int)Math.Abs(diff.TotalHours)}h"
                        : $"{Math.Abs(diff.TotalHours):0.#}h";
                    var aheadBehind = diff.TotalHours > 0 ? "ahead of" : "behind";
                    return $"{timezone} (Your timezone is {diffStr} {aheadBehind} this)";
                }
                catch { }
            }

            var offsetSign = offset >= TimeSpan.Zero ? "+" : "-";
            var offsetHrs = offset.Duration().Minutes == 0
                ? $"{offsetSign}{(int)offset.Duration().TotalHours}h"
                : $"{offsetSign}{offset.Duration().TotalHours:0.#}h";
            return $"{timezone} (UTC{offsetHrs})";
        }
        catch
        {
            return timezone;
        }
    }
