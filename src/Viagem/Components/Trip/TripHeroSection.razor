@inject ITripService TripService
@inject IPlaceService PlaceService
@inject ITravellerProfileService TravellerService
@inject AuthenticationStateProvider AuthStateProvider
@inject Microsoft.AspNetCore.Identity.UserManager<Viagem.Data.ApplicationUser> UserManager
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebEnv
@inject IJSRuntime JS

<!-- Edit Trip Modal -->
@if (showEditModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Edit Trip</h3>
                <button @onclick="CloseEditModal" class="text-gray-400 hover:text-gray-600 dark:hover:text-gray-200">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="p-6 space-y-5">
                @if (!string.IsNullOrEmpty(editError))
                {
                    <div class="p-3 text-sm text-red-800 bg-red-50 rounded-lg dark:bg-red-900/30 dark:text-red-400">@editError</div>
                }

                <!-- Trip Name -->
                <div>
                    <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Trip Name *</label>
                    <input @bind="editName" type="text" class="@InputClass" placeholder="My Amazing Trip" />
                </div>

                <!-- Dates -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Start Date *</label>
                        <input @bind="editStart" type="date" class="@InputClass" />
                    </div>
                    <div>
                        <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">End Date *</label>
                        <input @bind="editEnd" type="date" class="@InputClass" />
                    </div>
                </div>

                <!-- Description -->
                <div>
                    <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Description</label>
                    <textarea @bind="editDescription" rows="2" class="@InputClass" placeholder="What is this trip about?"></textarea>
                </div>

                <!-- Budget -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Budget Amount</label>
                        <input @bind="editBudget" type="number" step="0.01" min="0" class="@InputClass" placeholder="0.00" />
                    </div>
                    <div>
                        <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Currency</label>
                        <Combobox @bind-Value="editCurrency" Placeholder="Select currency..." SearchPlaceholder="Search currencies...">
                            @foreach (var c in Currencies)
                            {
                                <ComboboxItem Value="@c.Code" Label="@(c.Code + " - " + c.Name)" />
                            }
                        </Combobox>
                    </div>
                </div>

                <!-- Destinations -->
                <div>
                    <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Destinations</label>
                    @if (editDestinations.Any(d => !d.MarkedForRemoval))
                    {
                        <div class="flex flex-wrap gap-2 mb-3">
                            @foreach (var d in editDestinations.Where(d => !d.MarkedForRemoval))
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 text-sm bg-blue-100 text-blue-800 rounded-full dark:bg-blue-900/40 dark:text-blue-300">
                                    📍 @d.DisplayName
                                    <button type="button" @onclick="() => RemoveEditDest(d)"
                                            class="ml-1 text-blue-500 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-200">&#x2715;</button>
                                </span>
                            }
                        </div>
                    }
                    <div class="flex gap-2">
                        <div class="flex-1 relative">
                            <input value="@destSearch" @oninput="HandleDestInput" type="text" class="@InputClass"
                                   placeholder="Search city..." autocomplete="off" />
                            @if (destResults.Count > 0)
                            {
                                <ul class="absolute z-10 mt-1 w-full bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg shadow-lg max-h-44 overflow-y-auto">
                                    @foreach (var place in destResults)
                                    {
                                        <li>
                                            <button type="button" @onclick="() => AddDestFromPlace(place)"
                                                    class="w-full text-left px-3 py-2 hover:bg-gray-50 dark:hover:bg-gray-600">
                                                <span class="font-semibold text-sm text-gray-800 dark:text-gray-200">@place.Name</span>
                                                @if (!string.IsNullOrEmpty(place.StateName) || !string.IsNullOrEmpty(place.CountryName))
                                                {
                                                    <span class="text-xs text-gray-500 dark:text-gray-400 ml-1">
                                                        @(!string.IsNullOrEmpty(place.StateName) ? place.StateName + (!string.IsNullOrEmpty(place.CountryName) ? ", " : "") : "")@(place.CountryName ?? "")
                                                    </span>
                                                }
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <button type="button" @onclick="AddDestCustom"
                                class="px-3 py-2 text-sm font-medium text-white bg-gray-600 rounded-lg hover:bg-gray-700 dark:bg-gray-600 dark:hover:bg-gray-500 whitespace-nowrap">
                            Add custom
                        </button>
                    </div>
                </div>

                <!-- Travellers & Organisers -->
                <div>
                    <label class="block mb-1.5 text-sm font-medium text-gray-900 dark:text-white">Travellers &amp; Organisers</label>

                    <!-- Added travellers list -->
                    @if (editTravellers.Count > 0)
                    {
                        <div class="space-y-1 mb-3">
                            @foreach (var kv in editTravellers)
                            {
                                var tProfile = availableTravellers.FirstOrDefault(p => p.Id == kv.Key);
                                var tName = tProfile?.LegalName ?? "Unknown";
                                var tIsLinked = !string.IsNullOrEmpty(tProfile?.LinkedUserId);
                                var tIsCurrentUser = kv.Key == currentUserProfileId;
                                var tState = kv.Value;
                                <div class="flex items-center justify-between p-2 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
                                    <div class="flex items-center gap-2 min-w-0">
                                        <UserAvatar Email="@tProfile?.Email" Name="@tName" SizeClass="w-7 h-7" ExtraClass="flex-shrink-0" TextClass="text-xs" />
                                        <span class="text-sm text-gray-900 dark:text-white truncate">@tName</span>
                                        @if (tIsLinked)
                                        {
                                            <span class="text-xs px-1.5 py-0.5 bg-green-100 text-green-700 rounded dark:bg-green-900/40 dark:text-green-400 flex-shrink-0">User</span>
                                        }
                                        @if (tIsCurrentUser)
                                        {
                                            <span class="text-xs px-1.5 py-0.5 bg-blue-100 text-blue-700 rounded dark:bg-blue-900/40 dark:text-blue-400 flex-shrink-0">You</span>
                                        }
                                    </div>
                                    @if (tIsLinked || !tIsCurrentUser)
                                    {
                                        <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                                            @if (tIsLinked)
                                            {
                                                <label class="flex items-center gap-1 cursor-pointer text-xs text-gray-600 dark:text-gray-400 select-none">
                                                    <input type="checkbox" class="w-3.5 h-3.5 text-purple-600 rounded"
                                                           checked="@tState.IsOrganiser"
                                                           @onchange="e => SetOrganiserFlag(kv.Key, (bool)(e.Value ?? false))" />
                                                    Organiser
                                                </label>
                                                @if (!tIsCurrentUser)
                                                {
                                                    <label class="flex items-center gap-1 text-xs select-none @(tState.IsOrganiser ? "cursor-not-allowed opacity-50 text-gray-400 dark:text-gray-500" : "cursor-pointer text-gray-600 dark:text-gray-400")">
                                                        <input type="checkbox" class="w-3.5 h-3.5 text-blue-600 rounded"
                                                               disabled="@tState.IsOrganiser"
                                                               checked="@tState.EffectiveCanEdit"
                                                               @onchange="e => SetCanEditFlag(kv.Key, (bool)(e.Value ?? false))" />
                                                        Can edit
                                                    </label>
                                                }
                                            }
                                            @if (!tIsCurrentUser)
                                            {
                                                <button type="button" @onclick="() => RemoveTravellerFromEdit(kv.Key)"
                                                        class="text-gray-400 hover:text-red-500 dark:hover:text-red-400 transition-colors">
                                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                                    </svg>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <!-- Search box to add travellers -->
                    <div class="relative">
                        <input value="@travellerSearch" @oninput="HandleTravellerSearch" type="text" class="@InputClass"
                               placeholder="Search to add traveller..." autocomplete="off" />
                        @if (travellerSearchResults.Count > 0)
                        {
                            <ul class="absolute z-10 mt-1 w-full bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg shadow-lg max-h-44 overflow-y-auto">
                                @foreach (var tp in travellerSearchResults)
                                {
                                    <li>
                                        <button type="button" @onclick="() => AddTravellerToEdit(tp)"
                                                class="w-full text-left px-3 py-2 text-sm hover:bg-gray-50 dark:hover:bg-gray-600 text-gray-800 dark:text-gray-200 flex items-center gap-2">
                                            <span>@tp.LegalName</span>
                                            @if (!string.IsNullOrEmpty(tp.LinkedUserId))
                                            {
                                                <span class="text-xs px-1 py-0.5 bg-green-100 text-green-700 rounded dark:bg-green-900/40 dark:text-green-400">User</span>
                                            }
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
            <div class="flex justify-end gap-3 p-6 border-t border-gray-200 dark:border-gray-700">
                <button @onclick="CloseEditModal" class="@SecondaryBtnClass">Cancel</button>
                <button @onclick="SaveAll" disabled="@saving" class="@PrimaryBtnClass">@(saving ? "Saving..." : "Save Changes")</button>
            </div>
        </div>
    </div>
}

<!-- Hidden cover image file input -->
@if (CanEdit)
{
    <InputFile OnChange="HandleCoverUpload" accept="image/jpeg,image/png,image/webp,image/gif" id="coverFileInput" class="sr-only" />
}

@if (!string.IsNullOrEmpty(coverError))
{
    <div class="mb-3 p-3 text-sm text-red-800 bg-red-50 rounded-lg dark:bg-red-900/30 dark:text-red-400">@coverError</div>
}

<!-- Hero Section -->
<div class="relative rounded-2xl overflow-hidden mb-6 shadow-lg">
    <!-- Background: cover image or gradient -->
    <div class="h-64 sm:h-72 relative bg-gradient-to-br from-blue-600 to-indigo-700">
        @if (!string.IsNullOrEmpty(Trip.CoverImagePath))
        {
            <img src="@Trip.CoverImagePath" alt="@Trip.Name" class="absolute inset-0 w-full h-full object-cover" />
        }
        else
        {
            <div class="absolute inset-0 flex items-center justify-center opacity-20">
                <svg class="w-32 h-32 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
                          d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/>
                </svg>
            </div>
        }

        <!-- Gradient overlay for text readability -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>

        <!-- Three-dots menu (top right) -->
        @if (CanEdit)
        {
            <div class="absolute top-3 right-3 z-10">
                <button @onclick="ToggleMenu"
                        class="p-2 rounded-full bg-black/30 text-white hover:bg-black/50 backdrop-blur-sm transition-colors">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                        <circle cx="12" cy="5" r="1.5"/>
                        <circle cx="12" cy="12" r="1.5"/>
                        <circle cx="12" cy="19" r="1.5"/>
                    </svg>
                </button>
                @if (menuOpen)
                {
                    <div class="fixed inset-0 z-10" @onclick="() => menuOpen = false"></div>
                    <div class="absolute right-0 top-10 z-20 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-600 py-1 min-w-[180px]">
                        <button @onclick="OpenEditModal"
                                class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-2">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                            Edit Trip
                        </button>
                        <label for="coverFileInput"
                               class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700 flex items-center gap-2 cursor-pointer"
                               @onclick="() => menuOpen = false">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            Change Cover Image
                        </label>
                    </div>
                }
            </div>
        }

        <!-- Bottom overlay: back link + trip name + dates -->
        <div class="absolute bottom-0 left-0 right-0 p-5">
            <a href="/" class="inline-flex items-center text-sm text-white/70 hover:text-white mb-2 transition-colors">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
                My Trips
            </a>
            <h1 class="text-2xl sm:text-3xl font-bold text-white drop-shadow-sm">@Trip.Name</h1>
            <p class="text-white/80 text-sm mt-1">
                @Trip.StartDate.ToString("MMM d, yyyy") — @Trip.EndDate.ToString("MMM d, yyyy")
                <span class="ml-2 opacity-70">(@((Trip.EndDate - Trip.StartDate).Days + 1) days)</span>
            </p>
        </div>
    </div>

    <!-- Destinations + Travellers strip below image -->
    @if ((Trip.Destinations?.Count > 0) || (Trip.Travellers?.Count > 0))
    {
        <div class="bg-white dark:bg-gray-800 px-5 py-3 border-t border-gray-100 dark:border-gray-700">
            @if (Trip.Destinations?.Count > 0)
            {
                <div class="flex flex-wrap gap-2 @(Trip.Travellers?.Count > 0 ? "mb-2" : "")">
                    @foreach (var dest in Trip.Destinations)
                    {
                        var mapUrl = GetMapUrl(dest);
                        var tzTooltip = GetTimezoneTooltip(dest);
                        var tooltipId = $"tz-tooltip-{dest.Id}";
                        <a href="@mapUrl" target="_blank" rel="noopener noreferrer"
                           data-tooltip-target="@(string.IsNullOrEmpty(tzTooltip) ? null : tooltipId)"
                           data-tooltip-placement="bottom"
                           class="inline-flex items-center gap-1 px-2.5 py-1 text-sm bg-gray-100 dark:bg-gray-700 rounded-full text-gray-700 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                            📍
                            <span class="font-medium">@dest.DisplayName</span>
                            @if (!string.IsNullOrEmpty(dest.Place?.StateName) || !string.IsNullOrEmpty(dest.Place?.CountryName))
                            {
                                <span class="text-xs text-gray-500 dark:text-gray-400">
                                    @(!string.IsNullOrEmpty(dest.Place?.StateName) ? dest.Place!.StateName + (!string.IsNullOrEmpty(dest.Place?.CountryName) ? ", " : "") : "")@(dest.Place?.CountryName ?? "")
                                </span>
                            }
                        </a>
                        @if (!string.IsNullOrEmpty(tzTooltip))
                        {
                            <div id="@tooltipId" role="tooltip"
                                 class="absolute z-10 invisible inline-block px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip dark:bg-gray-700 whitespace-nowrap">
                                @tzTooltip
                                <div class="tooltip-arrow" data-popper-arrow></div>
                            </div>
                        }
                    }
                </div>
            }
            @if (Trip.Travellers?.Any(t => !t.IsOrganiser) == true)
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var t in Trip.Travellers.Where(t => !t.IsOrganiser))
                    {
                        <div class="flex items-center gap-1.5 bg-gray-100 dark:bg-gray-700 rounded-full pl-1 pr-3 py-1">
                            <UserAvatar Email="@t.TravellerProfile?.Email" Name="@t.TravellerProfile?.LegalName" SizeClass="w-6 h-6" TextClass="text-xs" />
                            <span class="text-sm text-gray-700 dark:text-gray-300">@(t.TravellerProfile?.LegalName ?? "Unknown")</span>
                            @if (t.CanEdit)
                            {
                                <span class="text-xs text-green-600 dark:text-green-400" title="Can edit trip">&#10003;</span>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public required Trip Trip { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnTripUpdated { get; set; }

    private string? userId;
    private bool saving = false;
    private bool menuOpen = false;
    private string? userMapsProvider;
    private string? userTimezone;

    // Edit modal state
    private bool showEditModal = false;
    private string editName = "";
    private string? editDescription;
    private DateTime editStart;
    private DateTime editEnd;
    private decimal? editBudget;
    private string? editCurrency;
    private string? editError;

    // Destinations in edit modal
    private string destSearch = "";
    private List<Place> destResults = [];
    private List<EditDestItem> editDestinations = [];

    // Travellers in edit modal
    private List<TravellerProfile> availableTravellers = [];
    private Dictionary<int, TravellerEditState> editTravellers = [];
    private string travellerSearch = "";
    private List<TravellerProfile> travellerSearchResults = [];
    private int? currentUserProfileId;

    // Cover image
    private string? coverError;

    private string InputClass => "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white";
    private string PrimaryBtnClass => "px-5 py-2.5 text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 rounded-lg";
    private string SecondaryBtnClass => "px-5 py-2.5 text-sm font-medium text-gray-900 bg-white border border-gray-200 hover:bg-gray-100 rounded-lg dark:bg-gray-800 dark:text-white dark:border-gray-600 dark:hover:bg-gray-700";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initFlowbite");
    }

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            availableTravellers = await TravellerService.GetMyProfilesAsync(userId);
            currentUserProfileId = availableTravellers.FirstOrDefault(p => p.LinkedUserId == userId)?.Id;
            var appUser = await UserManager.FindByIdAsync(userId);
            userMapsProvider = appUser?.MapsProvider;
            userTimezone = appUser?.Timezone;
        }
    }

    private void ToggleMenu() => menuOpen = !menuOpen;

    private async Task OpenEditModal()
    {
        menuOpen = false;
        editName = Trip.Name;
        editDescription = Trip.Description;
        editStart = Trip.StartDate;
        editEnd = Trip.EndDate;
        editBudget = Trip.BudgetAmount;
        editCurrency = Trip.BudgetCurrency ?? "";
        editError = null;
        destSearch = "";
        destResults = [];
        travellerSearch = "";
        travellerSearchResults = [];

        editDestinations = Trip.Destinations?.Select(d => new EditDestItem
        {
            ExistingId = d.Id,
            PlaceId = d.PlaceId,
            CustomName = d.CustomName,
            DisplayName = d.DisplayName
        }).ToList() ?? [];

        editTravellers = Trip.Travellers?.ToDictionary(
            t => t.TravellerProfileId,
            t => new TravellerEditState { CanEdit = t.CanEdit && !t.IsOrganiser, IsOrganiser = t.IsOrganiser }
        ) ?? [];

        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        destSearch = "";
        destResults = [];
        travellerSearch = "";
        travellerSearchResults = [];
    }

    private async Task HandleDestInput(ChangeEventArgs e)
    {
        destSearch = e.Value?.ToString() ?? "";
        if (destSearch.Length < 2) { destResults = []; return; }
        destResults = await PlaceService.SearchAsync(destSearch);
    }

    private void AddDestFromPlace(Place place)
    {
        if (!editDestinations.Any(d => d.PlaceId == place.Id && !d.MarkedForRemoval))
            editDestinations.Add(new EditDestItem
            {
                PlaceId = place.Id,
                DisplayName = place.Name + (!string.IsNullOrEmpty(place.CountryName) ? $", {place.CountryName}" : "")
            });
        destSearch = "";
        destResults = [];
    }

    private void AddDestCustom()
    {
        var name = destSearch.Trim();
        if (string.IsNullOrEmpty(name)) return;
        if (!editDestinations.Any(d => d.CustomName == name && !d.MarkedForRemoval))
            editDestinations.Add(new EditDestItem { CustomName = name, DisplayName = name });
        destSearch = "";
        destResults = [];
    }

    private void RemoveEditDest(EditDestItem dest)
    {
        if (dest.ExistingId.HasValue)
            dest.MarkedForRemoval = true;
        else
            editDestinations.Remove(dest);
    }

    private void HandleTravellerSearch(ChangeEventArgs e)
    {
        travellerSearch = e.Value?.ToString() ?? "";
        if (travellerSearch.Length < 1) { travellerSearchResults = []; return; }
        var lower = travellerSearch.ToLowerInvariant();
        travellerSearchResults = availableTravellers
            .Where(p => p.LegalName.ToLowerInvariant().Contains(lower) && !editTravellers.ContainsKey(p.Id))
            .Take(8)
            .ToList();
    }

    private void AddTravellerToEdit(TravellerProfile profile)
    {
        if (!editTravellers.ContainsKey(profile.Id))
            editTravellers[profile.Id] = new TravellerEditState();
        travellerSearch = "";
        travellerSearchResults = [];
    }

    private void RemoveTravellerFromEdit(int profileId) => editTravellers.Remove(profileId);

    private void SetOrganiserFlag(int profileId, bool isOrganiser)
    {
        if (editTravellers.TryGetValue(profileId, out var state))
            state.IsOrganiser = isOrganiser;
    }

    private void SetCanEditFlag(int profileId, bool canEdit)
    {
        if (editTravellers.TryGetValue(profileId, out var state) && !state.IsOrganiser)
            state.CanEdit = canEdit;
    }

    private async Task SaveAll()
    {
        if (string.IsNullOrWhiteSpace(editName)) { editError = "Trip name is required."; return; }
        if (editEnd < editStart) { editError = "End date must be on or after start date."; return; }
        saving = true;
        editError = null;
        try
        {
            Trip.Name = editName.Trim();
            Trip.Description = editDescription?.Trim();
            Trip.StartDate = editStart;
            Trip.EndDate = editEnd;
            Trip.BudgetAmount = editBudget;
            Trip.BudgetCurrency = string.IsNullOrWhiteSpace(editCurrency) ? null : editCurrency.Trim().ToUpper();
            await TripService.UpdateTripAsync(Trip);

            foreach (var d in editDestinations.Where(d => d.MarkedForRemoval && d.ExistingId.HasValue))
                await TripService.RemoveDestinationAsync(d.ExistingId!.Value);
            foreach (var d in editDestinations.Where(d => !d.MarkedForRemoval && !d.ExistingId.HasValue))
            {
                if (d.PlaceId.HasValue)
                    await TripService.AddDestinationAsync(Trip.Id, d.PlaceId.Value);
                else if (!string.IsNullOrEmpty(d.CustomName))
                    await TripService.AddDestinationCustomAsync(Trip.Id, d.CustomName);
            }

            var currentTravellers = Trip.Travellers?.ToList() ?? [];
            foreach (var t in currentTravellers.Where(t =>
                !editTravellers.ContainsKey(t.TravellerProfileId) &&
                t.TravellerProfileId != currentUserProfileId))
                await TripService.RemoveTravellerAsync(t.Id);
            var existingProfileIds = currentTravellers.Select(t => t.TravellerProfileId).ToHashSet();
            foreach (var kv in editTravellers.Where(kv => !existingProfileIds.Contains(kv.Key)))
            {
                var isCurrentUser = kv.Key == currentUserProfileId;
                await TripService.AddTravellerAsync(Trip.Id, kv.Key,
                    isCurrentUser ? true : kv.Value.EffectiveCanEdit,
                    kv.Value.IsOrganiser);
            }
            foreach (var t in currentTravellers.Where(t => editTravellers.ContainsKey(t.TravellerProfileId)))
            {
                var isCurrentUser = t.TravellerProfileId == currentUserProfileId;
                var state = editTravellers[t.TravellerProfileId];
                var newCanEdit = isCurrentUser ? true : state.EffectiveCanEdit;
                if (t.CanEdit != newCanEdit)
                    await TripService.SetTravellerEditAsync(t.Id, newCanEdit);
                if (t.IsOrganiser != state.IsOrganiser)
                    await TripService.SetTravellerOrganiserAsync(t.Id, state.IsOrganiser);
            }

            showEditModal = false;
            await OnTripUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            editError = ex.Message;
        }
        saving = false;
    }

    private async Task HandleCoverUpload(InputFileChangeEventArgs e)
    {
        coverError = null;
        menuOpen = false;
        var file = e.File;
        if (file == null) return;

        if (file.Size > 5_242_880) // 5 MB
        {
            coverError = "Image must be smaller than 5 MB.";
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not (".jpg" or ".jpeg" or ".png" or ".webp" or ".gif"))
        {
            coverError = "Only JPG, PNG, WebP, or GIF images are allowed.";
            return;
        }

        try
        {
            var dir = Path.Combine(WebEnv.WebRootPath, "uploads/trip-covers");
            Directory.CreateDirectory(dir);

            var fileName = $"trip-{Trip.Id}-{Guid.NewGuid():N}{ext}";
            var filePath = Path.Combine(dir, fileName);

            await using var stream = file.OpenReadStream(maxAllowedSize: 5_242_880);
            await using var fs = File.Create(filePath);
            await stream.CopyToAsync(fs);

            // Delete old cover file if it was stored locally
            if (!string.IsNullOrEmpty(Trip.CoverImagePath) && Trip.CoverImagePath.StartsWith("/uploads/trip-covers/"))
            {
                var oldFile = Path.Combine(WebEnv.WebRootPath, Trip.CoverImagePath.TrimStart('/').Replace('/', Path.DirectorySeparatorChar));
                if (File.Exists(oldFile))
                    File.Delete(oldFile);
            }

            Trip.CoverImagePath = $"/uploads/trip-covers/{fileName}";
            await TripService.UpdateTripAsync(Trip);
            await OnTripUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            coverError = $"Failed to upload image: {ex.Message}";
        }
    }

