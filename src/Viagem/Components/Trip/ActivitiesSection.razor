@using Viagem.Services.Interfaces
@using Viagem.Common
@using Viagem.Services.ViewModels
@inject ITripService TripService

<!-- Add / Edit Modal -->
<LumexModal @bind-Open="showModal" OnClose="CloseModal" Size="ModalSize.Large">
    <LumexModalContent Context="modal">
        <LumexModalHeader>
            <h3 class="text-lg font-semibold text-foreground">
                @(editItem != null ? "Edit Activity" : "Add Activity")
            </h3>
        </LumexModalHeader>
        <LumexModalBody>
        @if (showModal)
        {
        <div class="space-y-4">
            <div>
                <LumexTextbox @bind-Value="formName" Label="Name *" Placeholder="City tour, museum, hike..." />
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <LumexDatebox TValue="DateTime" @bind-Value="formStartDate" Label="Start Date/Time *" Type="LumexUI.Common.InputDateType.DateTimeLocal" />
                </div>
                <div>
                    <LumexDatebox TValue="DateTime?" @bind-Value="formEndDate" Label="End Date/Time" Type="LumexUI.Common.InputDateType.DateTimeLocal" />
                </div>
            </div>
            <div>
                <SearchableDropdown TItem="string"
                                    @bind-Value="formTimezone"
                                    Items="AppConstants.Timezones"
                                    Label="Timezone"
                                    Placeholder="— select timezone —" />
            </div>
            <div>
                <LumexTextbox @bind-Value="formAddress" Label="Address / Location" Placeholder="Where is this?" />
            </div>
            <div>
                <LumexTextbox @bind-Value="formDescription" Label="Description" Placeholder="What is this activity?" Multiline="@true" Rows="2" />
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <LumexNumbox TValue="decimal?" @bind-Value="formCostAmount" Label="Cost" Placeholder="0.00" />
                </div>
                <div>
                    <LumexSelect TValue="string" @bind-Value="formCostCurrency" Label="Currency">
                        @foreach (var c in Common.AppConstants.Currencies)
                        {
                            <LumexSelectItem Value="@c.Code">
                                <div class="flex items-center gap-2">
                                    <span class="text-base">@c.Flag</span>
                                    <span class="font-medium">@c.Code</span>
                                    <span class="text-foreground-400 text-xs">@c.Name</span>
                                </div>
                            </LumexSelectItem>
                        }
                    </LumexSelect>
                </div>
            </div>
            <div>
                <LumexTextbox @bind-Value="formLink" Label="Booking Link" Placeholder="https://..." />
            </div>
            <div>
                <LumexTextbox @bind-Value="formNotes" Label="Notes" Multiline="@true" Rows="2" />
            </div>
            @if (TripTravellers.Count > 0)
            {
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-foreground mb-1">Travellers</label>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var t in TripTravellers)
                        {
                            var isSelected = formTravellerIds.Contains(t.TravellerProfileId);
                            <button type="button"
                                    @onclick="() => ToggleTraveller(t.TravellerProfileId)"
                                    class="@(isSelected ? "px-3 py-1 rounded-full text-sm border transition-colors bg-primary text-primary-foreground border-primary" : "px-3 py-1 rounded-full text-sm border transition-colors border-divider text-foreground hover:bg-default-100")">
                                @t.LegalName
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
        }
        </LumexModalBody>
        <LumexModalFooter>
            <div class="flex justify-end gap-3 w-full">
                <LumexButton OnClick="CloseModal">Cancel</LumexButton>
                <LumexButton Color="ThemeColor.Primary" Disabled="@saving" OnClick="SaveItem">
                    @(editItem != null ? "Save Changes" : "Add Activity")
                </LumexButton>
            </div>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>

@if (loading)
{
    <div class="text-center py-6"><LumexSpinner /></div>
}
else
{
    @if (CanEdit)
    {
        <div class="flex justify-end mb-4">
            <LumexButton OnClick="OpenAddModal" Color="@ThemeColor.Primary">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Activity
            </LumexButton>
        </div>
    }

    @if (items.Count == 0)
    {
        <div class="border-2 border-dashed border-divider rounded-lg p-8 text-center">
            <span class="text-4xl block mb-3">🎭</span>
            <p class="text-sm text-foreground-400">No activities planned yet.</p>
        </div>
    }
    else
    {
        <Virtualize Items="GetFlattenedItems()" Context="listItem" OverscanCount="10">
            @if (listItem.GroupDate.HasValue)
            {
                <h5 class="text-sm font-semibold text-foreground-400 uppercase tracking-wide mb-2 mt-5 first:mt-0">
                    @listItem.GroupDate.Value.ToString("dddd, MMMM d")
                </h5>
            }
            else if (listItem.Activity != null)
            {
                var item = listItem.Activity;
                <div class="mb-2 flex items-start justify-between p-3 bg-default-50 rounded-xl border border-divider hover:border-foreground-300 transition-colors">
                            <div class="flex items-start gap-3">
                                <span class="text-2xl mt-0.5">🎯</span>
                                <div>
                                    <div class="flex flex-wrap items-baseline gap-2">
                                        <span class="font-semibold text-foreground text-sm">@item.Name</span>
                                        @{
                                            var tzTip = tzTooltipCache.GetValueOrDefault(item.Id, "");
                                        }
                                        <span class="text-xs text-foreground-400">
                                            @if (!string.IsNullOrEmpty(tzTip))
                                            {
                                                <LumexTooltip Content="@tzTip" Placement="TooltipPlacement.Top">
                                                    <span class="cursor-default underline decoration-dotted decoration-foreground-300">
                                                        @item.StartDate.ToString("HH:mm")
                                                        @(item.EndDate.HasValue ? $" – {item.EndDate.Value.ToString("HH:mm")}" : "")
                                                    </span>
                                                </LumexTooltip>
                                            }
                                            else
                                            {
                                                @item.StartDate.ToString("HH:mm")
                                                @(item.EndDate.HasValue ? $" – {item.EndDate.Value.ToString("HH:mm")}" : "")
                                            }
                                        </span>
                                    </div>
                                    <div class="text-xs text-foreground-400 mt-0.5 flex flex-wrap gap-x-3">
                                        @if (!string.IsNullOrEmpty(item.Address)) { <span>📍 @item.Address</span> }
                                        @if (item.CostAmount.HasValue) { <span class="font-medium text-foreground-500">@item.CostAmount.Value.ToString("N2") @item.CostCurrency</span> }
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <p class="text-xs text-foreground-500 mt-1">@item.Description</p>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <p class="text-xs text-foreground-400 mt-0.5 italic">@item.Notes</p>
                                    }
                                    @if (item.Travellers.Count > 0)
                                    {
                                        <div class="flex flex-wrap gap-1 mt-1">
                                            @foreach (var tv in item.Travellers)
                                            {
                                                <span class="text-xs bg-default-200 text-foreground-500 px-2 py-0.5 rounded-full">@tv.LegalName</span>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                            @if (CanEdit)
                            {
                                <div class="relative ml-2 shrink-0">
                                    <button @onclick="() => menuOpenId = (menuOpenId == item.Id ? null : item.Id)"
                                            class="p-1.5 text-foreground-400 hover:text-foreground-500 rounded-lg hover:bg-default-100">
                                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                            <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                                        </svg>
                                    </button>
                                    @if (menuOpenId == item.Id)
                                    {
                                        <div class="fixed inset-0 z-10" @onclick="() => menuOpenId = null"></div>
                                        <div class="absolute right-0 top-8 z-20 bg-surface1 rounded-lg shadow-lg border border-divider py-1 min-w-[140px]">
                                            @if (!string.IsNullOrEmpty(item.Link))
                                            {
                                                <a href="@item.Link" target="_blank" rel="noopener" class="flex items-center px-4 py-2 text-sm text-foreground-500 hover:bg-default-100">Open link ↗</a>
                                            }
                                            <button @onclick="() => { OpenEditModal(item); menuOpenId = null; }" class="w-full text-left px-4 py-2 text-sm text-foreground-500 hover:bg-default-100">Edit</button>
                                            <button @onclick="async () => { await DeleteItem(item.Id); menuOpenId = null; }" class="w-full text-left px-4 py-2 text-sm text-danger hover:bg-danger-100">Remove</button>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(item.Link))
                            {
                                <a href="@item.Link" target="_blank" rel="noopener" class="text-xs text-primary hover:underline ml-2 shrink-0">Link</a>
                            }
                </div>
            }
        </Virtualize>
    }
}

@code {
    [Parameter] public int TripId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public string? DefaultTimezone { get; set; }
    [Parameter] public IReadOnlyList<TripTravellerViewModel> TripTravellers { get; set; } = [];
    [Parameter] public string? UserTimezone { get; set; }
    [Parameter] public List<ActivityViewModel>? InitialItems { get; set; }
    [Parameter] public string UserCurrency { get; set; } = "USD";
    [Parameter] public EventCallback<ActivityViewModel> OnItemCreated { get; set; }
    [Parameter] public EventCallback<ActivityViewModel> OnItemUpdated { get; set; }
    [Parameter] public EventCallback<Guid> OnItemDeleted { get; set; }
    [Parameter] public string UserId { get; set; } = "";

    private List<ActivityViewModel> items = [];
    private bool loading = true;
    private Guid? menuOpenId;
    private bool saving = false;
    private bool showModal = false;
    private ActivityViewModel? editItem;

    // Form state
    private string formName = "";
    private DateTime formStartDate = DateTime.Today;
    private DateTime? formEndDate;
    private string formTimezone = "";
    private string? formAddress;
    private string? formDescription;
    private string? formNotes;
    private string? formLink;
    private decimal? formCostAmount;
    private string formCostCurrency = "USD";
    private List<int> formTravellerIds = [];

    private record ActivityListItem(DateTime? GroupDate, ActivityViewModel? Activity);

    private List<ActivityListItem> GetFlattenedItems()
    {
        var list = new List<ActivityListItem>();
        foreach (var group in items.OrderBy(i => i.StartDate).GroupBy(i => i.StartDate.Date))
        {
            list.Add(new ActivityListItem(group.Key, null));
            foreach (var item in group.OrderBy(i => i.StartDate))
            {
                list.Add(new ActivityListItem(null, item));
            }
        }
        return list;
    }




    private string? userTimezone;
    private Dictionary<Guid, string> tzTooltipCache = [];
    private bool _needsRender = true;

    protected override bool ShouldRender()
    {
        if (!_needsRender) return false;
        _needsRender = false;
        return true;
    }

    protected override void OnInitialized()
    {
        userTimezone = UserTimezone;
        items = InitialItems ?? [];
        _lastItems = InitialItems;
        loading = false;
        _needsRender = true;
    }

    private List<ActivityViewModel>? _lastItems;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastItems, InitialItems))
        {
            items = InitialItems ?? [];
            _lastItems = InitialItems;
            tzTooltipCache = items.ToDictionary(i => i.Id, i => FormatTimezoneTooltip(i.Timezone));
            _needsRender = true;
        }
    }

    private async Task OpenAddModal()
    {
        editItem = null;
        formName = "";
        formStartDate = DateTime.Today;
        formEndDate = null;
        formTimezone = DefaultTimezone ?? "";
        formAddress = null;
        formDescription = null;
        formNotes = null;
        formLink = null;
        formCostAmount = null;
        formCostCurrency = UserCurrency;
        formTravellerIds = [];
        showModal = true;
        _needsRender = true;
    }

    private void OpenEditModal(ActivityViewModel item)
    {
        editItem = item;
        formName = item.Name;
        formStartDate = item.StartDate;
        formEndDate = item.EndDate;
        formTimezone = item.Timezone ?? "";
        formAddress = item.Address;
        formDescription = item.Description;
        formNotes = item.Notes;
        formLink = item.Link;
        formCostAmount = item.CostAmount;
        formCostCurrency = item.CostCurrency ?? "USD";
        formTravellerIds = item.Travellers.Select(t => t.Id).ToList();
        showModal = true;
        _needsRender = true;
    }

    private void CloseModal() { showModal = false; _needsRender = true; }

    private void ToggleTraveller(int profileId)
    {
        if (formTravellerIds.Contains(profileId))
            formTravellerIds.Remove(profileId);
        else
            formTravellerIds.Add(profileId);
        _needsRender = true;
    }

    private async Task SaveItem()
    {
        if (string.IsNullOrWhiteSpace(formName)) return;
        saving = true;
        if (editItem != null)
        {
            var req = new UpdateActivityRequest(TripId, editItem.Id, formName, formDescription, formAddress, formNotes, formLink, formStartDate, formEndDate, string.IsNullOrEmpty(formTimezone) ? null : formTimezone, formCostAmount, string.IsNullOrEmpty(formCostCurrency) ? null : formCostCurrency, null, formTravellerIds);
            var updated = await TripService.UpdateActivityAsync(UserId, req);
            if (updated != null)
            {
                var idx = items.FindIndex(i => i.Id == updated.Id);
                if (idx >= 0) items[idx] = updated; else items.Add(updated);
                if (OnItemUpdated.HasDelegate) await OnItemUpdated.InvokeAsync(updated);
            }
        }
        else
        {
            var req = new CreateActivityRequest(TripId, formName, formDescription, formAddress, formNotes, formLink, formStartDate, formEndDate, string.IsNullOrEmpty(formTimezone) ? null : formTimezone, formCostAmount, string.IsNullOrEmpty(formCostCurrency) ? null : formCostCurrency, null, formTravellerIds);
            var created = await TripService.AddActivityAsync(UserId, req);
            items.Add(created);
            if (OnItemCreated.HasDelegate) await OnItemCreated.InvokeAsync(created);
        }
        saving = false;
        showModal = false;
        _needsRender = true;
    }

    private async Task DeleteItem(Guid id)
    {
        await TripService.RemoveActivityAsync(UserId, TripId, id);
        items.RemoveAll(i => i.Id == id);
        _needsRender = true;
        if (OnItemDeleted.HasDelegate) await OnItemDeleted.InvokeAsync(id);
    }

    private string FormatTimezoneTooltip(string? timezone)
    {
        if (string.IsNullOrEmpty(timezone)) return "";
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(timezone);
            var now = DateTimeOffset.UtcNow;
            var offset = zone.GetUtcOffset(now);
            if (!string.IsNullOrEmpty(userTimezone))
            {
                try
                {
                    var userZone = TimeZoneInfo.FindSystemTimeZoneById(userTimezone);
                    var diff = offset - userZone.GetUtcOffset(now);
                    if (diff == TimeSpan.Zero)
                        return $"{timezone} (same as your timezone)";
                    var diffStr = diff.Duration().Minutes == 0
                        ? $"{(int)Math.Abs(diff.TotalHours)}h"
                        : $"{Math.Abs(diff.TotalHours):0.#}h";
                    var aheadBehind = diff.TotalHours > 0 ? "ahead of" : "behind";
                    return $"{timezone} (Your timezone is {diffStr} {aheadBehind} this)";
                }
                catch { }
            }
            var offsetSign = offset >= TimeSpan.Zero ? "+" : "-";
            var offsetHrs = offset.Duration().Minutes == 0
                ? $"{offsetSign}{(int)offset.Duration().TotalHours}h"
                : $"{offsetSign}{offset.Duration().TotalHours:0.#}h";
            return $"{timezone} (UTC{offsetHrs})";
        }
        catch { return timezone; }
    }
}