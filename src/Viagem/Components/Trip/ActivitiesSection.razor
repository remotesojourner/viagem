@using ViagemActivity = Viagem.Data.Models.Activity
@inject IActivityService ActivityService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS

<!-- Add / Edit Modal -->
@if (showModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 p-4">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl w-full max-w-xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                    @(editItem != null ? "Edit Activity" : "Add Activity")
                </h3>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name *</label>
                    <input @bind="form.Name" type="text" class="@InputClass" placeholder="City tour, museum, hike..." />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Start Date/Time *</label>
                        <input @bind="form.StartDate" type="datetime-local" class="@InputClass" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">End Date/Time</label>
                        <input @bind="form.EndDate" type="datetime-local" class="@InputClass" />
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Timezone</label>
                    <select @bind="form.Timezone" class="@InputClass">
                        <option value="">— select timezone —</option>
                        @foreach (var tz in TimeZoneConverter.TZConvert.KnownIanaTimeZoneNames)
                        {
                            <option value="@tz">@tz</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Address / Location</label>
                    <input @bind="form.Address" type="text" class="@InputClass" placeholder="Where is this?" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Description</label>
                    <textarea @bind="form.Description" rows="2" class="@InputClass" placeholder="What is this activity?"></textarea>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Cost</label>
                        <input @bind="form.CostAmount" type="number" step="0.01" class="@InputClass" placeholder="0.00" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Currency</label>
                        <Combobox @bind-Value="form.CostCurrency" Placeholder="Select currency..." SearchPlaceholder="Search currencies...">
                            @foreach (var c in Currencies)
                            {
                                <ComboboxItem Value="@c" Label="@c" />
                            }
                        </Combobox>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Booking Link</label>
                    <input @bind="form.Link" type="url" class="@InputClass" placeholder="https://..." />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Notes</label>
                    <textarea @bind="form.Notes" rows="2" class="@InputClass"></textarea>
                </div>
            </div>
            <div class="flex justify-end gap-3 p-6 border-t border-gray-200 dark:border-gray-700">
                <button @onclick="CloseModal" class="@SecondaryBtnClass">Cancel</button>
                <button @onclick="SaveItem" disabled="@saving" class="@PrimaryBtnClass">
                    @(saving ? "Saving..." : (editItem != null ? "Save Changes" : "Add Activity"))
                </button>
            </div>
        </div>
    </div>
}

@if (loading)
{
    <div class="text-center py-6"><div class="animate-spin inline-block rounded-full h-6 w-6 border-b-2 border-blue-700"></div></div>
}
else
{
    @if (CanEdit)
    {
        <div class="flex justify-end mb-4">
            <button @onclick="OpenAddModal"
                    class="inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Activity
            </button>
        </div>
    }

    @if (items.Count == 0)
    {
        <div class="border-2 border-dashed border-gray-200 dark:border-gray-700 rounded-lg p-8 text-center">
            <span class="text-4xl block mb-3">🎭</span>
            <p class="text-sm text-gray-400 dark:text-gray-500">No activities planned yet.</p>
        </div>
    }
    else
    {
        @foreach (var group in items.OrderBy(i => i.StartDate).GroupBy(i => i.StartDate.Date))
        {
            <div class="mb-5">
                <h5 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">
                    @group.Key.ToString("dddd, MMMM d")
                </h5>
                <div class="space-y-2">
                    @foreach (var item in group.OrderBy(i => i.StartDate))
                    {
                        <div class="flex items-start justify-between p-3 bg-gray-50 dark:bg-gray-700 rounded-xl border border-gray-100 dark:border-gray-600 hover:border-gray-300 transition-colors">
                            <div class="flex items-start gap-3">
                                <span class="text-2xl mt-0.5">🎯</span>
                                <div>
                                    <div class="flex flex-wrap items-baseline gap-2">
                                        <span class="font-semibold text-gray-900 dark:text-white text-sm">@item.Name</span>
                                        @{
                                            var tzTipId = $"act-tz-{item.Id}";
                                            var tzTip = FormatTimezoneTooltip(item.Timezone);
                                        }
                                        <span class="text-xs text-gray-500 dark:text-gray-400">
                                            @if (!string.IsNullOrEmpty(tzTip))
                                            {
                                                <span class="relative inline-block">
                                                    <span data-tooltip-target="@tzTipId" data-tooltip-placement="top"
                                                          class="cursor-default underline decoration-dotted decoration-gray-400">
                                                        @item.StartDate.ToString("HH:mm")
                                                        @(item.EndDate.HasValue ? $" – {item.EndDate.Value.ToString("HH:mm")}" : "")
                                                    </span>
                                                    <div id="@tzTipId" role="tooltip"
                                                         class="absolute z-30 invisible inline-block px-2 py-1 text-xs font-medium text-white bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip dark:bg-gray-700 whitespace-nowrap">
                                                        @tzTip
                                                        <div class="tooltip-arrow" data-popper-arrow></div>
                                                    </div>
                                                </span>
                                            }
                                            else
                                            {
                                                @item.StartDate.ToString("HH:mm")
                                                @(item.EndDate.HasValue ? $" – {item.EndDate.Value.ToString("HH:mm")}" : "")
                                            }
                                        </span>
                                    </div>
                                    <div class="text-xs text-gray-500 dark:text-gray-400 mt-0.5 flex flex-wrap gap-x-3">
                                        @if (!string.IsNullOrEmpty(item.Address)) { <span>📍 @item.Address</span> }
                                        @if (item.CostAmount.HasValue) { <span class="font-medium text-gray-700 dark:text-gray-300">@item.CostAmount.Value.ToString("N2") @item.CostCurrency</span> }
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <p class="text-xs text-gray-600 dark:text-gray-400 mt-1">@item.Description</p>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <p class="text-xs text-gray-400 dark:text-gray-500 mt-0.5 italic">@item.Notes</p>
                                    }
                                </div>
                            </div>
                            @if (CanEdit)
                            {
                                <div class="relative ml-2 shrink-0">
                                    <button @onclick="() => menuOpenId = (menuOpenId == item.Id ? null : item.Id)"
                                            class="p-1.5 text-gray-400 hover:text-gray-600 dark:hover:text-gray-200 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-600">
                                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                            <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                                        </svg>
                                    </button>
                                    @if (menuOpenId == item.Id)
                                    {
                                        <div class="fixed inset-0 z-10" @onclick="() => menuOpenId = null"></div>
                                        <div class="absolute right-0 top-8 z-20 bg-white dark:bg-gray-800 rounded-lg shadow-lg border border-gray-200 dark:border-gray-600 py-1 min-w-[140px]">
                                            @if (!string.IsNullOrEmpty(item.Link))
                                            {
                                                <a href="@item.Link" target="_blank" rel="noopener" class="flex items-center px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">Open link ↗</a>
                                            }
                                            <button @onclick="() => { OpenEditModal(item); menuOpenId = null; }" class="w-full text-left px-4 py-2 text-sm text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">Edit</button>
                                            <button @onclick="async () => { await DeleteItem(item.Id); menuOpenId = null; }" class="w-full text-left px-4 py-2 text-sm text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20">Remove</button>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(item.Link))
                            {
                                <a href="@item.Link" target="_blank" rel="noopener" class="text-xs text-blue-600 hover:underline dark:text-blue-400 ml-2 shrink-0">Link</a>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    }
}

@code {
    [Parameter] public int TripId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public string? DefaultTimezone { get; set; }

    private List<ViagemActivity> items = [];
    private bool loading = true;
    private int? menuOpenId;
    private bool saving = false;
    private bool showModal = false;
    private ViagemActivity? editItem;
    private ViagemActivity form = new() { Name = "" };

    private string InputClass => "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white";
    private string PrimaryBtnClass => "px-5 py-2.5 text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 rounded-lg dark:bg-blue-600 dark:hover:bg-blue-700";
    private string SecondaryBtnClass => "px-5 py-2.5 text-sm font-medium text-gray-900 bg-white border border-gray-200 hover:bg-gray-100 rounded-lg dark:bg-gray-800 dark:text-white dark:border-gray-600";

    private static readonly string[] Currencies = ["AED","AUD","BRL","CAD","CHF","CNY","CZK","DKK","EUR","GBP","HKD","HUF","IDR","ILS","INR","JPY","KRW","MXN","MYR","NOK","NZD","PHP","PLN","RON","RUB","SAR","SEK","SGD","THB","TRY","TWD","UAH","USD","VND","ZAR"];

    private string? userTimezone;

    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var user = await UserManager.FindByIdAsync(userId);
            userTimezone = user?.Timezone;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("initFlowbite");
    }

    private async Task LoadItems()
    {
        loading = true;
        items = await ActivityService.GetTripActivitiesAsync(TripId);
        loading = false;
    }

    private async Task<string> GetUserCurrencyAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (!string.IsNullOrEmpty(user?.CurrencyCode)) return user.CurrencyCode;
        }
        return "USD";
    }

    private async Task OpenAddModal()
    {
        editItem = null;
        var currency = await GetUserCurrencyAsync();
        form = new ViagemActivity { Name = "", TripId = TripId, StartDate = DateTime.Today, CostCurrency = currency, Timezone = DefaultTimezone ?? "" };
        showModal = true;
    }

    private void OpenEditModal(ViagemActivity item)
    {
        editItem = item;
        form = new ViagemActivity
        {
            Id = item.Id, TripId = item.TripId, Name = item.Name,
            StartDate = item.StartDate, EndDate = item.EndDate,
            Timezone = item.Timezone,
            Address = item.Address, Description = item.Description,
            Notes = item.Notes, Link = item.Link,
            CostAmount = item.CostAmount, CostCurrency = item.CostCurrency
        };
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task SaveItem()
    {
        if (string.IsNullOrWhiteSpace(form.Name)) return;
        saving = true;
        form.TripId = TripId;
        if (editItem != null) await ActivityService.UpdateAsync(form);
        else await ActivityService.CreateAsync(form);
        saving = false;
        showModal = false;
        await LoadItems();
    }

    private async Task DeleteItem(int id)
    {
        await ActivityService.DeleteAsync(id);
        await LoadItems();
    }

    private string FormatTimezoneTooltip(string? timezone)
    {
        if (string.IsNullOrEmpty(timezone)) return "";
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(timezone);
            var now = DateTimeOffset.UtcNow;
            var offset = zone.GetUtcOffset(now);
            if (!string.IsNullOrEmpty(userTimezone))
            {
                try
                {
                    var userZone = TimeZoneInfo.FindSystemTimeZoneById(userTimezone);
                    var diff = offset - userZone.GetUtcOffset(now);
                    if (diff == TimeSpan.Zero)
                        return $"{timezone} (same as your timezone)";
                    var diffStr = diff.Duration().Minutes == 0
                        ? $"{(int)Math.Abs(diff.TotalHours)}h"
                        : $"{Math.Abs(diff.TotalHours):0.#}h";
                    var aheadBehind = diff.TotalHours > 0 ? "ahead of" : "behind";
                    return $"{timezone} (Your timezone is {diffStr} {aheadBehind} this)";
                }
                catch { }
            }
            var offsetSign = offset >= TimeSpan.Zero ? "+" : "-";
            var offsetHrs = offset.Duration().Minutes == 0
                ? $"{offsetSign}{(int)offset.Duration().TotalHours}h"
                : $"{offsetSign}{offset.Duration().TotalHours:0.#}h";
            return $"{timezone} (UTC{offsetHrs})";
        }
        catch { return timezone; }
    }
}