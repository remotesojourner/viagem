@using Viagem.Services.Interfaces
@using Viagem.Services.ViewModels
@inject ITripService TripService
@inject AuthenticationStateProvider AuthStateProvider

<div class="relative group bg-surface1 rounded-xl border border-divider overflow-hidden shadow-sm hover:shadow-md transition-shadow duration-200">


    <a href="/trips/@Trip.Id" class="absolute inset-0 z-0" aria-label="View @Trip.Name"></a>


    <div class="h-36 relative overflow-hidden bg-gradient-to-br from-blue-600 to-indigo-700 pointer-events-none">
        @if (!string.IsNullOrEmpty(Trip.CoverImagePath))
        {
            <img src="@Trip.CoverImagePath" alt="@Trip.Name" class="absolute inset-0 w-full h-full object-cover" />
        }
        else
        {
            <svg class="absolute inset-0 m-auto w-12 h-12 text-white opacity-20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
        }
        <div class="absolute bottom-2 left-2 bg-black/50 text-white text-xs px-2 py-1 rounded-md">
            @Trip.StartDate.ToString("MMM d") – @Trip.EndDate.ToString("MMM d, yyyy")
        </div>
    </div>


    <div class="p-4 flex items-start gap-2">
        <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-foreground line-clamp-2">@Trip.Name</p>
            @if (Trip.Destinations.Count > 0)
            {
                <p class="text-xs text-foreground-400 mt-1 flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span class="truncate">@string.Join(", ", Trip.Destinations.Select(d => d.PlaceName ?? d.CustomName ?? "?"))</span>
                </p>
            }
        </div>
        <button @onclick="ShowDeleteModal" @onclick:stopPropagation
                class="relative z-10 shrink-0 p-1.5 rounded-lg text-foreground-300 hover:text-danger hover:bg-danger-50 transition-colors"
                title="Delete trip">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
        </button>
    </div>
</div>


<LumexModal @bind-Open="showDeleteModal" OnClose="() => showDeleteModal = false">
    <LumexModalContent Context="modal">
        <LumexModalHeader>Delete Trip</LumexModalHeader>
        <LumexModalBody>
            <p class="text-sm text-foreground-500">Are you sure you want to delete <strong class="text-foreground">@Trip.Name</strong>? This action cannot be undone.</p>
        </LumexModalBody>
        <LumexModalFooter>
            <LumexButton OnClick="() => showDeleteModal = false">Cancel</LumexButton>
            <LumexButton Color="ThemeColor.Danger" OnClick="ConfirmDelete" Disabled="@deleting">Delete</LumexButton>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>

@code {
    [Parameter] public required TripSummaryViewModel Trip { get; set; }
    [Parameter] public EventCallback OnDeleted { get; set; }

    private bool showDeleteModal;
    private bool deleting;



    private void ShowDeleteModal() => showDeleteModal = true;

    private async Task ConfirmDelete()
    {
        deleting = true;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            await TripService.DeleteTripAsync(Trip.Id, userId);
            await OnDeleted.InvokeAsync();
        }
        showDeleteModal = false;
        deleting = false;
    }
}
