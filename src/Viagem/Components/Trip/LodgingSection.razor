@using Viagem.Services.Interfaces
@using Viagem.Services.ViewModels
@inject ILodgingService LodgingService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<!-- Add / Edit Modal -->
<LumexModal @bind-Open="showModal" OnClose="CloseModal">
    <LumexModalContent Context="modal">
        <LumexModalHeader>
            <h3 class="text-lg font-semibold text-foreground">
                @(editItem != null ? "Edit Lodging" : "Add Lodging")
            </h3>
        </LumexModalHeader>
        <LumexModalBody>
        <div class="grid grid-cols-2 gap-4">
            <div class="col-span-2">
                <LumexTextbox @bind-Value="formName" Label="Name *" Placeholder="Hotel name, Airbnb, etc." />
            </div>
            <div>
                <LumexSelect TValue="LodgingType" @bind-Value="formType" Label="Type">
                    @foreach (var t in Enum.GetValues<LodgingType>())
                    {
                        <LumexSelectItem Value="@t">@GetTypeLabel(t)</LumexSelectItem>
                    }
                </LumexSelect>
            </div>
            <div>
                <LumexTextbox @bind-Value="formConfirmationCode" Label="Confirmation Code" />
            </div>
            <div>
                <LumexDatebox TValue="DateTime" @bind-Value="formStartDate" Label="Check-in *" Type="LumexUI.Common.InputDateType.DateTimeLocal" />
            </div>
            <div>
                <LumexDatebox TValue="DateTime" @bind-Value="formEndDate" Label="Check-out *" Type="LumexUI.Common.InputDateType.DateTimeLocal" />
            </div>
            <div class="col-span-2">
                <LumexSelect TValue="string" @bind-Value="formTimezone" Label="Timezone" Placeholder="— select timezone —">
                    @foreach (var tz in TimeZoneConverter.TZConvert.KnownIanaTimeZoneNames)
                    {
                        <LumexSelectItem Value="@tz">@tz</LumexSelectItem>
                    }
                </LumexSelect>
            </div>
            <div class="col-span-2">
                <LumexTextbox @bind-Value="formAddress" Label="Address" Placeholder="Street address" />
            </div>
            <div>
                <LumexNumbox TValue="decimal?" @bind-Value="formCostAmount" Label="Cost" Placeholder="0.00" />
            </div>
            <div>
                <LumexSelect TValue="string" @bind-Value="formCostCurrency" Label="Currency">
                    @foreach (var c in Currencies)
                    {
                        <LumexSelectItem Value="@c">@c</LumexSelectItem>
                    }
                </LumexSelect>
            </div>
            <div class="col-span-2">
                <LumexTextbox @bind-Value="formLink" Label="Booking Link" Placeholder="https://..." />
            </div>
            <div class="col-span-2">
                <LumexTextbox @bind-Value="formNotes" Label="Notes" Multiline="@true" Rows="2" />
            </div>
            @if (TripTravellers.Count > 0)
            {
                <div class="col-span-2">
                    <label class="block text-sm font-medium text-foreground mb-1">Travellers</label>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var t in TripTravellers)
                        {
                            var isSelected = formTravellerIds.Contains(t.TravellerProfileId);
                            <button type="button"
                                    @onclick="() => ToggleTraveller(t.TravellerProfileId)"
                                    class="@(isSelected ? "px-3 py-1 rounded-full text-sm border transition-colors bg-primary text-primary-foreground border-primary" : "px-3 py-1 rounded-full text-sm border transition-colors border-divider text-foreground hover:bg-default-100")">
                                @t.LegalName
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
        </LumexModalBody>
        <LumexModalFooter>
            <div class="flex justify-end gap-3 w-full">
                <LumexButton OnClick="CloseModal">Cancel</LumexButton>
                <LumexButton Color="ThemeColor.Primary" Disabled="@saving" OnClick="SaveItem">
                    @(editItem != null ? "Save Changes" : "Add")
                </LumexButton>
            </div>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>

@if (loading)
{
    <div class="text-center py-6"><LumexSpinner /></div>
}
else
{
    @if (CanEdit)
    {
        <div class="flex justify-end mb-4">
            <LumexButton OnClick="OpenAddModal" Color="@ThemeColor.Primary">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Lodging
            </LumexButton>
        </div>
    }

    @if (items.Count == 0)
    {
        <div class="border-2 border-dashed border-divider rounded-lg p-8 text-center">
            <span class="text-4xl block mb-3">🏨</span>
            <p class="text-sm text-foreground-400">No lodging booked yet.</p>
        </div>
    }
    else
    {
        <div class="space-y-2">
            @foreach (var item in items.OrderBy(i => i.StartDate))
            {
                <div class="flex items-start justify-between p-3 bg-default-50 rounded-xl border border-divider hover:border-foreground-300 transition-colors">
                    <div class="flex items-start gap-3">
                        <span class="text-2xl mt-0.5">@GetIcon(item.Type)</span>
                        <div>
                            <div class="flex flex-wrap items-baseline gap-2">
                                <span class="font-semibold text-foreground text-sm">@item.Name</span>
                                <span class="text-xs text-foreground-400">@GetTypeLabel(item.Type)</span>
                                @if (!string.IsNullOrEmpty(item.ConfirmationCode))
                                {
                                    <span class="text-xs font-mono bg-default-200 text-foreground-500 px-1.5 py-0.5 rounded">@item.ConfirmationCode</span>
                                }
                            </div>
                            <div class="text-xs text-foreground-400 mt-0.5 flex flex-wrap items-center gap-x-2">
                                @{
                                    var tzTip = FormatTimezoneTooltip(item.Timezone);
                                }
                                @if (!string.IsNullOrEmpty(tzTip))
                                {
                                    <LumexTooltip Content="@tzTip" Placement="TooltipPlacement.Top">
                                        <span class="cursor-default underline decoration-dotted decoration-foreground-300">
                                            @item.StartDate.ToString("MMM d, HH:mm") — @item.EndDate.ToString("MMM d, HH:mm yyyy")
                                        </span>
                                    </LumexTooltip>
                                }
                                else
                                {
                                    <span>@item.StartDate.ToString("MMM d, HH:mm") — @item.EndDate.ToString("MMM d, HH:mm yyyy")</span>
                                }
                                <span>(@((item.EndDate.Date - item.StartDate.Date).Days) nights)</span>
                                @if (!string.IsNullOrEmpty(item.Address)) { <span>📍 @item.Address</span> }
                                @if (item.CostAmount.HasValue) { <span class="font-medium text-foreground-500">@item.CostAmount.Value.ToString("N2") @item.CostCurrency</span> }
                            </div>
                            @if (!string.IsNullOrEmpty(item.Notes))
                            {
                                <p class="text-xs text-foreground-400 mt-1 italic">@item.Notes</p>
                            }
                            @if (item.Travellers.Count > 0)
                            {
                                <div class="flex flex-wrap gap-1 mt-1">
                                    @foreach (var tv in item.Travellers)
                                    {
                                        <span class="text-xs bg-default-200 text-foreground-500 px-2 py-0.5 rounded-full">@tv.LegalName</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                    @if (CanEdit)
                    {
                        <div class="relative ml-2 shrink-0">
                            <button @onclick="() => menuOpenId = (menuOpenId == item.Id ? null : item.Id)"
                                    class="p-1.5 text-foreground-400 hover:text-foreground-500 rounded-lg hover:bg-default-100">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                    <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                                </svg>
                            </button>
                            @if (menuOpenId == item.Id)
                            {
                                <div class="fixed inset-0 z-10" @onclick="() => menuOpenId = null"></div>
                                <div class="absolute right-0 top-8 z-20 bg-surface1 rounded-lg shadow-lg border border-divider py-1 min-w-[140px]">
                                    @if (!string.IsNullOrEmpty(item.Link))
                                    {
                                        <a href="@item.Link" target="_blank" rel="noopener" class="flex items-center px-4 py-2 text-sm text-foreground-500 hover:bg-default-100">Open link ↗</a>
                                    }
                                    <button @onclick="() => { OpenEditModal(item); menuOpenId = null; }" class="w-full text-left px-4 py-2 text-sm text-foreground-500 hover:bg-default-100">Edit</button>
                                    <button @onclick="async () => { await DeleteItem(item.Id); menuOpenId = null; }" class="w-full text-left px-4 py-2 text-sm text-danger hover:bg-danger-100">Remove</button>
                                </div>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(item.Link))
                    {
                        <a href="@item.Link" target="_blank" rel="noopener" class="text-xs text-primary hover:underline ml-2 shrink-0">Link</a>
                    }
                </div>
            }
        </div>
    }
}

@code {
    [Parameter] public int TripId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public string? DefaultTimezone { get; set; }
    [Parameter] public IReadOnlyList<TripTravellerViewModel> TripTravellers { get; set; } = [];

    private List<LodgingViewModel> items = [];
    private bool loading = true;
    private int? menuOpenId;
    private bool saving = false;
    private bool showModal = false;
    private LodgingViewModel? editItem;

    // Form state
    private string formName = "";
    private LodgingType formType = LodgingType.Hotel;
    private string? formConfirmationCode;
    private DateTime formStartDate = DateTime.Today;
    private DateTime formEndDate = DateTime.Today.AddDays(1);
    private string formTimezone = "";
    private string? formAddress;
    private string? formNotes;
    private string? formLink;
    private decimal? formCostAmount;
    private string formCostCurrency = "USD";
    private List<int> formTravellerIds = [];

    private static readonly string[] Currencies = ["AED","AUD","BRL","CAD","CHF","CNY","CZK","DKK","EUR","GBP","HKD","HUF","IDR","ILS","INR","JPY","KRW","MXN","MYR","NOK","NZD","PHP","PLN","RON","RUB","SAR","SEK","SGD","THB","TRY","TWD","UAH","USD","VND","ZAR"];

    private string? userTimezone;


    protected override async Task OnInitializedAsync()
    {
        await LoadItems();
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var user = await UserManager.FindByIdAsync(userId);
            userTimezone = user?.Timezone;
        }
    }

    private async Task LoadItems()
    {
        loading = true;
        items = await LodgingService.GetTripLodgingsAsync(TripId);
        loading = false;
    }

    private async Task<string> GetUserCurrencyAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (!string.IsNullOrEmpty(user?.CurrencyCode)) return user.CurrencyCode;
        }
        return "USD";
    }

    private async Task OpenAddModal()
    {
        editItem = null;
        formName = "";
        formType = LodgingType.Hotel;
        formConfirmationCode = null;
        formStartDate = DateTime.Today;
        formEndDate = DateTime.Today.AddDays(1);
        formTimezone = DefaultTimezone ?? "";
        formAddress = null;
        formNotes = null;
        formLink = null;
        formCostAmount = null;
        formCostCurrency = await GetUserCurrencyAsync();
        formTravellerIds = [];
        showModal = true;
    }

    private void OpenEditModal(LodgingViewModel item)
    {
        editItem = item;
        formName = item.Name;
        formType = item.Type;
        formConfirmationCode = item.ConfirmationCode;
        formStartDate = item.StartDate;
        formEndDate = item.EndDate;
        formTimezone = item.Timezone ?? "";
        formAddress = item.Address;
        formNotes = item.Notes;
        formLink = item.Link;
        formCostAmount = item.CostAmount;
        formCostCurrency = item.CostCurrency ?? "USD";
        formTravellerIds = item.Travellers.Select(t => t.Id).ToList();
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private void ToggleTraveller(int profileId)
    {
        if (formTravellerIds.Contains(profileId))
            formTravellerIds.Remove(profileId);
        else
            formTravellerIds.Add(profileId);
    }

    private async Task SaveItem()
    {
        if (string.IsNullOrWhiteSpace(formName)) return;
        saving = true;
        if (editItem != null)
            await LodgingService.UpdateAsync(new UpdateLodgingRequest(editItem.Id, formType, formName, formAddress, formConfirmationCode, formNotes, formLink, formStartDate, formEndDate, string.IsNullOrEmpty(formTimezone) ? null : formTimezone, formCostAmount, string.IsNullOrEmpty(formCostCurrency) ? null : formCostCurrency, null, formTravellerIds));
        else
            await LodgingService.CreateAsync(new CreateLodgingRequest(TripId, formType, formName, formAddress, formConfirmationCode, formNotes, formLink, formStartDate, formEndDate, string.IsNullOrEmpty(formTimezone) ? null : formTimezone, formCostAmount, string.IsNullOrEmpty(formCostCurrency) ? null : formCostCurrency, null, formTravellerIds));
        saving = false;
        showModal = false;
        await LoadItems();
    }

    private async Task DeleteItem(int id)
    {
        await LodgingService.DeleteAsync(id);
        await LoadItems();
    }

    private static string GetTypeLabel(LodgingType type) => type switch
    {
        LodgingType.Hotel => "Hotel",
        LodgingType.Hostel => "Hostel",
        LodgingType.Home => "Home",
        LodgingType.VacationRental => "Vacation Rental",
        LodgingType.CampSite => "Campsite",
        _ => "Other"
    };

    private static string GetIcon(LodgingType type) => type switch
    {
        LodgingType.Hotel => "🏨",
        LodgingType.Hostel => "🛏️",
        LodgingType.Home => "🏠",
        LodgingType.VacationRental => "🏡",
        LodgingType.CampSite => "⛺",
        _ => "🏩"
    };

    private string FormatTimezoneTooltip(string? timezone)
    {
        if (string.IsNullOrEmpty(timezone)) return "";
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(timezone);
            var now = DateTimeOffset.UtcNow;
            var offset = zone.GetUtcOffset(now);
            if (!string.IsNullOrEmpty(userTimezone))
            {
                try
                {
                    var userZone = TimeZoneInfo.FindSystemTimeZoneById(userTimezone);
                    var diff = offset - userZone.GetUtcOffset(now);
                    if (diff == TimeSpan.Zero)
                        return $"{timezone} (same as your timezone)";
                    var totalHours = diff.TotalHours;
                    var diffStr = diff.Duration().Minutes == 0
                        ? $"{(int)Math.Abs(diff.TotalHours)}h"
                        : $"{Math.Abs(diff.TotalHours):0.#}h";
                    var aheadBehind = totalHours > 0 ? "ahead of" : "behind";
                    return $"{timezone} (Your timezone is {diffStr} {aheadBehind} this)";
                }
                catch { }
            }
            var offsetSign = offset >= TimeSpan.Zero ? "+" : "-";
            var offsetHrs = offset.Duration().Minutes == 0
                ? $"{offsetSign}{(int)offset.Duration().TotalHours}h"
                : $"{offsetSign}{offset.Duration().TotalHours:0.#}h";
            return $"{timezone} (UTC{offsetHrs})";
        }
        catch { return timezone; }
    }
}
