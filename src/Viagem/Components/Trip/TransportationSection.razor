@inject ITripService TripService
@inject IAirportService AirportService
@inject IAirlineService AirlineService
@inject IFlightRouteService FlightRouteService
@using Viagem.Services.Interfaces
@using Viagem.Services.ViewModels

<!-- Add / Edit modal -->
<TransportationModal @bind-IsOpen="showModal" EditItem="editItem" TripId="TripId" UserId="@UserId" DefaultTimezone="DefaultTimezone" UserCurrency="UserCurrency" TripTravellers="TripTravellers" OnItemSaved="HandleItemSaved" />

<!-- Section body -->
@if (loading)
{
    <div class="text-center py-6"><LumexSpinner /></div>
}
else
{
    @if (CanEdit)
    {
        <div class="flex justify-end mb-4">
            <LumexButton OnClick="OpenAddModal" Color="@ThemeColor.Primary">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Transportation
            </LumexButton>
        </div>
    }

    @if (items.Count == 0)
    {
        <div class="border-2 border-dashed border-divider rounded-lg p-8 text-center">
            <span class="text-4xl block mb-3">✈️</span>
            <p class="text-sm text-foreground-400">No transportation booked yet.</p>
        </div>
    }
    else
    {
        @if (tickets.Count > 0)
        {
            <h5 class="text-sm font-semibold text-foreground-400 uppercase tracking-wide mb-2">Tickets &amp; Rides</h5>
            <div class="space-y-2 mb-4">
                <Virtualize Items="tickets" Context="item" OverscanCount="5">
                    <TransportationCard Item="item" CanEdit="CanEdit" UserTimezone="userTimezone" OnEdit="() => OpenEditModal(item)" OnDelete="() => DeleteItem(item.Id)" />
                </Virtualize>
            </div>
        }
        @if (rentals.Count > 0)
        {
            <h5 class="text-sm font-semibold text-foreground-400 uppercase tracking-wide mb-2">Car Rentals</h5>
            <div class="space-y-2 mb-4">
                <Virtualize Items="rentals" Context="item" OverscanCount="5">
                    <TransportationCard Item="item" CanEdit="CanEdit" UserTimezone="userTimezone" OnEdit="() => OpenEditModal(item)" OnDelete="() => DeleteItem(item.Id)" />
                </Virtualize>
            </div>
        }
        @if (parkings.Count > 0)
        {
            <h5 class="text-sm font-semibold text-foreground-400 uppercase tracking-wide mb-2">Parking</h5>
            <div class="space-y-2">
                <Virtualize Items="parkings" Context="item" OverscanCount="5">
                    <TransportationCard Item="item" CanEdit="CanEdit" UserTimezone="userTimezone" OnEdit="() => OpenEditModal(item)" OnDelete="() => DeleteItem(item.Id)" />
                </Virtualize>
            </div>
        }
    }
}

@code {
    [Parameter] public int TripId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public string? DefaultTimezone { get; set; }
    [Parameter] public IReadOnlyList<TripTravellerViewModel> TripTravellers { get; set; } = [];
    [Parameter] public string? UserTimezone { get; set; }
    [Parameter] public List<TransportationViewModel>? InitialItems { get; set; }
    [Parameter] public string UserCurrency { get; set; } = "USD";
    [Parameter] public EventCallback<TransportationViewModel> OnItemCreated { get; set; }
    [Parameter] public EventCallback<TransportationViewModel> OnItemUpdated { get; set; }
    [Parameter] public EventCallback<Guid> OnItemDeleted { get; set; }
    [Parameter] public string UserId { get; set; } = "";

    private List<TransportationViewModel> items = [];
    private List<TransportationViewModel> tickets => items.Where(i => i.Type != TransportationType.CarRental && i.Type != TransportationType.Parking).OrderBy(i => i.DepartureTime).ToList();
    private List<TransportationViewModel> rentals => items.Where(i => i.Type == TransportationType.CarRental).OrderBy(i => i.DepartureTime).ToList();
    private List<TransportationViewModel> parkings => items.Where(i => i.Type == TransportationType.Parking).OrderBy(i => i.DepartureTime).ToList();

    private bool loading = true;
    private bool showModal = false;
    private TransportationViewModel? editItem;
    private List<TransportationViewModel>? _lastInitialItems;

    protected override void OnInitialized()
    {
        userTimezone = UserTimezone;
        items = InitialItems ?? [];
        _lastInitialItems = InitialItems;
        loading = false;
        _needsRender = true;
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastInitialItems, InitialItems))
        {
            items = InitialItems ?? [];
            _lastInitialItems = InitialItems;
            _needsRender = true;
        }
    }

    private bool _needsRender = true;
    private string? userTimezone;

    protected override bool ShouldRender()
    {
        if (!_needsRender) return false;
        _needsRender = false;
        return true;
    }

    private void OpenAddModal()
    {
        editItem = null;
        showModal = true;
        _needsRender = true;
    }

    private void OpenEditModal(TransportationViewModel item)
    {
        editItem = item;
        showModal = true;
        _needsRender = true;
    }

    private async Task HandleItemSaved(TransportationViewModel item)
    {
        var idx = items.FindIndex(i => i.Id == item.Id);
        if (idx >= 0)
        {
            items[idx] = item;
            if (OnItemUpdated.HasDelegate) await OnItemUpdated.InvokeAsync(item);
        }
        else
        {
            items.Add(item);
            if (OnItemCreated.HasDelegate) await OnItemCreated.InvokeAsync(item);
        }
        _needsRender = true;
    }

    private async Task DeleteItem(Guid id)
    {
        await TripService.RemoveTransportationAsync(UserId, TripId, id);
        items.RemoveAll(i => i.Id == id);
        _needsRender = true;
        if (OnItemDeleted.HasDelegate) await OnItemDeleted.InvokeAsync(id);
    }
}
