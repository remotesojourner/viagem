@inject ITransportationService TransportationService
@inject IAirportService AirportService
@inject IAirlineService AirlineService
@inject IFlightRouteService FlightRouteService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager
@using GeoTimeZone
@using Viagem.Services.Interfaces

<!-- Add / Edit modal -->
@if (showModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 p-4">
        <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between p-6 border-b border-gray-200 dark:border-gray-700">
                <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
                    @(editItem != null ? "Edit Transportation" : "Add Transportation")
                </h3>
                <button @onclick="CloseModal" class="text-gray-400 hover:text-gray-600">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="p-6 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div class="col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Type *</label>
                        <Combobox Value="@form.Type.ToString()"
                                  ValueChanged="@(v => { if (Enum.TryParse<TransportationType>(v, out var t)) form.Type = t; })"
                                  Placeholder="Select type...">
                            @foreach (var t in Enum.GetValues<TransportationType>())
                            {
                                <ComboboxItem Value="@t.ToString()" Label="@GetTypeLabel(t)" />
                            }
                        </Combobox>
                    </div>

                    @if (form.Type == TransportationType.CarRental)
                    {
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Rental Company</label>
                            <input @bind="form.RentalCompany" type="text" class="@InputClass" placeholder="Hertz, Enterprise..." />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Confirmation Code</label>
                            <input @bind="form.ConfirmationCode" type="text" class="@InputClass" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Pick-up Location</label>
                            <input @bind="form.PickupLocation" type="text" class="@InputClass" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Drop-off Location</label>
                            <input @bind="form.DropOffLocation" type="text" class="@InputClass" />
                        </div>
                    }
                    else if (form.Type == TransportationType.Parking)
                    {
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Parking Address</label>
                            <input @bind="form.ParkingAddress" type="text" class="@InputClass" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Spot / Level</label>
                            <input @bind="form.SpotNumber" type="text" class="@InputClass" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Confirmation Code</label>
                            <input @bind="form.ConfirmationCode" type="text" class="@InputClass" />
                        </div>
                    }
                    else
                    {
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                                @(form.Type == TransportationType.Flight ? "Airline" : "Operator / Provider")
                            </label>
                            <input @bind="form.Provider" type="text" class="@InputClass"
                                   placeholder="@(form.Type == TransportationType.Flight ? "Auto-filled from flight number" : "Provider name")" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
                                @(form.Type == TransportationType.Flight ? "Flight Number" : "Reference / Ticket No.")
                            </label>
                            <input value="@form.FlightNumber"
                                   @oninput="e => form.FlightNumber = e.Value?.ToString() ?? string.Empty"
                                   @onblur="LookupFlightRoute"
                                   type="text" class="@InputClass"
                                   placeholder="@(form.Type == TransportationType.Flight ? "BA123" : "Optional")" />
                        </div>
                        @if (form.Type == TransportationType.Flight)
                        {
                            @* Flight: separate city + airport for origin *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Origin City</label>
                                <input @bind="form.OriginCity" type="text" class="@InputClass" placeholder="e.g. London" />
                            </div>
                            <div class="relative">
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Origin Airport</label>
                                <input type="text" value="@originSearch"
                                       @oninput="HandleOriginInput" @onfocus="() => showOriginDropdown = originResults.Count > 0"
                                       @onfocusout="() => showOriginDropdown = false"
                                       class="@InputClass" placeholder="IATA code or airport name" autocomplete="off" />
                                @if (showOriginDropdown && originResults.Count > 0)
                                {
                                    <div class="absolute z-20 w-full bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg shadow-lg max-h-48 overflow-y-auto mt-1">
                                        @foreach (var a in originResults)
                                        {
                                            <div @onmousedown='() => SelectOriginAsync(a)'
                                                 class="px-3 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 cursor-pointer text-sm text-gray-900 dark:text-white">
                                                <span class="font-mono font-semibold text-blue-600 dark:text-blue-400">@a.IataCode</span>
                                                — @a.Name
                                                @if (!string.IsNullOrEmpty(a.Municipality))
                                                {
                                                    <span class="text-gray-500 dark:text-gray-400 ml-1">(@a.Municipality, @a.IsoCountry)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            @* Flight: separate city + airport for destination *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Destination City</label>
                                <input @bind="form.DestinationCity" type="text" class="@InputClass" placeholder="e.g. Paris" />
                            </div>
                            <div class="relative">
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Destination Airport</label>
                                <input type="text" value="@destinationSearch"
                                       @oninput="HandleDestinationInput" @onfocus="() => showDestinationDropdown = destinationResults.Count > 0"
                                       @onfocusout="() => showDestinationDropdown = false"
                                       class="@InputClass" placeholder="IATA code or airport name" autocomplete="off" />
                                @if (showDestinationDropdown && destinationResults.Count > 0)
                                {
                                    <div class="absolute z-20 w-full bg-white dark:bg-gray-700 border border-gray-200 dark:border-gray-600 rounded-lg shadow-lg max-h-48 overflow-y-auto mt-1">
                                        @foreach (var a in destinationResults)
                                        {
                                            <div @onmousedown='() => SelectDestinationAsync(a)'
                                                 class="px-3 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 cursor-pointer text-sm text-gray-900 dark:text-white">
                                                <span class="font-mono font-semibold text-blue-600 dark:text-blue-400">@a.IataCode</span>
                                                — @a.Name
                                                @if (!string.IsNullOrEmpty(a.Municipality))
                                                {
                                                    <span class="text-gray-500 dark:text-gray-400 ml-1">(@a.Municipality, @a.IsoCountry)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Seat(s)</label>
                                <input @bind="form.AssignedSeats" type="text" class="@InputClass" placeholder="12A, 12B" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Confirmation Code</label>
                                <input @bind="form.ConfirmationCode" type="text" class="@InputClass" />
                            </div>
                        }
                        else
                        {
                            @* Non-flight: plain text From / To *@
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">From</label>
                                <input @bind="form.Origin" type="text" class="@InputClass" placeholder="City, station or address" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">To</label>
                                <input @bind="form.Destination" type="text" class="@InputClass" placeholder="City, station or address" />
                            </div>
                        }
                    }

                    @if (form.Type == TransportationType.Parking || form.Type == TransportationType.CarRental)
                    {
                        @* Single-timezone for location-based types *@
                        <div class="col-span-2">
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Timezone</label>
                            <select @bind="form.DepartureTimezone" class="@InputClass">
                                <option value="">— select timezone —</option>
                                @foreach (var tz in TimeZoneConverter.TZConvert.KnownIanaTimeZoneNames)
                                {
                                    <option value="@tz">@tz</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Start Date/Time</label>
                            <input @bind="form.DepartureTime" type="datetime-local" class="@InputClass" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">End Date/Time</label>
                            <input @bind="form.ArrivalTime" type="datetime-local" class="@InputClass" />
                        </div>
                    }
                    else if (form.Type == TransportationType.Flight)
                    {
                        @* Flight timezones auto-filled from airport selection *@
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Departure</label>
                            <input @bind="form.DepartureTime" type="datetime-local" class="@InputClass" />
                            @if (!string.IsNullOrEmpty(form.DepartureTimezone))
                            {
                                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">⏱ @form.DepartureTimezone</p>
                            }
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Arrival</label>
                            <input @bind="form.ArrivalTime" type="datetime-local" class="@InputClass" />
                            @if (!string.IsNullOrEmpty(form.ArrivalTimezone))
                            {
                                <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">⏱ @form.ArrivalTimezone</p>
                            }
                        </div>
                    }
                    else
                    {
                        @* Other transport: departure + arrival each with own timezone *@
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Departure</label>
                            <input @bind="form.DepartureTime" type="datetime-local" class="@InputClass" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Departure Timezone</label>
                            <select @bind="form.DepartureTimezone" class="@InputClass">
                                <option value="">— select timezone —</option>
                                @foreach (var tz in TimeZoneConverter.TZConvert.KnownIanaTimeZoneNames)
                                {
                                    <option value="@tz">@tz</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Arrival</label>
                            <input @bind="form.ArrivalTime" type="datetime-local" class="@InputClass" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Arrival Timezone</label>
                            <select @bind="form.ArrivalTimezone" class="@InputClass">
                                <option value="">— select timezone —</option>
                                @foreach (var tz in TimeZoneConverter.TZConvert.KnownIanaTimeZoneNames)
                                {
                                    <option value="@tz">@tz</option>
                                }
                            </select>
                        </div>
                    }

                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Cost</label>
                        <input @bind="form.CostAmount" type="number" step="0.01" class="@InputClass" placeholder="0.00" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Currency</label>
                        <Combobox @bind-Value="form.CostCurrency" Placeholder="Select currency..." SearchPlaceholder="Search currencies...">
                            @foreach (var c in Currencies)
                            {
                                <ComboboxItem Value="@c" Label="@c" />
                            }
                        </Combobox>
                    </div>

                    <div class="col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Booking Link</label>
                        <input @bind="form.Link" type="url" class="@InputClass" placeholder="https://..." />
                    </div>
                    <div class="col-span-2">
                        <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Notes</label>
                        <textarea @bind="form.Notes" rows="2" class="@InputClass"></textarea>
                    </div>
                </div>
            </div>
            <div class="flex justify-end gap-3 p-6 border-t border-gray-200 dark:border-gray-700">
                <button @onclick="CloseModal" class="@SecondaryBtnClass">Cancel</button>
                <button @onclick="SaveItem" disabled="@saving" class="@PrimaryBtnClass">
                    @(saving ? "Saving..." : (editItem != null ? "Save Changes" : "Add"))
                </button>
            </div>
        </div>
    </div>
}

<!-- Section body -->
@if (loading)
{
    <div class="text-center py-6"><div class="animate-spin inline-block rounded-full h-6 w-6 border-b-2 border-blue-700"></div></div>
}
else
{
    @if (CanEdit)
    {
        <div class="flex justify-end mb-4">
            <button @onclick="OpenAddModal"
                    class="inline-flex items-center px-3 py-2 text-sm font-medium text-white bg-blue-700 rounded-lg hover:bg-blue-800">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Transportation
            </button>
        </div>
    }

    @if (items.Count == 0)
    {
        <div class="border-2 border-dashed border-gray-200 dark:border-gray-700 rounded-lg p-8 text-center">
            <span class="text-4xl block mb-3">✈️</span>
            <p class="text-sm text-gray-400 dark:text-gray-500">No transportation booked yet.</p>
        </div>
    }
    else
    {
        @if (tickets.Count > 0)
        {
            <h5 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">Tickets &amp; Rides</h5>
            <div class="space-y-2 mb-4">
                @foreach (var item in tickets)
                {
                    <TransportationCard Item="item" CanEdit="CanEdit" UserTimezone="userTimezone" OnEdit="() => OpenEditModal(item)" OnDelete="() => DeleteItem(item.Id)" />
                }
            </div>
        }
        @if (rentals.Count > 0)
        {
            <h5 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">Car Rentals</h5>
            <div class="space-y-2 mb-4">
                @foreach (var item in rentals)
                {
                    <TransportationCard Item="item" CanEdit="CanEdit" UserTimezone="userTimezone" OnEdit="() => OpenEditModal(item)" OnDelete="() => DeleteItem(item.Id)" />
                }
            </div>
        }
        @if (parkings.Count > 0)
        {
            <h5 class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">Parking</h5>
            <div class="space-y-2">
                @foreach (var item in parkings)
                {
                    <TransportationCard Item="item" CanEdit="CanEdit" UserTimezone="userTimezone" OnEdit="() => OpenEditModal(item)" OnDelete="() => DeleteItem(item.Id)" />
                }
            </div>
        }
    }
}

@code {
    [Parameter] public int TripId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public string? DefaultTimezone { get; set; }

    private List<Transportation> items = [];
    private List<Transportation> tickets => items.Where(i => i.Type != TransportationType.CarRental && i.Type != TransportationType.Parking).OrderBy(i => i.DepartureTime).ToList();
    private List<Transportation> rentals => items.Where(i => i.Type == TransportationType.CarRental).OrderBy(i => i.DepartureTime).ToList();
    private List<Transportation> parkings => items.Where(i => i.Type == TransportationType.Parking).OrderBy(i => i.DepartureTime).ToList();

    private bool loading = true;
    private bool saving = false;
    private bool showModal = false;
    private Transportation? editItem;
    private Transportation form = new() { Type = TransportationType.Flight };

    // Airport autocomplete state
    private string originSearch = "";
    private string destinationSearch = "";
    private List<Airport> originResults = [];
    private List<Airport> destinationResults = [];
    private bool showOriginDropdown = false;
    private bool showDestinationDropdown = false;

    private static readonly string[] Currencies = ["AED","AUD","BRL","CAD","CHF","CNY","CZK","DKK","EUR","GBP","HKD","HUF","IDR","ILS","INR","JPY","KRW","MXN","MYR","NOK","NZD","PHP","PLN","RON","RUB","SAR","SEK","SGD","THB","TRY","TWD","UAH","USD","VND","ZAR"];

    private string InputClass => "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:text-white";
    private string PrimaryBtnClass => "px-5 py-2.5 text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 rounded-lg dark:bg-blue-600 dark:hover:bg-blue-700";
    private string SecondaryBtnClass => "px-5 py-2.5 text-sm font-medium text-gray-900 bg-white border border-gray-200 hover:bg-gray-100 rounded-lg dark:bg-gray-800 dark:text-white dark:border-gray-600";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var user = await UserManager.FindByIdAsync(userId);
            userTimezone = user?.Timezone;
        }
        await LoadItems();
    }

    private string? userTimezone;

    private async Task LoadItems()
    {
        loading = true;
        items = await TransportationService.GetTripTransportationsAsync(TripId);
        loading = false;
    }

    private async Task<string> GetUserCurrencyAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (!string.IsNullOrEmpty(user?.CurrencyCode)) return user.CurrencyCode;
        }
        return "USD";
    }

    private async Task OpenAddModal()
    {
        editItem = null;
        var currency = await GetUserCurrencyAsync();
        form = new Transportation
        {
            Type = TransportationType.Flight, TripId = TripId,
            DepartureTime = DateTime.Today, ArrivalTime = DateTime.Today,
            CostCurrency = currency,
            DepartureTimezone = DefaultTimezone ?? "",
            ArrivalTimezone = DefaultTimezone ?? ""
        };
        originSearch = "";
        destinationSearch = "";
        originResults = [];
        destinationResults = [];
        showModal = true;
    }

    private void OpenEditModal(Transportation item)
    {
        editItem = item;
        form = new Transportation
        {
            Id = item.Id, TripId = item.TripId, Type = item.Type,
            Provider = item.Provider, FlightNumber = item.FlightNumber,
            Origin = item.Origin, OriginCity = item.OriginCity,
            Destination = item.Destination, DestinationCity = item.DestinationCity,
            DepartureTime = item.DepartureTime, ArrivalTime = item.ArrivalTime,
            DepartureTimezone = item.DepartureTimezone, ArrivalTimezone = item.ArrivalTimezone,
            ConfirmationCode = item.ConfirmationCode, AssignedSeats = item.AssignedSeats,
            Notes = item.Notes, Link = item.Link,
            CostAmount = item.CostAmount, CostCurrency = item.CostCurrency ?? "USD",
            RentalCompany = item.RentalCompany, PickupLocation = item.PickupLocation,
            DropOffLocation = item.DropOffLocation, SpotNumber = item.SpotNumber,
            ParkingAddress = item.ParkingAddress
        };
        originSearch = item.Origin ?? "";
        destinationSearch = item.Destination ?? "";
        originResults = [];
        destinationResults = [];
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        showOriginDropdown = false;
        showDestinationDropdown = false;
    }

    // Airport autocomplete handlers
    private async Task HandleOriginInput(ChangeEventArgs e)
    {
        originSearch = e.Value?.ToString() ?? "";
        form.Origin = originSearch;
        if (originSearch.Length >= 2)
        {
            originResults = await AirportService.SearchAsync(originSearch, 8);
            showOriginDropdown = originResults.Count > 0;
        }
        else
        {
            originResults = [];
            showOriginDropdown = false;
        }
    }

    private async Task HandleDestinationInput(ChangeEventArgs e)
    {
        destinationSearch = e.Value?.ToString() ?? "";
        form.Destination = destinationSearch;
        if (destinationSearch.Length >= 2)
        {
            destinationResults = await AirportService.SearchAsync(destinationSearch, 8);
            showDestinationDropdown = destinationResults.Count > 0;
        }
        else
        {
            destinationResults = [];
            showDestinationDropdown = false;
        }
    }

    private void SelectOriginAsync(Airport a)
    {
        originSearch = $"{a.IataCode} — {a.Name}";
        form.Origin = a.IataCode;
        if (!string.IsNullOrEmpty(a.Municipality))
            form.OriginCity = a.Municipality;
        originResults = [];
        showOriginDropdown = false;
        if (form.Type == TransportationType.Flight && a.Latitude.HasValue && a.Longitude.HasValue)
        {
            var tz = TimeZoneLookup.GetTimeZone(a.Latitude.Value, a.Longitude.Value).Result;
            if (!string.IsNullOrEmpty(tz)) form.DepartureTimezone = tz;
        }
    }

    private void SelectDestinationAsync(Airport a)
    {
        destinationSearch = $"{a.IataCode} — {a.Name}";
        form.Destination = a.IataCode;
        if (!string.IsNullOrEmpty(a.Municipality))
            form.DestinationCity = a.Municipality;
        destinationResults = [];
        showDestinationDropdown = false;
        if (form.Type == TransportationType.Flight && a.Latitude.HasValue && a.Longitude.HasValue)
        {
            var tz = TimeZoneLookup.GetTimeZone(a.Latitude.Value, a.Longitude.Value).Result;
            if (!string.IsNullOrEmpty(tz)) form.ArrivalTimezone = tz;
        }
    }

    // Flight number blur → look up route and populate airline, origin, destination
    private async Task LookupFlightRoute()
    {
        if (form.Type != TransportationType.Flight) return;
        var value = form.FlightNumber?.Trim() ?? "";
        if (value.Length < 3) return;

        var route = await FlightRouteService.GetRouteAsync(value);
        if (route != null)
        {
            form.Provider = route.AirlineName ?? form.Provider;

            if (!string.IsNullOrEmpty(route.OriginIataCode))
            {
                form.Origin = route.OriginIataCode;
                originSearch = string.IsNullOrEmpty(route.OriginName)
                    ? route.OriginIataCode
                    : $"{route.OriginIataCode} — {route.OriginName}";
            }
            if (!string.IsNullOrEmpty(route.OriginCity))
                form.OriginCity = route.OriginCity;
            if (!string.IsNullOrEmpty(route.OriginIataCode))
            {
                var originAirport = await AirportService.GetByCodeAsync(route.OriginIataCode);
                if (originAirport?.Latitude.HasValue == true && originAirport.Longitude.HasValue)
                {
                    var tz = TimeZoneLookup.GetTimeZone(originAirport.Latitude.Value, originAirport.Longitude.Value).Result;
                    if (!string.IsNullOrEmpty(tz)) form.DepartureTimezone = tz;
                }
            }

            if (!string.IsNullOrEmpty(route.DestinationIataCode))
            {
                form.Destination = route.DestinationIataCode;
                destinationSearch = string.IsNullOrEmpty(route.DestinationName)
                    ? route.DestinationIataCode
                    : $"{route.DestinationIataCode} — {route.DestinationName}";
            }
            if (!string.IsNullOrEmpty(route.DestinationCity))
                form.DestinationCity = route.DestinationCity;
            if (!string.IsNullOrEmpty(route.DestinationIataCode))
            {
                var destAirport = await AirportService.GetByCodeAsync(route.DestinationIataCode);
                if (destAirport?.Latitude.HasValue == true && destAirport.Longitude.HasValue)
                {
                    var tz = TimeZoneLookup.GetTimeZone(destAirport.Latitude.Value, destAirport.Longitude.Value).Result;
                    if (!string.IsNullOrEmpty(tz)) form.ArrivalTimezone = tz;
                }
            }

            StateHasChanged();
        }
        else
        {
            // Fall back to local airline lookup by IATA prefix
            var match = System.Text.RegularExpressions.Regex.Match(value, @"^([A-Z]{2,3})", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
            if (match.Success)
            {
                var airline = await AirlineService.GetByCodeAsync(match.Groups[1].Value);
                if (airline != null)
                {
                    form.Provider = airline.Name;
                    StateHasChanged();
                }
            }
        }
    }

    private async Task SaveItem()
    {
        saving = true;
        form.TripId = TripId;
        if (editItem != null)
            await TransportationService.UpdateAsync(form);
        else
            await TransportationService.CreateAsync(form);
        saving = false;
        showModal = false;
        await LoadItems();
    }

    private async Task DeleteItem(int id)
    {
        await TransportationService.DeleteAsync(id);
        await LoadItems();
    }

    private static string GetTypeLabel(TransportationType type) => type switch
    {
        TransportationType.Flight => "✈️ Flight",
        TransportationType.Train => "🚂 Train",
        TransportationType.Bus => "🚌 Bus",
        TransportationType.Car => "🚗 Car",
        TransportationType.CarRental => "🚙 Car Rental",
        TransportationType.Taxi => "🚕 Taxi / Rideshare",
        TransportationType.Ferry => "⛴️ Ferry",
        TransportationType.Bike => "🚲 Bike",
        TransportationType.Walk => "🚶 Walk",
        TransportationType.Parking => "🅿️ Parking",
        _ => "🚀 Other"
    };
}
