@using Viagem.Services.Interfaces
@using Viagem.Services.ViewModels
@inject ITripService TripService
@inject IPlaceService PlaceService
@inject ITravellerProfileService TravellerService
@inject IExpenseService ExpenseService
@inject AuthenticationStateProvider AuthStateProvider

<!-- Consolidated Edit Modal -->
@if (showEditModal)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
        <div class="bg-surface1 rounded-2xl shadow-xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between p-6 border-b border-divider">
                <h3 class="text-lg font-semibold text-foreground">Edit Trip</h3>
                <LumexButton OnClick="CloseEditModal" IsIconOnly="@true">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </LumexButton>
            </div>
            <div class="p-6 space-y-5">
                @if (!string.IsNullOrEmpty(editError))
                {
                    <div class="p-3 text-sm text-danger bg-danger-100 rounded-lg">@editError</div>
                }

                <!-- Trip Name -->
                <LumexTextbox @bind-Value="editName" Label="Trip Name" Placeholder="My Amazing Trip" Required="@true" />

                <!-- Dates -->
                <div class="grid grid-cols-2 gap-4">
                    <LumexDatebox TValue="DateTime" @bind-Value="editStart" Label="Start Date" Required="@true" />
                    <LumexDatebox TValue="DateTime" @bind-Value="editEnd" Label="End Date" Required="@true" />
                </div>

                <!-- Description -->
                <LumexTextbox @bind-Value="editDescription" Label="Description" Placeholder="What is this trip about?" Multiline="@true" Rows="2" />

                <!-- Budget -->
                <div class="grid grid-cols-2 gap-4">
                    <LumexNumbox TValue="decimal?" @bind-Value="editBudget" Label="Budget Amount" Placeholder="0.00" />
                    <LumexTextbox @bind-Value="editCurrency" Label="Currency" Placeholder="USD" />
                </div>

                <!-- Destinations -->
                <div>
                    <label class="block mb-1.5 text-sm font-medium text-foreground">Destinations</label>
                    @if (editDestinations.Any(d => !d.MarkedForRemoval))
                    {
                        <div class="flex flex-wrap gap-2 mb-3">
                            @foreach (var d in editDestinations.Where(d => !d.MarkedForRemoval))
                            {
                                <span class="inline-flex items-center gap-1 px-2.5 py-1 text-sm bg-primary-100 text-primary-700 rounded-full">
                                    📍 @d.DisplayName
                                    <button type="button" @onclick="() => RemoveEditDest(d)"
                                            class="ml-1 text-primary hover:text-primary-600">&#x2715;</button>
                                </span>
                            }
                        </div>
                    }
                    <div class="flex gap-2">
                        <div class="flex-1 relative">
                            <LumexTextbox Value="@destSearch" ValueChanged="@(async v => await HandleDestInput(v))" Label="" Placeholder="Search city..." />
                            @if (destResults.Count > 0)
                            {
                                <ul class="absolute z-10 mt-1 w-full bg-surface1 border border-divider rounded-lg shadow-lg max-h-44 overflow-y-auto">
                                    @foreach (var place in destResults)
                                    {
                                        <li>
                                            <button type="button" @onclick="() => AddDestFromPlace(place)"
                                                    class="w-full text-left px-3 py-2 text-sm hover:bg-default-100 text-foreground">
                                                @place.Name@(!string.IsNullOrEmpty(place.StateName) ? $", {place.StateName}" : "")@(!string.IsNullOrEmpty(place.CountryName) ? $" — {place.CountryName}" : "")
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                        <LumexButton OnClick="AddDestCustom" Color="@ThemeColor.Default">Add custom</LumexButton>
                    </div>
                </div>

                <!-- Travellers -->
                @if (availableTravellers.Count > 0)
                {
                    <div>
                        <label class="block mb-1.5 text-sm font-medium text-foreground">Travellers</label>
                        <div class="space-y-2 max-h-52 overflow-y-auto border border-divider rounded-lg p-3">
                            @foreach (var profile in availableTravellers)
                            {
                                var isSelected = editTravellers.ContainsKey(profile.Id);
                                var isLinked = !string.IsNullOrEmpty(profile.LinkedUserId);
                                <div class="flex items-center justify-between py-1">
                                    <label class="flex items-center gap-2 cursor-pointer">
                                        <input type="checkbox" class="w-4 h-4 text-primary rounded"
                                               checked="@isSelected"
                                               @onchange="e => ToggleEditTraveller(profile.Id, (bool)(e.Value ?? false))" />
                                        <span class="text-sm text-foreground">@profile.LegalName</span>
                                        @if (isLinked)
                                        {
                                            <span class="text-xs px-1.5 py-0.5 bg-success-100 text-success-600 rounded">User</span>
                                        }
                                    </label>
                                    @if (isSelected && isLinked)
                                    {
                                        <label class="flex items-center gap-1 cursor-pointer text-xs text-foreground-500">
                                            <input type="checkbox" class="w-3.5 h-3.5 text-primary rounded"
                                                   checked="@editTravellers.GetValueOrDefault(profile.Id)"
                                                   @onchange="e => SetEditTravellerCanEdit(profile.Id, (bool)(e.Value ?? false))" />
                                            Can edit
                                        </label>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="flex justify-end gap-3 p-6 border-t border-divider">
                <LumexButton OnClick="CloseEditModal">Cancel</LumexButton>
                <LumexButton OnClick="SaveAll" Disabled="@saving" Color="@ThemeColor.Primary">@(saving ? "Saving..." : "Save Changes")</LumexButton>
            </div>
        </div>
    </div>
}

<!-- Display -->
<div>
    @if (CanEdit)
    {
        <div class="flex justify-end mb-3">
            <LumexButton OnClick="OpenEditModal">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
                Edit Trip
            </LumexButton>
        </div>
    }

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
        <!-- Trip Details card -->
        <div class="bg-default-50 rounded-xl p-4">
            <h4 class="font-semibold text-foreground mb-3">Trip Details</h4>
            <h3 class="text-xl font-bold text-foreground mb-1">@Trip.Name</h3>
            <p class="text-sm text-foreground-400 mb-2">@Trip.StartDate.ToString("MMMM d, yyyy") — @Trip.EndDate.ToString("MMMM d, yyyy")</p>
            @if (!string.IsNullOrEmpty(Trip.Description))
            {
                <p class="text-sm text-foreground-500 mt-2">@Trip.Description</p>
            }
        </div>

        <!-- Destinations card -->
        <div class="bg-default-50 rounded-xl p-4">
            <h4 class="font-semibold text-foreground mb-3">Destinations</h4>
            @if (Trip.Destinations?.Count > 0)
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var dest in Trip.Destinations)
                    {
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 text-sm bg-surface1 rounded-lg border border-divider">
                            <span class="text-foreground-400">📍</span>
                            <span class="font-medium text-foreground">@dest.DisplayName</span>
                            @if (!string.IsNullOrEmpty(dest.PlaceCountryName))
                            {
                                <span class="text-xs text-foreground-400">@dest.PlaceCountryName</span>
                            }
                        </span>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-foreground-400 italic">No destinations added yet.</p>
            }
        </div>

        <!-- Budget card -->
        <div class="bg-default-50 rounded-xl p-4">
            <h4 class="font-semibold text-foreground mb-3">Budget</h4>
            @if (Trip.BudgetAmount.HasValue && Trip.BudgetAmount > 0)
            {
                var pct = totalExpenses > 0 ? Math.Min((double)(totalExpenses / Trip.BudgetAmount.Value) * 100, 100) : 0;
                var pctStr = pct.ToString("F0");
                <div>
                    <div class="flex justify-between text-sm mb-1">
                        <span class="text-foreground-500">Spent: <strong>@totalExpenses.ToString("N2") @Trip.BudgetCurrency</strong></span>
                        <span class="text-foreground-500">Budget: <strong>@Trip.BudgetAmount?.ToString("N2") @Trip.BudgetCurrency</strong></span>
                    </div>
                    <div class="w-full bg-default-200 rounded-full h-4 overflow-hidden">
                        <div class="h-4 rounded-full transition-all duration-500 @(pct >= 90 ? "bg-danger" : pct >= 70 ? "bg-warning" : "bg-primary")"
                             style="width: @pctStr%"></div>
                    </div>
                    <p class="text-xs text-foreground-400 mt-1">@pctStr% of budget used</p>
                </div>
            }
            else
            {
                <p class="text-sm text-foreground-400 italic">No budget set.</p>
            }
        </div>

        <!-- Travellers card -->
        <div class="bg-default-50 rounded-xl p-4">
            <h4 class="font-semibold text-foreground mb-3">Travellers</h4>
            @if (Trip.Travellers.Count > 0)
            {
                <div class="flex flex-wrap gap-2">
                    @foreach (var t in Trip.Travellers)
                    {
                        <div class="flex items-center gap-1.5 bg-surface1 rounded-full pl-1 pr-3 py-1 border border-divider">
                            <UserAvatar Email="@t.Email" Name="@t.LegalName" SizeClass="w-6 h-6" TextClass="text-xs" />
                            <span class="text-sm text-foreground">@(t.LegalName)</span>
                            @if (t.CanEdit)
                            {
                                <span class="text-xs text-success-600" title="Can edit trip">&#10003;</span>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-sm text-foreground-400 italic">No travellers assigned.</p>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public required TripDetailViewModel Trip { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback OnTripUpdated { get; set; }

    private string? userId;
    private bool saving = false;
    private decimal totalExpenses = 0;

    // Edit modal state
    private bool showEditModal = false;
    private string editName = "";
    private string? editDescription;
    private DateTime editStart;
    private DateTime editEnd;
    private decimal? editBudget;
    private string? editCurrency;
    private string? editError;

    // Destinations in edit modal
    private string destSearch = "";
    private List<PlaceViewModel> destResults = [];
    private List<EditDestItem> editDestinations = [];

    // Travellers in edit modal
    private List<TravellerProfileViewModel> availableTravellers = [];
    private Dictionary<int, bool> editTravellers = []; // profileId -> canEdit



    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        // totalExpenses loaded separately via IExpenseService if needed
        totalExpenses = await ExpenseService.GetTotalExpenseAsync(Trip.Id, Trip.BudgetCurrency!);
    }

    private async Task OpenEditModal()
    {
        editName = Trip.Name;
        editDescription = Trip.Description;
        editStart = Trip.StartDate;
        editEnd = Trip.EndDate;
        editBudget = Trip.BudgetAmount;
        editCurrency = Trip.BudgetCurrency ?? "";
        editError = null;
        destSearch = "";
        destResults = [];

        editDestinations = Trip.Destinations?.Select(d => new EditDestItem
        {
            ExistingId = d.Id,
            PlaceId = d.PlaceId,
            CustomName = d.CustomName,
            DisplayName = d.DisplayName
        }).ToList() ?? [];

        if (userId != null)
            availableTravellers = await TravellerService.GetMyProfilesAsync(userId);

        editTravellers = Trip.Travellers?.ToDictionary(t => t.TravellerProfileId, t => t.CanEdit) ?? [];

        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        destSearch = "";
        destResults = [];
    }

    private async Task HandleDestInput(string? value)
    {
        destSearch = value ?? "";
        if (destSearch.Length < 3) { destResults = []; return; }
        destResults = await PlaceService.SearchAsync(destSearch);
    }

    private void AddDestFromPlace(PlaceViewModel place)
    {
        if (!editDestinations.Any(d => d.PlaceId == place.Id && !d.MarkedForRemoval))
            editDestinations.Add(new EditDestItem
            {
                PlaceId = place.Id,
                DisplayName = place.Name + (!string.IsNullOrEmpty(place.CountryName) ? $", {place.CountryName}" : "")
            });
        destSearch = "";
        destResults = [];
    }

    private void AddDestCustom()
    {
        var name = destSearch.Trim();
        if (string.IsNullOrEmpty(name)) return;
        if (!editDestinations.Any(d => d.CustomName == name && !d.MarkedForRemoval))
            editDestinations.Add(new EditDestItem { CustomName = name, DisplayName = name });
        destSearch = "";
        destResults = [];
    }

    private void RemoveEditDest(EditDestItem dest)
    {
        if (dest.ExistingId.HasValue)
            dest.MarkedForRemoval = true;
        else
            editDestinations.Remove(dest);
    }

    private void ToggleEditTraveller(int profileId, bool selected)
    {
        if (selected) editTravellers[profileId] = false;
        else editTravellers.Remove(profileId);
    }

    private void SetEditTravellerCanEdit(int profileId, bool canEdit)
    {
        if (editTravellers.ContainsKey(profileId))
            editTravellers[profileId] = canEdit;
    }

    private async Task SaveAll()
    {
        if (string.IsNullOrWhiteSpace(editName)) { editError = "Trip name is required."; return; }
        if (editEnd < editStart) { editError = "End date must be on or after start date."; return; }
        saving = true;
        editError = null;
        try
        {
            await TripService.UpdateTripAsync(userId!, new UpdateTripRequest(Trip.Id, editName.Trim(), editDescription?.Trim(), editStart, editEnd, editBudget, string.IsNullOrWhiteSpace(editCurrency) ? null : editCurrency.Trim().ToUpper()));

            foreach (var d in editDestinations.Where(d => d.MarkedForRemoval && d.ExistingId.HasValue))
                await TripService.RemoveDestinationAsync(d.ExistingId!.Value);
            foreach (var d in editDestinations.Where(d => !d.MarkedForRemoval && !d.ExistingId.HasValue))
            {
                if (d.PlaceId.HasValue)
                    await TripService.AddDestinationAsync(Trip.Id, d.PlaceId.Value);
                else if (!string.IsNullOrEmpty(d.CustomName))
                    await TripService.AddDestinationCustomAsync(Trip.Id, d.CustomName);
            }

            var currentTravellers = Trip.Travellers.ToList();
            foreach (var t in currentTravellers.Where(t => !editTravellers.ContainsKey(t.TravellerProfileId)))
                await TripService.RemoveTravellerAsync(t.Id);
            var existingProfileIds = currentTravellers.Select(t => t.TravellerProfileId).ToHashSet();
            foreach (var kv in editTravellers.Where(kv => !existingProfileIds.Contains(kv.Key)))
                await TripService.AddTravellerAsync(Trip.Id, kv.Key, kv.Value);
            foreach (var t in currentTravellers.Where(t => editTravellers.ContainsKey(t.TravellerProfileId)))
            {
                var newCanEdit = editTravellers[t.TravellerProfileId];
                if (t.CanEdit != newCanEdit)
                    await TripService.SetTravellerEditAsync(t.Id, newCanEdit);
            }

            showEditModal = false;
            await OnTripUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            editError = ex.Message;
        }
        saving = false;
    }

    private class EditDestItem
    {
        public int? ExistingId { get; set; }
        public int? PlaceId { get; set; }
        public string? CustomName { get; set; }
        public string DisplayName { get; set; } = "";
        public bool MarkedForRemoval { get; set; } = false;
    }
}
