@using Viagem.Services.Interfaces
@using Viagem.Common
@using Viagem.Services.ViewModels
@inject ITripService TripService
@inject AuthenticationStateProvider AuthStateProvider
@inject UserManager<ApplicationUser> UserManager

<!-- Add / Edit Modal -->
<LumexModal @bind-Open="showModal" OnClose="CloseModal" Size="ModalSize.Large">
    <LumexModalContent Context="modal">
        <LumexModalHeader>
            <h3 class="text-lg font-semibold text-foreground">
                @(editItem != null ? "Edit Expense" : "Add Expense")
            </h3>
        </LumexModalHeader>
        <LumexModalBody>
        <div class="space-y-4">
            <div>
                <LumexTextbox @bind-Value="formName" Label="Name *" Placeholder="Dinner, museum ticket..." />
            </div>
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <LumexNumbox TValue="decimal?" @bind-Value="formAmount" Label="Amount" Placeholder="0.00" />
                </div>
                <div>
                    <SearchableDropdown TItem="CurrencyItem"
                                        Value="@AppConstants.Currencies.FirstOrDefault(c => c.Code == formCurrency)"
                                        ValueChanged="@(c => formCurrency = c?.Code ?? defaultCurrency)"
                                        Items="AppConstants.Currencies"
                                        ItemText='c => $"{c.Flag} {c.Code} - {c.Name}"'
                                        Label="Currency"
                                        Placeholder="Select currency..." />
                </div>
            </div>
            <div>
                <LumexSelect TValue="string" @bind-Value="categoryString" Label="Category" Placeholder="— None —">
                    @foreach (var cat in Enum.GetValues<ExpenseCategory>())
                    {
                        <LumexSelectItem Value="@cat.ToString()">@cat.GetLabel()</LumexSelectItem>
                    }
                </LumexSelect>
            </div>
            <div>
                <LumexDatebox TValue="DateTime?" @bind-Value="formOccurredOn" Label="Date" />
            </div>
            <div>
                <LumexTextbox @bind-Value="formNotes" Label="Notes" Multiline="@true" Rows="2" />
            </div>
        </div>
        </LumexModalBody>
        <LumexModalFooter>
            <div class="flex justify-end gap-3 w-full">
                <LumexButton OnClick="CloseModal">Cancel</LumexButton>
                <LumexButton Color="ThemeColor.Primary" Disabled="@saving" OnClick="SaveItem">
                    @(editItem != null ? "Save Changes" : "Add Expense")
                </LumexButton>
            </div>
        </LumexModalFooter>
    </LumexModalContent>
</LumexModal>

@if (loading)
{
    <div class="text-center py-6"><LumexSpinner /></div>
}
else
{
    <!-- Stats cards -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
        <div class="bg-default-50 rounded-xl p-4">
            <p class="text-xs text-primary font-medium uppercase tracking-wide">Total Spent</p>
            <p class="text-xl font-bold text-foreground mt-1">@totalSpent.ToString("N2") <span class="text-sm font-normal text-foreground-400">@defaultCurrency</span></p>
        </div>
        @if (TripBudgetAmount.HasValue && TripBudgetAmount.Value > 0)
        {
            var remaining = TripBudgetAmount.Value - totalSpent;
            <div class="@(remaining < 0 ? "bg-danger-50" : "bg-success-50") rounded-xl p-4">
                <p class="text-xs @(remaining < 0 ? "text-danger-600" : "text-success-600") font-medium uppercase tracking-wide">Remaining</p>
                <p class="text-xl font-bold text-foreground mt-1">@remaining.ToString("N2") <span class="text-sm font-normal text-foreground-400">@(TripBudgetCurrency ?? defaultCurrency)</span></p>
            </div>
        }
        <div class="bg-default-50 rounded-xl p-4">
            <p class="text-xs text-foreground-400 font-medium uppercase tracking-wide">Transactions</p>
            <p class="text-xl font-bold text-foreground mt-1">@items.Count</p>
        </div>
        <div class="bg-default-50 rounded-xl p-4">
            <p class="text-xs text-foreground-400 font-medium uppercase tracking-wide">Avg/Item</p>
            <p class="text-xl font-bold text-foreground mt-1">@(items.Count > 0 ? (totalSpent / items.Count).ToString("N2") : "0.00") <span class="text-sm font-normal text-foreground-400">@defaultCurrency</span></p>
        </div>
    </div>

    <!-- Category breakdown -->
    @if (byCategory.Count > 0)
    {
        <div class="mb-6">
            <h5 class="text-sm font-semibold text-foreground-400 uppercase tracking-wide mb-3">By Category</h5>
            <div class="flex flex-wrap gap-2">
                @foreach (var (cat, amount) in byCategory.OrderByDescending(x => x.Value))
                {
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-default-100 text-foreground">
                        @cat.GetIcon() @cat.GetLabel(): <strong>@amount.ToString("N2")</strong>
                    </span>
                }
            </div>
        </div>
    }

    @if (CanEdit)
    {
        <div class="flex justify-end mb-4">
            <LumexButton OnClick="OpenAddModal" Color="@ThemeColor.Primary">
                <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
                Add Expense
            </LumexButton>
        </div>
    }

    @if (items.Count == 0)
    {
        <div class="border-2 border-dashed border-divider rounded-lg p-8 text-center">
            <span class="text-4xl block mb-3">💰</span>
            <p class="text-sm text-foreground-400">No expenses recorded yet.</p>
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-sm text-left">
                <thead class="text-xs text-foreground-400 uppercase bg-default-50">
                    <tr>
                        <th class="px-3 py-2">Name</th>
                        <th class="px-3 py-2">Category</th>
                        <th class="px-3 py-2">Date</th>
                        <th class="px-3 py-2 text-right">Amount</th>
                        @if (CanEdit) { <th class="px-3 py-2"></th> }
                    </tr>
                </thead>
                <tbody class="divide-y divide-divider">
                    <Virtualize Items="items.OrderByDescending(i => i.OccurredOn).ToList()" Context="item" OverscanCount="5">
                        <tr class="hover:bg-default-100">
                            <td class="px-3 py-2.5 font-medium text-foreground">@item.Name</td>
                            <td class="px-3 py-2.5 text-foreground-400">
                                @if (item.Category.HasValue)
                                {
                                    <span>@item.Category.Value.GetIcon() @item.Category.Value.GetLabel()</span>
                                }
                            </td>
                            <td class="px-3 py-2.5 text-foreground-400">
                                @(item.OccurredOn?.ToString("MMM d") ?? "—")
                            </td>
                            <td class="px-3 py-2.5 text-right font-medium text-foreground">
                                @(item.Amount?.ToString("N2") ?? "—") @item.Currency
                            </td>
                            @if (CanEdit)
                            {
                                <td class="px-3 py-2.5">
                                    <div class="relative flex justify-end">
                                        <button @onclick="() => menuOpenId = (menuOpenId == item.Id ? null : item.Id)"
                                                class="p-1.5 text-foreground-400 hover:text-foreground-500 rounded-lg hover:bg-default-100">
                                            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                                <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                                            </svg>
                                        </button>
                                        @if (menuOpenId == item.Id)
                                        {
                                            <div class="fixed inset-0 z-10" @onclick="() => menuOpenId = null"></div>
                                            <div class="absolute right-0 top-8 z-20 bg-surface1 rounded-lg shadow-lg border border-divider py-1 min-w-[120px]">
                                                <button @onclick="() => { OpenEditModal(item); menuOpenId = null; }" class="w-full text-left px-4 py-2 text-sm text-foreground-500 hover:bg-default-100">Edit</button>
                                                <button @onclick="async () => { await DeleteItem(item.Id); menuOpenId = null; }" class="w-full text-left px-4 py-2 text-sm text-danger hover:bg-danger-100">Remove</button>
                                            </div>
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    </Virtualize>
                </tbody>
                <tfoot>
                    <tr class="border-t-2 border-divider">
                        <td colspan="@(CanEdit ? 3 : 3)" class="px-3 py-2 font-semibold text-foreground-500">Total</td>
                        <td class="px-3 py-2 text-right font-bold text-foreground">@totalSpent.ToString("N2") @defaultCurrency</td>
                        @if (CanEdit) { <td></td> }
                    </tr>
                </tfoot>
            </table>
        </div>
    }
}

@code {
    [Parameter] public int TripId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public decimal? TripBudgetAmount { get; set; }
    [Parameter] public string? TripBudgetCurrency { get; set; }

    [Parameter] public IReadOnlyList<ExpenseViewModel>? InitialItems { get; set; }

    [Parameter] public EventCallback<ExpenseViewModel> OnItemCreated { get; set; }
    [Parameter] public EventCallback<ExpenseViewModel> OnItemUpdated { get; set; }
    [Parameter] public EventCallback<Guid> OnItemDeleted { get; set; }
    [Parameter] public string UserId { get; set; } = "";

    private List<ExpenseViewModel> items = [];
    private bool loading = true;
    private bool initialized = false;
    private Guid? menuOpenId;
    private bool saving = false;
    private bool showModal = false;
    private ExpenseViewModel? editItem;
    private string? currentUserId;

    // Form state
    private string formName = "";
    private decimal? formAmount;
    private string formCurrency = "USD";
    private ExpenseCategory? formCategory;
    private DateTime? formOccurredOn;
    private string? formNotes;

    private decimal totalSpent => items.Sum(i => i.Amount ?? 0);
    private string defaultCurrency => items.FirstOrDefault(i => !string.IsNullOrEmpty(i.Currency))?.Currency ?? TripBudgetCurrency ?? "USD";

    private string categoryString
    {
        get => formCategory?.ToString() ?? "";
        set => formCategory = string.IsNullOrEmpty(value) ? null : Enum.Parse<ExpenseCategory>(value);
    }
    private Dictionary<ExpenseCategory, decimal> byCategory => items
        .Where(i => i.Category.HasValue && i.Amount.HasValue)
        .GroupBy(i => i.Category!.Value)
        .ToDictionary(g => g.Key, g => g.Sum(i => i.Amount!.Value));




    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        
        if (InitialItems != null)
        {
            items = InitialItems.ToList();
            loading = false;
        }
        else
        {
            await LoadItems();
        }
        initialized = true;
    }

    protected override void OnParametersSet()
    {
        if (initialized && InitialItems != null)
        {
            // If parent updates InitialItems, reflect changes
            // items = InitialItems.ToList();
            // Actually, we manage local state via LoadItems after edit/add, so if parent passes InitialItems we only use it on init.
        }
    }

    private async Task LoadItems()
    {
        // Now loaded from TripService aggregate
        if (!string.IsNullOrEmpty(UserId))
        {
            var trip = await TripService.GetTripAsync(TripId, UserId);
            items = trip?.Expenses.ToList() ?? [];
        }
        loading = false;
    }

    private async Task<string> GetUserCurrencyAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (userId != null)
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (!string.IsNullOrEmpty(user?.CurrencyCode)) return user.CurrencyCode;
        }
        return defaultCurrency;
    }

    private async Task OpenAddModal()
    {
        editItem = null;
        formName = "";
        formAmount = null;
        formCurrency = await GetUserCurrencyAsync();
        formCategory = null;
        formOccurredOn = DateTime.Today;
        formNotes = null;
        showModal = true;
    }

    private void OpenEditModal(ExpenseViewModel item)
    {
        editItem = item;
        formName = item.Name;
        formAmount = item.Amount;
        formCurrency = item.Currency ?? defaultCurrency;
        formCategory = item.Category;
        formOccurredOn = item.OccurredOn;
        formNotes = item.Notes;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task SaveItem()
    {
        if (string.IsNullOrWhiteSpace(formName)) return;
        saving = true;
        if (editItem != null)
        {
            var updated = await TripService.UpdateExpenseAsync(UserId, new UpdateExpenseRequest(TripId, editItem.Id, formName, formCategory, formNotes, formAmount, string.IsNullOrEmpty(formCurrency) ? null : formCurrency, formOccurredOn, []));
            if (updated != null)
            {
                var idx = items.FindIndex(i => i.Id == updated.Id);
                if (idx >= 0) items[idx] = updated; else items.Add(updated);
                if (OnItemUpdated.HasDelegate) await OnItemUpdated.InvokeAsync(updated);
            }
        }
        else
        {
            var created = await TripService.AddExpenseAsync(UserId, new CreateExpenseRequest(TripId, UserId, formName, formCategory, formNotes, formAmount, string.IsNullOrEmpty(formCurrency) ? null : formCurrency, formOccurredOn, []));
            items.Add(created);
            if (OnItemCreated.HasDelegate) await OnItemCreated.InvokeAsync(created);
        }
        saving = false;
        showModal = false;
    }

    private async Task DeleteItem(Guid id)
    {
        await TripService.RemoveExpenseAsync(UserId, TripId, id);
        items.RemoveAll(i => i.Id == id);
        if (OnItemDeleted.HasDelegate) await OnItemDeleted.InvokeAsync(id);
    }
}
