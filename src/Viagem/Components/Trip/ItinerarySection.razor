@using Viagem.Services.Interfaces
@inject ITransportationService TransportationService
@inject ILodgingService LodgingService
@inject IActivityService ActivityService

@if (loading)
{
    <LumexSpinner />
}
else if (days.Count == 0)
{
    <div class="border-2 border-dashed border-divider rounded-lg p-8 text-center">
        <span class="text-4xl block mb-3">📅</span>
        <p class="text-sm text-foreground-400">Add transportation, lodging or activities to see your itinerary here.</p>
    </div>
}
else
{
    <div class="space-y-6">
        @foreach (var day in days.Keys.OrderBy(d => d))
        {
            var events = days[day];
            <div>
                <div class="flex items-center gap-3 mb-3">
                    <div class="flex-shrink-0 w-12 h-12 bg-primary text-white rounded-xl flex flex-col items-center justify-center">
                        <span class="text-xs font-medium">@day.ToString("MMM")</span>
                        <span class="text-lg font-bold leading-none">@day.Day</span>
                    </div>
                    <div>
                        <h5 class="font-semibold text-foreground">@day.ToString("dddd")</h5>
                        <p class="text-xs text-foreground-400">@events.Count event(s)</p>
                    </div>
                </div>
                <div class="ml-6 pl-6 border-l-2 border-primary-100 space-y-2">
                    @foreach (var ev in events.OrderBy(e => e.Time))
                    {
                        <div class="relative flex gap-3">
                            <div class="absolute -left-[1.65rem] top-2 w-3 h-3 rounded-full border-2 border-primary bg-surface1"></div>
                            <div class="flex-1 bg-default-50 rounded-xl p-3 border border-divider">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex items-start gap-2">
                                        <span class="text-lg">@ev.Icon</span>
                                        <div>
                                            <p class="font-medium text-foreground text-sm">@ev.Title</p>
                                            @if (!string.IsNullOrEmpty(ev.Subtitle))
                                            {
                                                <p class="text-xs text-foreground-400 mt-0.5">@ev.Subtitle</p>
                                            }
                                        </div>
                                    </div>
                                    <span class="text-xs text-foreground-400 shrink-0">@ev.Time.ToString("HH:mm")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public int TripId { get; set; }

    private bool loading = true;
    private Dictionary<DateTime, List<ItineraryEvent>> days = [];

    private record ItineraryEvent(DateTime Time, string Icon, string Title, string? Subtitle);

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        var transportTask = TransportationService.GetTripTransportationsAsync(TripId);
        var lodgingTask = LodgingService.GetTripLodgingsAsync(TripId);
        var activityTask = ActivityService.GetTripActivitiesAsync(TripId);
        await Task.WhenAll(transportTask, lodgingTask, activityTask);

        var result = new Dictionary<DateTime, List<ItineraryEvent>>();

        void Add(DateTime date, ItineraryEvent ev)
        {
            var key = date.Date;
            if (!result.ContainsKey(key)) result[key] = [];
            result[key].Add(ev);
        }

        foreach (var t in transportTask.Result)
        {
            var icon = t.Type switch
            {
                TransportationType.Flight => "✈️",
                TransportationType.Train => "🚂",
                TransportationType.CarRental => "🚙",
                TransportationType.Parking => "🅿️",
                TransportationType.Bus => "🚌",
                TransportationType.Taxi => "🚕",
                TransportationType.Ferry => "⛴️",
                _ => "🚗"
            };
            var title = t.Type == TransportationType.CarRental
                ? $"Car Rental – {t.RentalCompany ?? "Rental"} pickup"
                : t.Type == TransportationType.Parking
                ? "Parking start"
                : $"{(string.IsNullOrEmpty(t.Provider) ? t.Type.ToString() : t.Provider)} {t.FlightNumber ?? ""}".Trim();
            var subtitle = !string.IsNullOrEmpty(t.Origin) && !string.IsNullOrEmpty(t.Destination)
                ? $"{t.Origin} → {t.Destination}"
                : t.PickupLocation;
            Add(t.DepartureTime, new(t.DepartureTime, icon, title, subtitle));

            if (t.ArrivalTime.Date != t.DepartureTime.Date)
                Add(t.ArrivalTime, new(t.ArrivalTime, icon, $"{title} (arrival)", subtitle));
        }

        foreach (var l in lodgingTask.Result)
        {
            var icon = l.Type switch { LodgingType.Hotel => "🏨", LodgingType.Hostel => "🛏️", LodgingType.CampSite => "⛺", LodgingType.VacationRental => "🏡", _ => "🏠" };
            Add(l.StartDate, new(l.StartDate, icon, $"Check-in: {l.Name}", l.Address));
            Add(l.EndDate, new(l.EndDate, icon, $"Check-out: {l.Name}", null));
        }

        foreach (var a in activityTask.Result)
            Add(a.StartDate, new(a.StartDate, "🎯", a.Name, a.Address));

        days = result;
        loading = false;
    }
}
