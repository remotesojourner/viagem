@using Viagem.Services
@inject TripImportService ImportService
@inject NavigationManager Nav

@if (Show)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60" @onclick="HandleBackdropClick">
        <div class="bg-surface1 rounded-2xl shadow-xl w-full max-w-md p-6 mx-4" @onclick:stopPropagation>
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-semibold text-foreground">Import Trip</h2>
                <button @onclick="Close" class="text-foreground-400 hover:text-foreground transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>

            @if (result != null)
            {
                @if (result.Success)
                {
                    <div class="text-center py-4">
                        <div class="w-12 h-12 rounded-full bg-success-100 flex items-center justify-center mx-auto mb-3">
                            <svg class="w-6 h-6 text-success-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                        </div>
                        <p class="text-foreground font-medium">Trip imported successfully!</p>
                        <p class="text-sm text-foreground-400 mt-1">@result.TripName</p>
                        @if (result.Warnings.Count > 0)
                        {
                            <div class="mt-3 text-left text-xs text-warning bg-warning-50 rounded-lg p-3 space-y-1 max-h-32 overflow-y-auto">
                                @foreach (var w in result.Warnings)
                                {
                                    <p>⚠ @w</p>
                                }
                            </div>
                        }
                        <div class="flex gap-2 mt-4">
                            <button @onclick="GoToTrip"
                                    class="flex-1 px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-600 transition-colors">
                                Open Trip
                            </button>
                            <button @onclick="Reset"
                                    class="flex-1 px-4 py-2 bg-default-100 text-foreground rounded-lg text-sm font-medium hover:bg-default-200 transition-colors">
                                Import Another
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-4">
                        <div class="w-12 h-12 rounded-full bg-danger-100 flex items-center justify-center mx-auto mb-3">
                            <svg class="w-6 h-6 text-danger-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        </div>
                        <p class="text-foreground font-medium">Import failed</p>
                        <p class="text-sm text-danger mt-1">@result.Error</p>
                        <button @onclick="Reset"
                                class="mt-4 px-4 py-2 bg-default-100 text-foreground rounded-lg text-sm font-medium hover:bg-default-200 transition-colors">
                            Try Again
                        </button>
                    </div>
                }
            }
            else if (importing)
            {
                <div class="text-center py-8">
                    <LumexSpinner Size="Size.Large" Color="ThemeColor.Primary" />
                    <p class="text-sm text-foreground-400 mt-3">Importing trip...</p>
                </div>
            }
            else
            {
                <div>
                    <p class="text-sm text-foreground-400 mb-4">
                        Select a Viagem trip export file (<code>.viagem.zip</code>) to import.
                    </p>

                    <label class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-divider rounded-xl cursor-pointer hover:border-primary hover:bg-primary-50/30 transition-colors">
                        <svg class="w-8 h-8 text-foreground-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>
                        </svg>
                        <span class="text-sm text-foreground-400">
                            @(selectedFileName ?? "Click to select or drag & drop")
                        </span>
                        <InputFile OnChange="OnFileSelected" accept=".zip" class="hidden" />
                    </label>

                    @if (selectedFile != null)
                    {
                        <div class="mt-4 flex gap-2">
                            <button @onclick="DoImport"
                                    class="flex-1 px-4 py-2 bg-primary text-white rounded-lg text-sm font-medium hover:bg-primary-600 transition-colors">
                                Import
                            </button>
                            <button @onclick="Close"
                                    class="px-4 py-2 bg-default-100 text-foreground rounded-lg text-sm font-medium hover:bg-default-200 transition-colors">
                                Cancel
                            </button>
                        </div>
                    }
                    else
                    {
                        <button @onclick="Close"
                                class="mt-4 w-full px-4 py-2 bg-default-100 text-foreground rounded-lg text-sm font-medium hover:bg-default-200 transition-colors">
                            Cancel
                        </button>
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string UserId { get; set; } = "";

    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private bool importing;
    private ImportResult? result;

    private void HandleBackdropClick() => Close();

    private void Close()
    {
        Reset();
        OnClose.InvokeAsync();
    }

    private void Reset()
    {
        selectedFile = null;
        selectedFileName = null;
        importing = false;
        result = null;
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        selectedFileName = e.File.Name;
    }

    private async Task DoImport()
    {
        if (selectedFile == null || string.IsNullOrEmpty(UserId)) return;

        importing = true;
        StateHasChanged();

        await using var stream = selectedFile.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
        result = await ImportService.ImportTripZipAsync(stream, UserId);
        importing = false;
    }

    private void GoToTrip()
    {
        if (result?.Success == true)
        {
            OnClose.InvokeAsync();
            Nav.NavigateTo($"/trips/{result.TripId}");
        }
    }
}
