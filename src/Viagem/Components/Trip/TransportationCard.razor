@inject IAirportService AirportService
@using Viagem.Data.Models
@using GeoTimeZone
@using Viagem.Services.Interfaces
@using Viagem.Services.ViewModels
<div class="flex items-start justify-between p-3 bg-default-50 rounded-xl border border-divider hover:border-foreground-300 transition-colors">
    <div class="flex items-start gap-3">
        <span class="text-2xl mt-0.5">@GetIcon(Item.Type)</span>
        <div class="min-w-0">
            <div class="flex flex-wrap items-baseline gap-2">
                <span class="font-semibold text-foreground text-sm">
                    @GetTitle()
                </span>
                @if (!string.IsNullOrEmpty(Item.ConfirmationCode))
                {
                    <span class="text-xs font-mono bg-default-200 text-foreground-500 px-1.5 py-0.5 rounded">
                        @Item.ConfirmationCode
                    </span>
                }
            </div>
            <div class="text-xs text-foreground-400 mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5">
                @if (Item.Type == TransportationType.Flight)
                {
                    @* Origin airport code badge with airport name + timezone tooltip *@
                    @if (!string.IsNullOrEmpty(Item.Origin))
                    {
                        var originTip = AirportBadgeTooltip(Item.Origin, GetAirportTimezone(Item.Origin));
                        @if (!string.IsNullOrEmpty(originTip))
                        {
                            <LumexTooltip Content="@originTip" Placement="TooltipPlacement.Top">
                                    <span class="font-mono font-semibold text-foreground-500 cursor-default underline decoration-dotted decoration-foreground-300">@Item.Origin</span>
                                </LumexTooltip>
                        }
                        else
                        {
                            <span class="font-mono font-semibold text-foreground-500">@Item.Origin</span>
                        }
                        <span>→</span>
                    }
                    @* Destination airport code badge with airport name + timezone tooltip *@
                    @if (!string.IsNullOrEmpty(Item.Destination))
                    {
                        var destTip = AirportBadgeTooltip(Item.Destination, GetAirportTimezone(Item.Destination));
                        @if (!string.IsNullOrEmpty(destTip))
                        {
                            <LumexTooltip Content="@destTip" Placement="TooltipPlacement.Top">
                                    <span class="font-mono font-semibold text-foreground-500 cursor-default underline decoration-dotted decoration-foreground-300">@Item.Destination</span>
                                </LumexTooltip>
                        }
                        else
                        {
                            <span class="font-mono font-semibold text-foreground-500">@Item.Destination</span>
                        }
                    }
                    @* Departure time with origin timezone tooltip *@
                    var depTz = GetAirportTimezone(Item.Origin);
                    var depTip = TimezoneTooltip(depTz);
                    <span>—</span>
                    @if (!string.IsNullOrEmpty(depTip))
                    {
                        <LumexTooltip Content="@depTip" Placement="TooltipPlacement.Top">
                            <span class="cursor-default underline decoration-dotted decoration-foreground-300">@Item.DepartureTime.ToString("MMM d, HH:mm")</span>
                        </LumexTooltip>
                    }
                    else
                    {
                        <span>@Item.DepartureTime.ToString("MMM d, HH:mm")</span>
                    }
                    @* Arrival time with destination timezone tooltip *@
                    var arrTz = GetAirportTimezone(Item.Destination);
                    var arrTip = TimezoneTooltip(arrTz);
                    <span>→</span>
                    @if (!string.IsNullOrEmpty(arrTip))
                    {
                        <LumexTooltip Content="@arrTip" Placement="TooltipPlacement.Top">
                            <span class="cursor-default underline decoration-dotted decoration-foreground-300">@Item.ArrivalTime.ToString("MMM d, HH:mm")</span>
                        </LumexTooltip>
                    }
                    else
                    {
                        <span>@Item.ArrivalTime.ToString("MMM d, HH:mm")</span>
                    }
                    @if (!string.IsNullOrEmpty(Item.AssignedSeats))
                    { <span>· Seat: @Item.AssignedSeats</span> }
                }
                else if (Item.Type == TransportationType.CarRental)
                {
                    @if (!string.IsNullOrEmpty(Item.PickupLocation))
                    { <span>📍 @Item.PickupLocation → @Item.DropOffLocation</span><span>·</span> }
                    @* Departure time with stored timezone tooltip *@
                    var depTip2 = TimezoneTooltip(Item.DepartureTimezone);
                    var arrTip2 = TimezoneTooltip(Item.ArrivalTimezone);
                    @if (!string.IsNullOrEmpty(depTip2))
                    {
                        <LumexTooltip Content="@depTip2" Placement="TooltipPlacement.Top">
                            <span class="cursor-default underline decoration-dotted decoration-foreground-300">@Item.DepartureTime.ToString("MMM d, HH:mm")</span>
                        </LumexTooltip>
                    }
                    else { <span>@Item.DepartureTime.ToString("MMM d, HH:mm")</span> }
                    <span>–</span>
                    @if (!string.IsNullOrEmpty(arrTip2))
                    {
                        <LumexTooltip Content="@arrTip2" Placement="TooltipPlacement.Top">
                            <span class="cursor-default underline decoration-dotted decoration-foreground-300">@Item.ArrivalTime.ToString("MMM d, HH:mm")</span>
                        </LumexTooltip>
                    }
                    else { <span>@Item.ArrivalTime.ToString("MMM d, HH:mm")</span> }
                }
                else if (Item.Type == TransportationType.Parking)
                {
                    @if (!string.IsNullOrEmpty(Item.ParkingAddress))
                    { <span>📍 @Item.ParkingAddress</span><span>·</span> }
                    @if (!string.IsNullOrEmpty(Item.SpotNumber))
                    { <span>Spot: @Item.SpotNumber</span><span>·</span> }
                    var depTip3 = TimezoneTooltip(Item.DepartureTimezone);
                    var arrTip3 = TimezoneTooltip(Item.ArrivalTimezone);
                    @if (!string.IsNullOrEmpty(depTip3))
                    {
                        <LumexTooltip Content="@depTip3" Placement="TooltipPlacement.Top">
                            <span class="cursor-default underline decoration-dotted decoration-foreground-300">@Item.DepartureTime.ToString("MMM d, HH:mm")</span>
                        </LumexTooltip>
                    }
                    else { <span>@Item.DepartureTime.ToString("MMM d, HH:mm")</span> }
                    <span>–</span>
                    @if (!string.IsNullOrEmpty(arrTip3))
                    {
                        <LumexTooltip Content="@arrTip3" Placement="TooltipPlacement.Top">
                            <span class="cursor-default underline decoration-dotted decoration-foreground-300">@Item.ArrivalTime.ToString("MMM d, HH:mm")</span>
                        </LumexTooltip>
                    }
                    else { <span>@Item.ArrivalTime.ToString("MMM d, HH:mm")</span> }
                }
                else
                {
                    @if (!string.IsNullOrEmpty(Item.Origin) || !string.IsNullOrEmpty(Item.Destination))
                    { <span>@Item.Origin → @Item.Destination</span><span>·</span> }
                    var depTip4 = TimezoneTooltip(Item.DepartureTimezone);
                    var arrTip4 = TimezoneTooltip(Item.ArrivalTimezone);
                    @if (!string.IsNullOrEmpty(depTip4))
                    {
                        <LumexTooltip Content="@depTip4" Placement="TooltipPlacement.Top">
                            <span class="cursor-default underline decoration-dotted decoration-foreground-300">@Item.DepartureTime.ToString("MMM d, HH:mm")</span>
                        </LumexTooltip>
                    }
                    else { <span>@Item.DepartureTime.ToString("MMM d, HH:mm")</span> }
                    <span>→</span>
                    @if (!string.IsNullOrEmpty(arrTip4))
                    {
                        <LumexTooltip Content="@arrTip4" Placement="TooltipPlacement.Top">
                            <span class="cursor-default underline decoration-dotted decoration-foreground-300">@Item.ArrivalTime.ToString("MMM d, HH:mm")</span>
                        </LumexTooltip>
                    }
                    else { <span>@Item.ArrivalTime.ToString("MMM d, HH:mm")</span> }
                    @if (!string.IsNullOrEmpty(Item.AssignedSeats))
                    { <span>· Seat: @Item.AssignedSeats</span> }
                }
                @if (Item.CostAmount.HasValue)
                {
                    <span>·</span>
                    <span class="font-medium text-foreground-500">@Item.CostAmount.Value.ToString("N2") @Item.CostCurrency</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(Item.Notes))
            {
                <p class="text-xs text-foreground-400 mt-1 italic">@Item.Notes</p>
            }
        </div>
    </div>
    @if (CanEdit)
    {
        <div class="relative ml-2 shrink-0">
            <button @onclick="ToggleMenu"
                    class="p-1.5 text-foreground-400 hover:text-foreground-500 rounded-lg hover:bg-default-100">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                    <circle cx="12" cy="5" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="19" r="1.5"/>
                </svg>
            </button>
            @if (menuOpen)
            {
                <div class="fixed inset-0 z-10" @onclick="CloseMenu"></div>
                <div class="absolute right-0 top-8 z-20 bg-surface1 rounded-lg shadow-lg border border-divider py-1 min-w-[140px]">
                    @if (!string.IsNullOrEmpty(Item.Link))
                    {
                        <a href="@Item.Link" target="_blank" rel="noopener"
                           class="flex items-center px-4 py-2 text-sm text-foreground-500 hover:bg-default-100">Open link ↗</a>
                    }
                    <button @onclick="HandleEdit" class="w-full text-left px-4 py-2 text-sm text-foreground-500 hover:bg-default-100">Edit</button>
                    <button @onclick="HandleDelete" class="w-full text-left px-4 py-2 text-sm text-danger hover:bg-danger-100">Remove</button>
                </div>
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(Item.Link))
    {
        <a href="@Item.Link" target="_blank" rel="noopener"
           class="text-xs text-primary hover:underline ml-2 shrink-0">Link</a>
    }
</div>

@code {
    [Parameter] public required TransportationViewModel Item { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public string? UserTimezone { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private bool menuOpen = false;
    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu() => menuOpen = false;
    private async Task HandleEdit() { menuOpen = false; await OnEdit.InvokeAsync(); }
    private async Task HandleDelete() { menuOpen = false; await OnDelete.InvokeAsync(); }

    // Airport name + coordinate cache, populated for flights
    private Dictionary<string, string> airportNames = new();
    private Dictionary<string, AirportViewModel> airportData = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Item.Type == TransportationType.Flight)
        {
            foreach (var code in new[] { Item.Origin, Item.Destination })
            {
                if (!string.IsNullOrEmpty(code) && !airportData.ContainsKey(code))
                {
                    var airport = await AirportService.GetByCodeAsync(code);
                    if (airport != null)
                    {
                        airportNames[code] = airport.Name +
                            (string.IsNullOrEmpty(airport.IsoCountry) ? "" : $" ({airport.IsoCountry})");
                        airportData[code] = airport;
                    }
                }
            }
        }
    }

    // For flights:
    private string? GetAirportTimezone(string? code)
    {
        if (code != null && airportData.TryGetValue(code, out var a) && a.Latitude.HasValue && a.Longitude.HasValue)
            return TimeZoneLookup.GetTimeZone(a.Latitude.Value, a.Longitude.Value).Result;
        return null;
    }

    // Tooltip text: compares a given IANA timezone against the user's profile timezone.
    // Same logic and format as LodgingSection / ActivitiesSection.
    private string TimezoneTooltip(string? timezone)
    {
        if (string.IsNullOrEmpty(timezone) || string.IsNullOrEmpty(UserTimezone)) return "";
        try
        {
            var zone = TimeZoneInfo.FindSystemTimeZoneById(timezone);
            var userZone = TimeZoneInfo.FindSystemTimeZoneById(UserTimezone);
            var now = DateTimeOffset.UtcNow;
            var diff = zone.GetUtcOffset(now) - userZone.GetUtcOffset(now);
            if (diff == TimeSpan.Zero)
                return $"{timezone} (same as your timezone)";
            var diffStr = diff.Duration().Minutes == 0
                ? $"{(int)Math.Abs(diff.TotalHours)}h"
                : $"{Math.Abs(diff.TotalHours):0.#}h";
            var aheadBehind = diff.TotalHours > 0 ? "ahead of" : "behind";
            return $"{timezone} (Your timezone is {diffStr} {aheadBehind} this)";
        }
        catch { return ""; }
    }

    // Airport code badge: name on hover + timezone tooltip (flights only)
    private string? AirportBadgeTooltip(string? code, string? timezone)
    {
        var name = code != null && airportNames.TryGetValue(code, out var n) ? n : null;
        var tzTip = TimezoneTooltip(timezone);
        if (name == null && string.IsNullOrEmpty(tzTip)) return null;
        if (name != null && !string.IsNullOrEmpty(tzTip)) return $"{name} · {tzTip}";
        return name ?? tzTip;
    }

    private string GetTitle() => Item.Type switch
    {
        TransportationType.Flight => string.IsNullOrEmpty(Item.FlightNumber)
            ? $"{Item.Provider ?? "Flight"}"
            : $"{Item.Provider ?? ""} {Item.FlightNumber}".Trim(),
        TransportationType.CarRental => $"{Item.RentalCompany ?? "Car Rental"}",
        TransportationType.Parking => "Parking",
        _ => $"{Item.Provider ?? Item.Type.ToString()}"
    };

    private static string GetIcon(TransportationType type) => type switch
    {
        TransportationType.Flight => "✈️",
        TransportationType.Train => "🚂",
        TransportationType.Bus => "🚌",
        TransportationType.Car => "🚗",
        TransportationType.CarRental => "🚙",
        TransportationType.Taxi => "🚕",
        TransportationType.Ferry => "⛴️",
        TransportationType.Bike => "🚲",
        TransportationType.Walk => "🚶",
        TransportationType.Parking => "🅿️",
        _ => "🚀"
    };
}
